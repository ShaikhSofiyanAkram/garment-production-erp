<%
currentPage = 'advance';
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Garment ERP</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: #f1f5f9; }
        
        /* Premium Navbar */
        .premium-navbar {
            background: linear-gradient(135deg, #ffffff, #f8fafc);
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            padding: 16px 30px;
            border-bottom: 2px solid rgba(67,97,238,0.1);
        }
        
        .navbar-brand-premium {
            display: flex;
            align-items: center;
            gap: 14px;
            text-decoration: none;
        }
        
        .brand-icon {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, #4361ee, #8b5cf6);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 20px rgba(67,97,238,0.3);
        }
        
        .brand-icon i { font-size: 1.5rem; color: white; }
        .brand-text { font-size: 1.4rem; font-weight: 800; background: linear-gradient(135deg, #1e293b, #334155); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .brand-badge { background: linear-gradient(135deg, #4361ee, #8b5cf6); font-size: 0.65rem; padding: 3px 10px; border-radius: 30px; color: white; margin-left: 10px; }
        
        /* Container */
        .advance-container { max-width: 1400px; margin: 0 auto; padding: 20px; }
        
        /* Stats Cards */
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 25px; }
        .stat-card { background: white; border-radius: 20px; padding: 20px; position: relative; overflow: hidden; }
        .stat-card::before { content: ''; position: absolute; top: 0; right: 0; width: 100px; height: 100px; background: radial-gradient(circle, rgba(67,97,238,0.05) 0%, transparent 70%); border-radius: 50%; }
        .stat-title { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: #64748b; }
        .stat-value { font-size: 1.8rem; font-weight: 800; color: #1e293b; }
        .stat-icon { position: absolute; right: 20px; top: 20px; font-size: 2rem; opacity: 0.15; }
        
        /* Cards */
        .card-premium { background: white; border: none; border-radius: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); margin-bottom: 25px; overflow: hidden; }
        .card-header-premium { padding: 20px 25px; border-bottom: 1px solid #e2e8f0; background: white; }
        .card-header-premium h5 { font-weight: 700; margin: 0; color: #1e293b; }
        .card-body-premium { padding: 25px; }
        
        /* Forms */
        .form-control-premium { border: 1px solid #e2e8f0; border-radius: 12px; padding: 12px 15px; width: 100%; }
        .form-control-premium:focus { border-color: #4361ee; box-shadow: 0 0 0 3px rgba(67,97,238,0.1); outline: none; }
        
        .btn-premium { background: linear-gradient(135deg, #4361ee, #8b5cf6); border: none; border-radius: 12px; padding: 12px 25px; color: white; font-weight: 600; transition: all 0.3s; }
        .btn-premium:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(67,97,238,0.3); }
        
        .btn-outline-premium { background: transparent; border: 2px solid #4361ee; border-radius: 12px; padding: 10px 20px; color: #4361ee; font-weight: 600; }
        .btn-outline-premium:hover { background: #4361ee; color: white; }
        
        /* Table */
        .table-premium { width: 100%; border-collapse: collapse; }
        .table-premium th { padding: 15px; background: #f8fafc; font-weight: 600; border-bottom: 2px solid #e2e8f0; }
        .table-premium td { padding: 15px; border-bottom: 1px solid #e2e8f0; vertical-align: middle; }
        
        .badge-active { background: #10b981; color: white; padding: 5px 12px; border-radius: 30px; font-size: 0.7rem; }
        .badge-partial { background: #f59e0b; color: white; padding: 5px 12px; border-radius: 30px; font-size: 0.7rem; }
        .badge-exhausted { background: #64748b; color: white; padding: 5px 12px; border-radius: 30px; font-size: 0.7rem; }
        
        @media (max-width: 768px) {
            .stats-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>



<div class="advance-container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="fas fa-hand-holding-usd text-primary"></i> Client Advance Management</h2>
            <p class="text-muted">Manage client advance payments and adjustments</p>
        </div>
        <div>
            <button class="btn-premium" data-bs-toggle="modal" data-bs-target="#addAdvanceModal">
                <i class="fas fa-plus"></i> Record Advance
            </button>
            <a href="/advance/statement" class="btn btn-outline-secondary ms-2">
                <i class="fas fa-file-alt"></i> Statement
            </a>
        </div>
    </div>
    
    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-title">Total Advance Received</div>
            <div class="stat-value">₹<%= (totalAdvance || 0).toLocaleString() %></div>
            <i class="fas fa-rupee-sign stat-icon"></i>
        </div>
        <div class="stat-card">
            <div class="stat-title">Total Adjusted</div>
            <div class="stat-value">₹<%= (totalAdjusted || 0).toLocaleString() %></div>
            <i class="fas fa-check-circle stat-icon"></i>
        </div>
        <div class="stat-card">
            <div class="stat-title">Available Advance</div>
            <div class="stat-value text-success">₹<%= (totalRemaining || 0).toLocaleString() %></div>
            <i class="fas fa-clock stat-icon"></i>
        </div>
    </div>
    
    <!-- Advances Table -->
    <div class="card-premium">
        <div class="card-header-premium">
            <h5><i class="fas fa-list"></i> Advance Records</h5>
        </div>
        <div class="card-body-premium p-0">
            <div class="table-responsive">
                <table class="table-premium">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Client</th>
                            <th>Amount (₹)</th>
                            <th>Method</th>
                            <th>Reference</th>
                            <th>Adjusted</th>
                            <th>Remaining</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (advances && advances.length) { %>
                            <% advances.forEach(advance => { 
                                const adjustedTotal = advance.adjustedBills.reduce((s, adj) => s + adj.amount, 0);
                                const remaining = advance.amount - adjustedTotal;
                            %>
                                <tr>
                                    <td><%= new Date(advance.paymentDate).toLocaleDateString() %></td>
                                    <td><%= advance.client?.name %></td>
                                    <td><strong>₹<%= advance.amount.toLocaleString() %></strong></td>
                                    <td><%= advance.paymentMethod.toUpperCase() %></td>
                                    <td><%= advance.reference || '-' %></td>
                                    <td>₹<%= adjustedTotal.toLocaleString() %></td>
                                    <td>₹<%= remaining.toLocaleString() %></td>
                                    <td>
                                        <span class="badge-<%= advance.status %>">
                                            <%= advance.status %>
                                        </span>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" onclick="viewAdjustments('<%= advance._id %>')" title="View Adjustments">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <% if (adjustedTotal === 0) { %>
                                            <button class="btn btn-sm btn-outline-danger" onclick="deleteAdvance('<%= advance._id %>')" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="9" class="text-center py-4">No advance records found</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
    
<!-- Add Advance Modal -->
<div class="modal fade" id="addAdvanceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="fas fa-hand-holding-usd"></i> Record Advance Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="POST" action="/advance/create">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Client *</label>
                        <select class="form-control-premium" name="client" required>
                            <option value="">-- Select Client --</option>
                            <% clients.forEach(client => { %>
                                <option value="<%= client._id %>"><%= client.name %> - <%= client.phone %></option>
                            <% }) %>
                        </select>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Advance Amount (₹) *</label>
                        <input type="number" class="form-control-premium" name="amount" step="1" min="1" required>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Payment Method *</label>
                        <select class="form-control-premium" name="paymentMethod" required>
                            <option value="cash">💵 Cash</option>
                            <option value="bank_transfer">🏦 Bank Transfer</option>
                            <option value="cheque">📝 Cheque</option>
                            <option value="upi">📱 UPI</option>
                        </select>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Reference / Transaction ID</label>
                        <input type="text" class="form-control-premium" name="reference" placeholder="Cheque No / UTR">
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Payment Date</label>
                        <input type="date" class="form-control-premium" name="paymentDate" value="<%= new Date().toISOString().split('T')[0] %>">
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Remark</label>
                        <textarea class="form-control-premium" name="remark" rows="2" placeholder="Optional notes"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-premium">Save Advance</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- View Adjustments Modal -->
<div class="modal fade" id="adjustmentsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-receipt"></i> Advance Adjustments</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="adjustmentsList">
                Loading...
            </div>
        </div>
    </div>
</div>
<!-- Navbar -->
    <nav class="premium-navbar">
        <div class="d-flex justify-content-between align-items-center">
            <a href="/" class="navbar-brand-premium">
                <div class="brand-icon"><i class="fas fa-tshirt"></i></div>
                <div><span class="brand-text"></span><span class="brand-badge"></span></div>
            </a>
            <div>
                <a href="/dashboard" class="btn btn-sm btn-outline-secondary me-2">
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                </a>
            </div>
        </div>
    </nav>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    async function viewAdjustments(advanceId) {
        try {
            const response = await fetch(`/advance/client/${advanceId}`);
            const data = await response.json();
            
            if (data.success && data.advances) {
                const advance = data.advances[0];
                const adjustments = advance.adjustments || [];
                
                if (adjustments.length > 0) {
                    let html = `
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead class="table-light">
                                    <tr><th>Bill #</th><th>Amount</th><th>Date</th></tr>
                                </thead>
                                <tbody>
                    `;
                    adjustments.forEach(adj => {
                        html += `<tr><td>${adj.billNumber}</td><td>₹${adj.amount.toLocaleString()}</td><td>${new Date(adj.date).toLocaleDateString()}</td></tr>`;
                    });
                    html += `</tbody></table></div>`;
                    document.getElementById('adjustmentsList').innerHTML = html;
                } else {
                    document.getElementById('adjustmentsList').innerHTML = '<p class="text-muted text-center">No adjustments made yet</p>';
                }
            } else {
                document.getElementById('adjustmentsList').innerHTML = '<p class="text-muted text-center">No data found</p>';
            }
            
            new bootstrap.Modal(document.getElementById('adjustmentsModal')).show();
        } catch (error) {
            console.error('Error:', error);
            document.getElementById('adjustmentsList').innerHTML = '<p class="text-danger">Error loading data</p>';
        }
    }
    
    async function deleteAdvance(advanceId) {
        if (confirm('Are you sure you want to delete this advance? This action cannot be undone.')) {
            const response = await fetch(`/advance/delete/${advanceId}`, { method: 'DELETE' });
            if (response.ok) {
                location.reload();
            } else {
                alert('Error deleting advance');
            }
        }
    }
</script>
</body>
</html>
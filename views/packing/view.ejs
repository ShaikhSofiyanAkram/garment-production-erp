<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h4><i class="fas fa-eye"></i> Packing Details</h4>
                <small><%= packing.packingNumber %> | <%= new Date(packing.packingDate).toLocaleString() %></small>
            </div>
            <div class="card-body">
                <h5>Total Packed: <strong><%= packing.totalPieces %> pieces</strong></h5>
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead class="table-dark">
                            <tr><th>Product</th><th>Category</th><th>Size</th><th>Pieces</th></tr>
                        </thead>
                        <tbody>
                            <% packing.entries.forEach(e => { %>
                            <tr>
                                <td><%= e.productName %></td>
                                <td><%= e.category %></td>
                                <td><%= e.size %></td>
                                <td class="text-end"><strong><%= e.packedPieces %></strong></td>
                            </tr>
                            <% }) %>
                        </tbody>
                        <tfoot>
                            <tr><th colspan="3" class="text-end">Total</th><th><%= packing.totalPieces %></th></tr>
                        </tfoot>
                    </table>
                </div>
                <a href="/packing" class="btn btn-secondary">⬅ Back</a>
            </div>
        </div>
    </div>
</div>
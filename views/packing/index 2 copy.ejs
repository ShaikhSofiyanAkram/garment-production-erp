    <div style="padding: 20px; font-family: 'Segoe UI', Arial, sans-serif; max-width: 1200px; margin: 0 auto; background: white;">
        
        <!-- Company Header -->
        <div style="text-align: center; border-bottom: 3px solid #1a5f7a; padding-bottom: 20px; margin-bottom: 25px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <div style="text-align: left;">
                    <p style="margin: 0; color: #555; font-size: 12px;">GST: 27AAACA1234A1Z</p>
                    <p style="margin: 0; color: #555; font-size: 12px;">PAN: AAACA1234A</p>
                </div>
                <div style="text-align: right;">
                    <p style="margin: 0; color: #555; font-size: 12px;">Phone: +91 98765 43210</p>
                    <p style="margin: 0; color: #555; font-size: 12px;">Email: info@garmentfactory.com</p>
                </div>
            </div>
            <h1 style="color: #1a5f7a; margin: 0; font-size: 28px;">🏭 GARMENT FACTORY ERP</h1>
            <h3 style="color: #333; margin: 8px 0 5px 0;">Daily Packing Summary</h3>
            <p style="color: #666; margin: 5px 0;" id="printDateRange"></p>
        </div>

        <!-- Packing Summary Cards -->
        <div id="printSummaryCards"></div>

        <!-- Detailed Packing Table -->
        <div id="printTableContainer"></div>

        <!-- Grand Total Footer -->
        <div id="printGrandTotal" style="margin-top: 25px; text-align: right; padding: 15px; background: #f5f5f5; border-radius: 8px;">
            <!-- Will be filled dynamically -->
        </div>

        <!-- Footer -->
        <div style="margin-top: 30px; text-align: center; border-top: 1px solid #ddd; padding-top: 20px; font-size: 11px; color: #888;">
            <p>This is a computer generated packing summary. No signature required.</p>
            <p>Generated on: <span id="printTimestamp"></span></p>
            <p style="color: #1a5f7a; font-weight: bold;">Thank you for your business!</p>
        </div>
    </div>
</div>


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | SANIYA Garment ERP</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        /* ========== RESET ========== */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: #0f172a;
            position: relative;
            overflow: hidden;
        }
        
        /* ========== ANIMATED BACKGROUND ========== */
        body::before {
            content: '';
            position: absolute;
            inset: 0;
            background: 
                radial-gradient(ellipse at 20% 50%, rgba(67,97,238,0.15) 0%, transparent 60%),
                radial-gradient(ellipse at 80% 80%, rgba(129,140,248,0.1) 0%, transparent 60%);
            pointer-events: none;
        }
        
        .grid-bg {
            position: absolute;
            inset: 0;
            background-image: 
                linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
            background-size: 60px 60px;
            pointer-events: none;
            animation: gridMove 20s linear infinite;
        }
        
        @keyframes gridMove {
            0% { transform: translateY(0); }
            100% { transform: translateY(60px); }
        }
        
        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
            opacity: 0.3;
        }
        .orb-1 { width: 300px; height: 300px; background: #4361ee; top: -100px; right: -100px; }
        .orb-2 { width: 200px; height: 200px; background: #818cf8; bottom: -50px; left: -50px; }
        
        /* ========== LOGIN CONTAINER ========== */
        .login-wrapper {
            width: 480px;
            max-width: 100%;
            position: relative;
            z-index: 1;
        }
        
        .login-card {
            background: rgba(255,255,255,0.98);
            backdrop-filter: blur(20px);
            border-radius: 32px;
            padding: 40px 35px 30px;
            box-shadow: 0 30px 60px -20px rgba(0,0,0,0.6);
            border: 1px solid rgba(255,255,255,0.1);
            transition: all 0.3s;
        }
        
        /* ========== HEADER ========== */
        .login-header {
            text-align: center;
            margin-bottom: 32px;
        }
        
        .login-logo {
            width: 72px;
            height: 72px;
            background: linear-gradient(135deg, #4361ee, #818cf8);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
            box-shadow: 0 10px 30px -5px rgba(67,97,238,0.3);
        }
        .login-logo i {
            font-size: 2rem;
            color: white;
        }
        
        .login-header h1 {
            font-size: 1.5rem;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.5px;
        }
        .login-header p {
            font-size: 0.85rem;
            color: #64748b;
            margin-top: 4px;
        }
        
        /* ========== ALERT ========== */
        .alert {
            padding: 12px 16px;
            border-radius: 12px;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            animation: slideDown 0.3s ease;
        }
        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .alert-danger { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
        .alert-success { background: #f0fdf4; color: #16a34a; border: 1px solid #dcfce7; }
        .alert-info { background: #eff6ff; color: #2563eb; border: 1px solid #dbeafe; }
        
        /* ========== ROLE SELECTOR ========== */
        .role-selector {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
            margin-bottom: 28px;
        }
        .role-option {
            text-align: center;
            padding: 10px 4px;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s;
            background: white;
        }
        .role-option:hover {
            border-color: #4361ee;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(67,97,238,0.1);
        }
        .role-option.active {
            background: linear-gradient(135deg, #4361ee, #818cf8);
            border-color: #4361ee;
            color: white;
        }
        .role-option.active i { color: white; }
        .role-option i {
            font-size: 1.2rem;
            color: #94a3b8;
            display: block;
            margin-bottom: 4px;
        }
        .role-option span {
            font-size: 0.6rem;
            font-weight: 600;
            display: block;
        }
        
        /* ========== FORM ========== */
        .form-group {
            margin-bottom: 18px;
        }
        .form-group label {
            display: block;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #94a3b8;
            margin-bottom: 6px;
        }
        .input-group {
            position: relative;
        }
        .input-group i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 1rem;
        }
        .input-group input {
            width: 100%;
            padding: 12px 15px 12px 44px;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            font-size: 0.9rem;
            font-family: 'Inter', sans-serif;
            transition: all 0.3s;
            background: white;
        }
        .input-group input:focus {
            outline: none;
            border-color: #4361ee;
            box-shadow: 0 0 0 3px rgba(67,97,238,0.1);
        }
        .input-group input::placeholder {
            color: #94a3b8;
            font-size: 0.85rem;
        }
        
        /* ========== BUTTON ========== */
        .btn-login {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #4361ee, #818cf8);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px -5px rgba(67,97,238,0.4);
        }
        .btn-login:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
        }
        
        /* ========== DEMO CREDENTIALS ========== */
        .demo-section {
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid #e2e8f0;
        }
        .demo-section h4 {
            font-size: 0.75rem;
            font-weight: 600;
            color: #64748b;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .demo-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }
        .demo-card {
            background: #f8fafc;
            border-radius: 10px;
            padding: 8px 10px;
            cursor: pointer;
            transition: all 0.3s;
            border: 1px solid #e2e8f0;
            text-align: center;
        }
        .demo-card:hover {
            background: #f1f5f9;
            transform: translateY(-2px);
            border-color: #4361ee;
        }
        .demo-card .role {
            font-size: 0.6rem;
            font-weight: 600;
            color: #4361ee;
        }
        .demo-card .email {
            font-size: 0.65rem;
            font-weight: 500;
            color: #0f172a;
            font-family: monospace;
            margin-top: 2px;
        }
        .demo-card .pass {
            font-size: 0.55rem;
            color: #94a3b8;
            margin-top: 2px;
        }
        
        /* ========== FOOTER ========== */
        .login-footer {
            text-align: center;
            margin-top: 20px;
            font-size: 0.65rem;
            color: #94a3b8;
        }
        
        /* ========== SPINNER ========== */
        .spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid rgba(255,255,255,0.3);
            border-top-color: white;
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        /* ========== RESPONSIVE ========== */
        @media (max-width: 520px) {
            .login-card { padding: 28px 20px; }
            .role-selector { grid-template-columns: repeat(3, 1fr); }
            .demo-grid { grid-template-columns: repeat(2, 1fr); }
            .login-header h1 { font-size: 1.2rem; }
        }
        @media (max-width: 400px) {
            .role-selector { grid-template-columns: repeat(2, 1fr); }
            .demo-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

<!-- Animated Background -->
<div class="grid-bg"></div>
<div class="orb orb-1"></div>
<div class="orb orb-2"></div>

<!-- ========== LOGIN CARD ========== -->
<div class="login-wrapper">
    <div class="login-card">
        
        <!-- Header -->
        <div class="login-header">
            <div class="login-logo">
                <i class="fas fa-tshirt"></i>
            </div>
            <h1>Garment ERP</h1>
            <p>Premium Garment Management Solution</p>
        </div>
        
        <!-- Alert -->
        <div id="alertMessage"></div>
        
        <!-- Role Selector -->
        <div class="role-selector" id="roleSelector">
            <div class="role-option active" data-role="admin">
                <i class="fas fa-crown"></i>
                <span>Admin</span>
            </div>
            <div class="role-option" data-role="cutting_master">
                <i class="fas fa-cut"></i>
                <span>Cutting</span>
            </div>
            <div class="role-option" data-role="karigar">
                <i class="fas fa-user-check"></i>
                <span>Karigar</span>
            </div>
            <div class="role-option" data-role="helper">
                <i class="fas fa-hand-sparkles"></i>
                <span>Helper</span>
            </div>
            <div class="role-option" data-role="pressman">
                <i class="fas fa-industry"></i>
                <span>Pressman</span>
            </div>
        </div>
        
        <!-- Form -->
        <form id="loginForm">
            <div class="form-group">
                <label>Email or Username</label>
                <div class="input-group">
                    <i class="fas fa-envelope"></i>
                    <!-- ✅ FIXED: Changed from email to text -->
                    <input type="text" id="email" class="form-control-custom" 
                           placeholder="Enter email or username" required autocomplete="username">
                </div>
                <small class="text-muted" style="font-size: 0.65rem; color: #94a3b8; margin-top: 4px; display: block;">
                    <i class="fas fa-info-circle"></i> Use <strong>username</strong> or <strong>email</strong> to login
                </small>
            </div>
            
            <div class="form-group">
                <label>Password</label>
                <div class="input-group">
                    <i class="fas fa-lock"></i>
                    <input type="password" id="password" class="form-control-custom" 
                           placeholder="Enter your password" required autocomplete="current-password">
                </div>
            </div>
            
            <input type="hidden" id="role" value="admin">
            
            <button type="submit" class="btn-login" id="loginBtn">
                <i class="fas fa-arrow-right-to-bracket"></i> Login
            </button>
        </form>
        
        <!-- Demo Credentials -->
        <div class="demo-section">
            <h4><i class="fas fa-key"></i> Quick Login (Click to auto-fill)</h4>
            <div class="demo-grid">
                <div class="demo-card" data-email="admin@garment.com" data-role="admin">
                    <div class="role">👑 Admin</div>
                    <div class="email">admin@garment.com</div>
                    <div class="pass">🔑 admin123</div>
                </div>
                <div class="demo-card" data-email="cutting@garment.com" data-role="cutting_master">
                    <div class="role">✂️ Cutting</div>
                    <div class="email">cutting@garment.com</div>
                    <div class="pass">🔑 worker123</div>
                </div>
                <div class="demo-card" data-email="karigar1@garment.com" data-role="karigar">
                    <div class="role">👔 Karigar</div>
                    <div class="email">karigar1@garment.com</div>
                    <div class="pass">🔑 worker123</div>
                </div>
                <div class="demo-card" data-email="helper1@garment.com" data-role="helper">
                    <div class="role">🤝 Helper</div>
                    <div class="email">helper1@garment.com</div>
                    <div class="pass">🔑 worker123</div>
                </div>
                <div class="demo-card" data-email="pressman@garment.com" data-role="pressman">
                    <div class="role">🔥 Pressman</div>
                    <div class="email">pressman@garment.com</div>
                    <div class="pass">🔑 worker123</div>
                </div>
                <!-- ✅ ADDED: Worker with username login -->
                <div class="demo-card" data-email="worker" data-role="helper">
                    <div class="role">👷 Worker</div>
                    <div class="email">username: worker</div>
                    <div class="pass">🔑 worker123</div>
                </div>
            </div>
        </div>
        
        <!-- Footer -->
        <div class="login-footer">
            <p>&copy; 2026 SANIYA Garment. All rights reserved.</p>
        </div>
    </div>
</div>

<!-- ========== SCRIPT ========== -->
<script>
    // ============ ROLE SELECTOR ============
    const roleOptions = document.querySelectorAll('.role-option');
    const roleInput = document.getElementById('role');
    const emailInput = document.getElementById('email');
    const passwordInput = document.getElementById('password');
    
    const demoCredentials = {
        'admin': { email: 'admin@garment.com', password: 'admin123' },
        'cutting_master': { email: 'cutting@garment.com', password: 'worker123' },
        'karigar': { email: 'karigar1@garment.com', password: 'worker123' },
        'helper': { email: 'helper1@garment.com', password: 'worker123' },
        'pressman': { email: 'pressman@garment.com', password: 'worker123' },
        'worker': { email: 'worker', password: 'worker123' }
    };
    
    roleOptions.forEach(option => {
        option.addEventListener('click', function() {
            roleOptions.forEach(opt => opt.classList.remove('active'));
            this.classList.add('active');
            const role = this.dataset.role;
            roleInput.value = role;
            
            if (demoCredentials[role]) {
                emailInput.value = demoCredentials[role].email;
                passwordInput.value = demoCredentials[role].password;
            }
        });
    });
    
    // Demo card click
    document.querySelectorAll('.demo-card').forEach(card => {
        card.addEventListener('click', function() {
            const email = this.dataset.email;
            const role = this.dataset.role;
            roleOptions.forEach(opt => {
                if (opt.dataset.role === role) {
                    opt.click();
                }
            });
            emailInput.value = email;
            passwordInput.value = 'worker123';
            
            // Trigger login automatically
            document.getElementById('loginForm').dispatchEvent(new Event('submit'));
        });
    });
    
    // ============ LOGIN HANDLER ============
    const loginForm = document.getElementById('loginForm');
    const loginBtn = document.getElementById('loginBtn');
    const alertDiv = document.getElementById('alertMessage');
    
    loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const email = emailInput.value.trim();
        const password = passwordInput.value;
        const role = roleInput.value;
        
        if (!email || !password) {
            showAlert('Please enter email and password', 'danger');
            return;
        }
        
        loginBtn.disabled = true;
        loginBtn.innerHTML = 'Logging in <span class="spinner"></span>';
        
        try {
            const response = await fetch('/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password, role })
            });
            
            const data = await response.json();
            
            if (response.ok) {
                showAlert('✅ Login successful! Redirecting...', 'success');
                setTimeout(() => {
                    window.location.href = data.redirectUrl || '/dashboard';
                }, 800);
            } else {
                showAlert('❌ ' + (data.error || 'Invalid credentials'), 'danger');
                loginBtn.disabled = false;
                loginBtn.innerHTML = '<i class="fas fa-arrow-right-to-bracket"></i> Login';
            }
        } catch (error) {
            console.error('Login error:', error);
            showAlert('❌ Network error. Please try again.', 'danger');
            loginBtn.disabled = false;
            loginBtn.innerHTML = '<i class="fas fa-arrow-right-to-bracket"></i> Login';
        }
    });
    
    function showAlert(message, type) {
        alertDiv.innerHTML = `
            <div class="alert alert-${type}">
                <i class="fas fa-${type === 'danger' ? 'exclamation-circle' : 'check-circle'}"></i>
                ${message}
            </div>
        `;
        setTimeout(() => { alertDiv.innerHTML = ''; }, 5000);
    }
    
    // Set default admin
    emailInput.value = 'admin@garment.com';
    passwordInput.value = 'admin123';
</script>
</body>
</html>
<%
const currentPage = 'workers';
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Garment ERP</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    
    <style>
        .info-card {
            background: white;
            border-radius: 16px;
            padding: 20px;
            border: 1px solid #e2e8f0;
            margin-bottom: 20px;
        }
        .info-label {
            font-size: 0.75rem;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .info-value {
            font-size: 1rem;
            font-weight: 600;
            color: #1e293b;
        }
        .document-card {
            background: #f8fafc;
            border-radius: 12px;
            padding: 15px;
            text-align: center;
            border: 1px solid #e2e8f0;
            transition: all 0.3s;
        }
        .document-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }
        .document-card .doc-icon {
            font-size: 2rem;
            color: #4361ee;
            margin-bottom: 8px;
        }
        .document-card .doc-name {
            font-weight: 600;
            font-size: 0.9rem;
        }
        .document-card .doc-link {
            color: #4361ee;
            text-decoration: none;
            font-size: 0.8rem;
        }
        .document-card .doc-link:hover {
            text-decoration: underline;
        }
        .badge-status {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.7rem;
        }
        .doc-img {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #e2e8f0;
        }
        .doc-img:hover {
            border-color: #4361ee;
        }
    </style>
</head>
<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand" href="/dashboard">
            <i class="fas fa-tshirt"></i> Garment ERP
        </a>
        <div class="ms-auto">
            <span class="text-white me-3">
                <i class="fas fa-user"></i> <%= user ? user.username : 'Admin' %>
            </span>
            <a href="/auth/logout" class="btn btn-sm btn-outline-light">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </div>
</nav>

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3><i class="fas fa-user-circle text-primary"></i> Worker Details</h3>
            <p class="text-muted">
                <%= worker.email || worker.phone %> 
                <span class="badge bg-<%= worker.workerType === 'karigar' ? 'primary' : worker.workerType === 'pressman' ? 'info' : worker.workerType === 'helper' ? 'warning' : 'danger' %> ms-2">
                    <%= worker.workerType?.toUpperCase() || 'N/A' %>
                </span>
                <span class="badge bg-<%= worker.paymentType === 'monthly' ? 'success' : 'info' %>">
                    <%= worker.paymentType?.toUpperCase() || 'N/A' %>
                </span>
            </p>
        </div>
        <div>
            <a href="/workers" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Workers
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Personal Information -->
        <div class="col-md-6">
            <div class="info-card">
                <h6 class="fw-bold mb-3"><i class="fas fa-user"></i> Personal Information</h6>
                
                <div class="row mb-2">
                    <div class="col-4 info-label">Full Name</div>
                    <div class="col-8 info-value"><%= worker.name %></div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 info-label">Phone</div>
                    <div class="col-8 info-value"><%= worker.phone || 'N/A' %></div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 info-label">Email</div>
                    <div class="col-8 info-value"><%= worker.email || 'N/A' %></div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 info-label">Address</div>
                    <div class="col-8 info-value"><%= worker.address || 'N/A' %></div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 info-label">Status</div>
                    <div class="col-8">
                        <span class="badge-status badge bg-<%= worker.isActive ? 'success' : 'secondary' %>">
                            <%= worker.isActive ? 'Active' : 'Inactive' %>
                        </span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 info-label">Joining Date</div>
                    <div class="col-8 info-value">
                        <%= worker.joiningDate ? new Date(worker.joiningDate).toLocaleDateString('en-IN') : 'N/A' %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Worker Details -->
        <div class="col-md-6">
            <div class="info-card">
                <h6 class="fw-bold mb-3"><i class="fas fa-briefcase"></i> Worker Details</h6>
                
                <div class="row mb-2">
                    <div class="col-4 info-label">Worker Type</div>
                    <div class="col-8 info-value">
                        <span class="badge bg-<%= worker.workerType === 'karigar' ? 'primary' : 
                                                  worker.workerType === 'pressman' ? 'info' : 
                                                  worker.workerType === 'helper' ? 'warning' : 'danger' %>">
                            <%= worker.workerType?.toUpperCase() || 'N/A' %>
                        </span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 info-label">Payment Type</div>
                    <div class="col-8 info-value"><%= worker.paymentType?.toUpperCase() || 'N/A' %></div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 info-label">Monthly Rate</div>
                    <div class="col-8 info-value">₹<%= worker.monthlyRate || 0 %></div>
                </div>
                <% if (user) { %>
                <div class="row mb-2">
                    <div class="col-4 info-label">Username</div>
                    <div class="col-8 info-value"><%= user.username %></div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 info-label">Role</div>
                    <div class="col-8 info-value"><%= user.role?.toUpperCase() || 'N/A' %></div>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- ✅ DOCUMENTS - Merged from both codes -->
    <!-- ============================================================ -->
    <div class="info-card">
        <h6 class="fw-bold mb-3"><i class="fas fa-file-alt"></i> Documents</h6>
        
        <div class="row g-3">
            <% 
            // ✅ Check if documents exist (array format from new code)
            const hasDocs = worker.documents && worker.documents.length > 0;
            
            // ✅ Check if documents exist (old format with aadhar, pan, photo)
            const hasOldDocs = worker.documents && (
                worker.documents.aadhar || 
                worker.documents.pan || 
                worker.documents.photo
            );
            %>
            
            <% if (hasDocs) { %>
                <!-- ✅ NEW FORMAT: Array of documents -->
                <% worker.documents.forEach(doc => { %>
                    <div class="col-md-3">
                        <div class="document-card">
                            <div class="doc-icon">
                                <i class="fas <%= doc.name === 'Aadhar' || doc.name === 'aadhar' ? 'fa-id-card' : 
                                                  doc.name === 'Pan' || doc.name === 'pan' ? 'fa-file-invoice' : 
                                                  doc.name === 'Photo' || doc.name === 'photo' ? 'fa-image' : 'fa-file' %>"></i>
                            </div>
                            <div class="doc-name"><%= doc.name?.charAt(0).toUpperCase() + doc.name?.slice(1) || 'Document' %></div>
                            <a href="<%= doc.url %>" class="doc-link" target="_blank">
                                <i class="fas fa-eye"></i> View
                            </a>
                            <br>
                            <small class="text-muted">
                                <%= doc.uploadedAt ? new Date(doc.uploadedAt).toLocaleDateString('en-IN') : '' %>
                            </small>
                        </div>
                    </div>
                <% }) %>
                
            <% } else if (hasOldDocs) { %>
                <!-- ✅ OLD FORMAT: aadhar, pan, photo as separate fields -->
                <% if (worker.documents.aadhar) { %>
                    <div class="col-md-3">
                        <div class="document-card">
                            <div class="doc-icon"><i class="fas fa-id-card"></i></div>
                            <div class="doc-name">Aadhar</div>
                            <a href="<%= worker.documents.aadhar %>" class="doc-link" target="_blank">
                                <i class="fas fa-eye"></i> View
                            </a>
                        </div>
                    </div>
                <% } %>
                
                <% if (worker.documents.pan) { %>
                    <div class="col-md-3">
                        <div class="document-card">
                            <div class="doc-icon"><i class="fas fa-file-invoice"></i></div>
                            <div class="doc-name">PAN</div>
                            <a href="<%= worker.documents.pan %>" class="doc-link" target="_blank">
                                <i class="fas fa-eye"></i> View
                            </a>
                        </div>
                    </div>
                <% } %>
                
                <% if (worker.documents.photo) { %>
                    <div class="col-md-3">
                        <div class="document-card">
                            <div class="doc-icon"><i class="fas fa-image"></i></div>
                            <div class="doc-name">Photo</div>
                            <img src="<%= worker.documents.photo %>" alt="Photo" class="doc-img">
                        </div>
                    </div>
                <% } %>
                
            <% } else { %>
                <div class="col-12">
                    <div class="text-center py-4 text-muted">
                        <i class="fas fa-file-alt fa-2x mb-2"></i>
                        <p>No documents uploaded</p>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- ✅ WORK SUMMARY (For Piece-based Workers) -->
    <!-- ============================================================ -->
    <% if (worker.paymentType === 'piece') { %>
    <div class="info-card">
        <h6 class="fw-bold mb-3"><i class="fas fa-chart-bar"></i> Work Summary</h6>
        <div id="workSummaryDiv">
            <div class="text-center py-3">
                <i class="fas fa-spinner fa-spin"></i> Loading...
            </div>
        </div>
    </div>
    <% } %>

    <!-- ============================================================ -->
    <!-- ✅ PAYMENT HISTORY -->
    <!-- ============================================================ -->
    <div class="info-card">
        <h6 class="fw-bold mb-3"><i class="fas fa-money-bill-wave"></i> Payment History</h6>
        <div id="paymentHistoryDiv">
            <div class="text-center py-3">
                <i class="fas fa-spinner fa-spin"></i> Loading...
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- ✅ PAYMENT DETAILS -->
    <!-- ============================================================ -->
    <div class="info-card">
        <h6 class="fw-bold mb-3"><i class="fas fa-coins"></i> Payment Details</h6>
        <div class="row">
            <div class="col-md-6">
                <div class="info-label">Payment Type</div>
                <div class="info-value">
                    <% if(worker.paymentType === 'monthly'){ %>
                        Monthly Fixed Salary
                    <% } else { %>
                        Piece-based
                    <% } %>
                </div>
            </div>
            <div class="col-md-6">
                <div class="info-label">Rate</div>
                <div class="info-value">
                    <% if(worker.paymentType === 'monthly'){ %>
                        ₹<%= worker.monthlyRate %> / month
                    <% } else { 
                        let rateLink = '/products';
                        if(worker.workerType === 'pressman') rateLink = '/pressman/products';
                    %>
                        Rate fetched from 
                        <a href="<%= rateLink %>">
                            <% if(worker.workerType === 'pressman'){ %>Pressman Products<% } else { %>Products<% } %>
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(async function() {
    const workerId = '<%= worker._id %>';
    const workerType = '<%= worker.workerType %>';
    const paymentType = '<%= worker.paymentType %>';

    // ========== Payment History ==========
    try {
        const payRes = await fetch(`/workers/payment-history/${workerId}`);
        const payData = await payRes.json();
        if(payData.payments && payData.payments.length){
            let html = `<div class="table-responsive">
                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr><th>Date</th><th>Amount</th><th>Method</th><th>Remark</th></tr>
                    </thead>
                    <tbody>`;
            payData.payments.forEach(p => {
                html += `<tr>
                    <td>${new Date(p.paymentDate).toLocaleDateString('en-IN')}</td>
                    <td><strong>₹${p.amount}</strong></td>
                    <td>${p.paymentMethod || 'Cash'}</td>
                    <td>${p.remark || '-'}</td>
                </tr>`;
            });
            html += `</tbody></table></div>`;
            document.getElementById('paymentHistoryDiv').innerHTML = html;
        } else {
            document.getElementById('paymentHistoryDiv').innerHTML = '<p class="text-muted">No payments recorded.</p>';
        }
    } catch(e) {
        document.getElementById('paymentHistoryDiv').innerHTML = '<p class="text-muted">Payment history not available.</p>';
    }

    // ========== Work Summary for piece workers ==========
    if(paymentType === 'piece'){
        try {
            let url = workerType === 'karigar' ? `/workers/karigar-work/${workerId}` : `/workers/pressman-work/${workerId}`;
            const workRes = await fetch(url);
            const workData = await workRes.json();
            
            if((workData.work && workData.work.length) || (workData.entries && workData.entries.length)){
                let html = `<div class="table-responsive"><table class="table table-sm table-bordered"><thead class="table-light"><tr>`;
                if(workerType === 'karigar'){
                    html += `<th>Week</th><th>Product</th><th>Pieces</th><th>Amount (₹)</th></tr></thead><tbody>`;
                    workData.work.forEach(w => {
                        html += `<tr>
                            <td>${new Date(w.weekStart).toLocaleDateString()} - ${new Date(w.weekEnd).toLocaleDateString()}</td>
                            <td>${w.product}</td>
                            <td>${w.pieces}</td>
                            <td>₹${w.amount}</td>
                        </tr>`;
                    });
                } else if(workerType === 'pressman'){
                    html += `<th>Date</th><th>Entry #</th><th>Products</th><th>Qty</th><th>Amount</th></tr></thead><tbody>`;
                    workData.entries.forEach(e => {
                        html += `<tr>
                            <td>${new Date(e.date).toLocaleDateString()}</td>
                            <td>${e.entryNumber}</td>
                            <td>${e.entries?.length || 0} items</td>
                            <td>${e.totalQuantity}</td>
                            <td>₹${e.totalAmount}</td>
                        </tr>`;
                    });
                }
                html += `</tbody></table></div>`;
                document.getElementById('workSummaryDiv').innerHTML = html;
            } else {
                document.getElementById('workSummaryDiv').innerHTML = '<p class="text-muted">No work records found.</p>';
            }
        } catch(e) {
            document.getElementById('workSummaryDiv').innerHTML = '<p class="text-muted">Work summary not available.</p>';
        }
    }
})();
</script>
</body>
</html>
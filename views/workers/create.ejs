<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="fas fa-user-plus"></i> Add New Worker</h4>
            </div>
            <div class="card-body">
                <form action="/workers/create" method="POST" enctype="multipart/form-data">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="name" class="form-label">Full Name *</label>
                            <input type="text" class="form-control" id="name" name="name" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="phone" class="form-label">Phone Number *</label>
                            <input type="tel" class="form-control" id="phone" name="phone" required>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" name="email">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="address" class="form-label">Address</label>
                            <textarea class="form-control" id="address" name="address" rows="2"></textarea>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="workerType" class="form-label">Worker Type *</label>
                            <select class="form-control" id="workerType" name="workerType" required>
                                <option value="">Select Type</option>
                                <option value="cutting">Cutting Worker (Monthly Fixed)</option>
                                <option value="karigar">Karigar (Piece-based - Rate from Product)</option>
                                <option value="helper">Helper (Finishing - Monthly Fixed)</option>
                                <option value="pressman">Pressman (Piece-based - Rate from Product)</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="paymentType" class="form-label">Payment Type *</label>
                            <select class="form-control" id="paymentType" name="paymentType" required>
                                <option value="">Select Payment Type</option>
                                <option value="monthly">Monthly Fixed</option>
                                <option value="piece">Piece-based (Rate from Product)</option>
                            </select>
                        </div>
                    </div>
                    
                    <!-- Monthly Rate Field (shows only for monthly paid workers) -->
                    <div class="row" id="monthlyRateDiv" style="display: none;">
                        <div class="col-md-6 mb-3">
                            <label for="monthlyRate" class="form-label">Monthly Salary (₹) *</label>
                            <input type="number" class="form-control" id="monthlyRate" name="monthlyRate" step="0.01">
                            <small class="text-muted">For Cutting Worker and Helper only</small>
                        </div>
                    </div>
                    
                    <!-- Info for piece-based workers -->
                    <div class="alert alert-info" id="pieceInfoDiv" style="display: none;">
                        <i class="fas fa-info-circle"></i>
                        <strong>Piece-based Worker:</strong> Rate will be fetched from Product Management.
                        Set per-piece rate in <a href="/products">Products → Karigar Rate / Pressman Rate</a>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="aadhar" class="form-label">Aadhar Card</label>
                            <input type="file" class="form-control" id="aadhar" name="aadhar" accept=".jpg,.jpeg,.png,.pdf">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="pan" class="form-label">PAN Card</label>
                            <input type="file" class="form-control" id="pan" name="pan" accept=".jpg,.jpeg,.png,.pdf">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="photo" class="form-label">Photo</label>
                            <input type="file" class="form-control" id="photo" name="photo" accept=".jpg,.jpeg,.png">
                        </div>
                    </div>
                    
                    <div class="text-center">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Save Worker
                        </button>
                        <a href="/workers" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    const workerType = document.getElementById('workerType');
    const paymentType = document.getElementById('paymentType');
    const monthlyRateDiv = document.getElementById('monthlyRateDiv');
    const pieceInfoDiv = document.getElementById('pieceInfoDiv');
    
    function updateFields() {
        const type = workerType.value;
        const payment = paymentType.value;
        
        if (payment === 'monthly') {
            monthlyRateDiv.style.display = 'flex';
            pieceInfoDiv.style.display = 'none';
            document.getElementById('monthlyRate').required = true;
        } else {
            monthlyRateDiv.style.display = 'none';
            pieceInfoDiv.style.display = 'block';
            document.getElementById('monthlyRate').required = false;
        }
    }
    
    workerType.addEventListener('change', updateFields);
    paymentType.addEventListener('change', updateFields);
</script>
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-iron"></i> Finishing Management</h2>
    <a href="/finishing/create" class="btn btn-primary">
        <i class="fas fa-plus"></i> New Finishing Entry
    </a>
</div>

<!-- Simple Filter Form (Optional) -->
<div class="card mb-3">
    <div class="card-body">
        <form method="GET" class="row g-2">
            <div class="col-md-4">
                <select name="helper" class="form-control">
                    <option value="">All Helpers</option>
                    <% if(helpers && helpers.length) { %>
                        <% helpers.forEach(h => { %>
                            <option value="<%= h._id %>"><%= h.name %></option>
                        <% }) %>
                    <% } %>
                </select>
            </div>
            <div class="col-md-3">
                <input type="date" name="fromDate" class="form-control" placeholder="From Date">
            </div>
            <div class="col-md-3">
                <input type="date" name="toDate" class="form-control" placeholder="To Date">
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-secondary w-100">🔍 Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Finishing Records Table -->
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-bordered text-center">
                <thead class="table-dark">
                    <tr>
                        <th>FIN #</th>
                        <th>Assignment</th>
                        <th>Helper</th>
                        <th>Received</th>
                        <th>Rejected</th>
                        <th>Passed</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(finishingRecords && finishingRecords.length > 0) { %>
                        <% finishingRecords.forEach(record => { %>
                        <tr class="<%= record.status === 'completed' ? 'table-success' : 'table-warning' %>">
                            <td><strong><%= record.finishingNumber %></strong></td>
                            <td><%= record.assignment?.assignmentId || 'N/A' %></td>
                            <td><%= record.helper?.name || 'N/A' %></td>
                            <td><%= record.receivedPieces %></td>
                            <td><%= record.rejectedPieces %></td>
                            <td><strong><%= record.passedPieces %></strong></td>
                            <!-- <td>
                                <% if(record.status === 'completed') { %>
                                    <span class="badge bg-success">Completed</span>
                                <% } else { %>
                                    <span class="badge bg-warning">Pending</span>
                                <% } %>
                            </td> -->

                            <td>
                                <% if(record.status === 'completed') { %>
                                    <span class="badge bg-success">✅ Completed</span>
                                <% } else if(record.status === 'partial') { %>
                                    <span class="badge bg-warning text-dark">⏳ Partial</span>
                                <% } else { %>
                                    <span class="badge bg-danger">⏰ Pending</span>
                                <% } %>
                            </td>


                            <td><%= new Date(record.finishingDate).toLocaleDateString() %></td>
                            <td>
                                <a href="/finishing/view/<%= record._id %>" class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="/finishing/delete/<%= record._id %>" class="btn btn-sm btn-danger" onclick="return confirm('Delete this finishing entry?')">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="9" class="text-center">No finishing records found</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
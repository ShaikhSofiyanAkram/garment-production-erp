<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4><i class="fas fa-iron"></i> Finishing Entry</h4>
                <small>Helper receives finished pieces from karigar</small>
            </div>
            <div class="card-body">
                <form action="/finishing/create" method="POST" id="finishingForm">
                    
                    <!-- Step 1: Select Karigar -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">🧑‍🏭 Step 1: Select Karigar *</label>
                        <select id="karigarSelect" class="form-control" required>
                            <option value="">-- Select Karigar --</option>
                            <% karigars.forEach(k => { %>
                                <option value="<%= k._id %>"><%= k.name %></option>
                            <% }) %>
                        </select>
                        <small class="text-muted">Karigar ka naam select karein jiska kaam finish karna hai</small>
                    </div>

                    <!-- Step 2: Select Production Return -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">📌 Step 2: Select Production Return *</label>
                        <select name="assignment" id="assignmentSelect" class="form-control" required disabled>
                            <option value="">-- First select karigar --</option>
                        </select>
                        <small class="text-muted" id="assignmentHint"></small>
                    </div>

                    <!-- Assignment Details Card -->
                    <div id="assignmentCard" class="card mb-3 d-none">
                        <div class="card-header bg-info text-white">
                            <i class="fas fa-info-circle"></i> Assignment Details
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <table class="table table-sm table-bordered">
                                        <tr class="table-secondary"><th colspan="2">📦 Production Return Summary</th></tr>
                                        <tr><td><strong>Product:</strong></td><td><span id="productName">—</span></td></tr>
                                        <tr><td><strong>🎯 Given to Karigar:</strong></td><td><span id="givenPieces">—</span> pcs</td></tr>
                                        <tr class="table-info"><td><strong>📥 Total Returned by Karigar:</strong></td><td><span id="returnedPieces" class="fw-bold">—</span> pcs</td></tr>
                                        <tr><td><strong>⚠️ Damage:</strong></td><td><span id="damagePieces">—</span> pcs</td></tr>
                                        <tr><td><strong>❓ Missing:</strong></td><td><span id="missingPieces">—</span> pcs</td></tr>
                                    </table>
                                </div>
                                <div class="col-md-6">
                                    <table class="table table-sm table-bordered">
                                        <tr class="table-secondary"><th colspan="2">✅ Finishing Status</th></tr>
                                        <tr class="table-success"><td><strong>Available for Finishing:</strong></td><td><span id="availablePieces" class="fw-bold text-success fs-3">—</span> pcs</td></tr>
                                        <tr id="alreadyFinishedRow" style="display:none;"><td><strong>Already Finished:</strong></td><td><span id="alreadyFinishedPieces">—</span> pcs</td></tr>
                                        <tr id="remainingRow" style="display:none;"><td><strong>Remaining Now:</strong></td><td><span id="remainingPieces" class="fw-bold text-warning">—</span> pcs</td></tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Select Helper -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">👥 Step 3: Select Helper *</label>
                        <select name="helper" class="form-control" required>
                            <option value="">-- Select Helper --</option>
                            <% helpers.forEach(h => { %>
                                <option value="<%= h._id %>"><%= h.name %></option>
                            <% }) %>
                        </select>
                    </div>

                    <!-- Step 4: Received & Rejected -->
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">📥 Received Pieces *</label>
                            <input type="number" name="receivedPieces" id="receivedPieces" class="form-control" required>
                            <small class="text-muted" id="maxHint"></small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">❌ Rejected Pieces</label>
                            <input type="number" name="rejectedPieces" id="rejectedPieces" class="form-control" value="0">
                        </div>
                    </div>

                    <!-- Passed Display -->
                    <div class="mt-3 mb-3">
                        <div class="alert alert-success text-center">
                            <strong>✅ Passed Pieces (Auto):</strong>
                            <span id="passedDisplay" class="fs-3 fw-bold">0</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">📝 Remark</label>
                        <textarea name="remark" class="form-control" rows="2" placeholder="Optional"></textarea>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2 fw-bold">✅ Save Finishing Entry</button>
                    <a href="/finishing" class="btn btn-secondary w-100 mt-2">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    const karigarSelect = document.getElementById('karigarSelect');
    const assignmentSelect = document.getElementById('assignmentSelect');
    const received = document.getElementById('receivedPieces');
    const rejected = document.getElementById('rejectedPieces');
    const passedDisplay = document.getElementById('passedDisplay');
    const maxHint = document.getElementById('maxHint');
    const assignmentHint = document.getElementById('assignmentHint');

    let currentAvailablePieces = 0;

    function calculatePassed() {
        let rec = parseInt(received.value) || 0;
        let rej = parseInt(rejected.value) || 0;
        let pass = rec - rej;
        if(pass < 0) pass = 0;
        passedDisplay.innerText = pass;
    }

    received.addEventListener('input', calculatePassed);
    rejected.addEventListener('input', calculatePassed);

    karigarSelect.addEventListener('change', async function() {
        const karigarId = this.value;
        const karigarName = this.options[this.selectedIndex]?.text;
        
        if(!karigarId) {
            assignmentSelect.disabled = true;
            assignmentSelect.innerHTML = '<option value="">-- First select karigar --</option>';
            document.getElementById('assignmentCard').classList.add('d-none');
            assignmentHint.innerText = '';
            return;
        }

        assignmentSelect.disabled = true;
        assignmentSelect.innerHTML = '<option value="">Loading...</option>';
        document.getElementById('assignmentCard').classList.add('d-none');
        
        try {
            const res = await fetch(`/finishing/returns-by-karigar/${karigarId}`);
            const data = await res.json();
            
            console.log('API Response:', data);
            
            if(data.success && data.returns && data.returns.length > 0) {
                let options = '<option value="">-- Select Assignment --</option>';
                data.returns.forEach(pr => {
                    console.log(`Option: ${pr.assignment.assignmentId}, Returned from API: ${pr.returned}`);
                    options += `<option value="${pr.assignment._id}" 
                        data-returned="${pr.returned}"
                        data-damage="${pr.damage}"
                        data-missing="${pr.missing}"
                        data-given="${pr.assignment.givenPieces}"
                        data-product="${pr.assignment.productName}">
                        ${pr.assignment.assignmentId} - ${pr.assignment.productName} (Returned: ${pr.returned} pcs)
                    </option>`;
                });
                assignmentSelect.innerHTML = options;
                assignmentSelect.disabled = false;
                assignmentHint.innerHTML = `<span class="text-success">✓ ${data.returns.length} pending production returns available</span>`;
            } else {
                assignmentSelect.innerHTML = '<option value="">No pending production returns</option>';
                assignmentSelect.disabled = true;
                assignmentHint.innerHTML = `<span class="text-warning">⚠️ No pending work for finishing</span>`;
            }
        } catch(err) {
            console.error(err);
            assignmentSelect.innerHTML = '<option value="">Error loading data</option>';
            assignmentHint.innerHTML = '<span class="text-danger">❌ Error loading production returns</span>';
        }
    });

    assignmentSelect.addEventListener('change', async function() {
        const assignmentId = this.value;
        if(!assignmentId) {
            document.getElementById('assignmentCard').classList.add('d-none');
            return;
        }

        const opt = this.options[this.selectedIndex];
        let returnedFromOpt = parseInt(opt.dataset.returned) || 0;
        const damageFromOpt = parseInt(opt.dataset.damage) || 0;
        const missingFromOpt = parseInt(opt.dataset.missing) || 0;
        const givenFromOpt = parseInt(opt.dataset.given) || 0;
        const productFromOpt = opt.dataset.product || 'N/A';
        
        console.log(`Selected assignment: ${opt.value}`);
        console.log(`Returned from option dataset: ${returnedFromOpt}`);
        
        document.getElementById('assignmentCard').classList.remove('d-none');
        document.getElementById('productName').innerText = productFromOpt;
        document.getElementById('givenPieces').innerText = givenFromOpt;
        document.getElementById('returnedPieces').innerText = returnedFromOpt;
        document.getElementById('damagePieces').innerText = damageFromOpt;
        document.getElementById('missingPieces').innerText = missingFromOpt;
        
        currentAvailablePieces = returnedFromOpt;
        document.getElementById('availablePieces').innerText = currentAvailablePieces;
        
        // Also fetch from API to verify
        try {
            const detailsRes = await fetch(`/finishing/assignment-details/${assignmentId}`);
            const details = await detailsRes.json();
            console.log('Assignment details API response:', details);
            if(details.success && details.productionReturn.returned > 0) {
                console.log(`API returned value: ${details.productionReturn.returned}, updating display`);
                document.getElementById('returnedPieces').innerText = details.productionReturn.returned;
                currentAvailablePieces = details.productionReturn.returned;
                document.getElementById('availablePieces').innerText = currentAvailablePieces;
            }
        } catch(err) {
            console.error('Error fetching details:', err);
        }
        
        // Check existing finishing
        try {
            const existingRes = await fetch(`/finishing/existing-for-assignment/${assignmentId}`);
            const existingData = await existingRes.json();
            
            if(existingData.success && existingData.totalFinished > 0) {
                document.getElementById('alreadyFinishedRow').style.display = 'table-row';
                document.getElementById('alreadyFinishedPieces').innerText = existingData.totalFinished;
                const remaining = currentAvailablePieces - existingData.totalFinished;
                if(remaining > 0) {
                    document.getElementById('remainingRow').style.display = 'table-row';
                    document.getElementById('remainingPieces').innerText = remaining;
                    currentAvailablePieces = remaining;
                    document.getElementById('availablePieces').innerText = currentAvailablePieces;
                } else {
                    document.getElementById('remainingRow').style.display = 'none';
                }
            } else {
                document.getElementById('alreadyFinishedRow').style.display = 'none';
                document.getElementById('remainingRow').style.display = 'none';
            }
        } catch(err) {
            console.error('Error:', err);
        }
        
        received.max = currentAvailablePieces;
        maxHint.innerText = `Maximum: ${currentAvailablePieces} pieces can be received`;
        received.placeholder = `Max ${currentAvailablePieces}`;
        received.disabled = false;
        received.value = '';
        rejected.value = 0;
        calculatePassed();
    });
</script>


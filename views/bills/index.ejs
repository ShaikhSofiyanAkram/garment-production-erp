<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h2><i class="fas fa-file-invoice-dollar text-primary"></i> Bills Management</h2>
        <p class="text-muted">Manage all invoices, payments, and pending amounts</p>
    </div>
    <a href="/bills/create" class="btn btn-primary btn-lg">
        <i class="fas fa-plus-circle"></i> Create New Bill
    </a>
</div>

<!-- Filters -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="GET" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Client</label>
                <select name="client" class="form-control">
                    <option value="">All Clients</option>
                    <% if (clients && clients.length) { %>
                        <% clients.forEach(c => { %>
                            <option value="<%= c._id %>" <%= (typeof client !== 'undefined' && client == c._id) ? 'selected' : '' %>><%= c.name %></option>
                        <% }) %>
                    <% } %>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">From Date</label>
                <input type="date" name="fromDate" class="form-control" value="<%= typeof fromDate !== 'undefined' ? fromDate : '' %>">
            </div>
            <div class="col-md-2">
                <label class="form-label">To Date</label>
                <input type="date" name="toDate" class="form-control" value="<%= typeof toDate !== 'undefined' ? toDate : '' %>">
            </div>
            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select name="status" class="form-control">
                    <option value="">All</option>
                    <option value="pending" <%= (typeof status !== 'undefined' && status === 'pending') ? 'selected' : '' %>>Pending</option>
                    <option value="partial" <%= (typeof status !== 'undefined' && status === 'partial') ? 'selected' : '' %>>Partial</option>
                    <option value="paid" <%= (typeof status !== 'undefined' && status === 'paid') ? 'selected' : '' %>>Paid</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search"></i> Filter
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Bills Table -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Bill #</th>
                        <th>Date</th>
                        <th>Client</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Paid</th>
                        <th>Pending</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(bills && bills.length) { %>
                        <% bills.forEach(bill => { %>
                            <tr>
                                <td class="fw-bold"><%= bill.billNumber %></td>
                                <td><%= new Date(bill.billDate).toLocaleDateString() %></td>
                                <td><%= bill.client?.name || 'N/A' %></td>
                                <td><%= bill.items?.length || 0 %> items</td>
                                <td class="text-end">₹<%= (bill.totalAmount || 0).toLocaleString() %></td>
                                <td class="text-end">₹<%= (bill.paidAmount || 0).toLocaleString() %></td>
                                <td class="text-end fw-bold">₹<%= (bill.pendingAmount || 0).toLocaleString() %></td>
                                <td>
                                    <% if(bill.status === 'paid') { %>
                                        <span class="badge bg-success">Paid</span>
                                    <% } else if(bill.status === 'partial') { %>
                                        <span class="badge bg-warning">Partial</span>
                                    <% } else { %>
                                        <span class="badge bg-danger">Pending</span>
                                    <% } %>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="/bills/view/<%= bill._id %>" class="btn btn-info" title="View"><i class="fas fa-eye"></i></a>
                                        <a href="/bills/print/<%= bill._id %>" class="btn btn-secondary" title="Print" target="_blank"><i class="fas fa-print"></i></a>
                                        <a href="/bills/whatsapp/<%= bill._id %>" class="btn btn-success" title="WhatsApp" target="_blank"><i class="fab fa-whatsapp"></i></a>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="9" class="text-center py-5">No bills found</td></tr>
                    <% } %>
                </tbody>
                <tfoot class="table-light">
                    <tr class="fw-bold">
                        <td colspan="4" class="text-end">Total:</td>
                        <td class="text-end">₹<%= bills ? bills.reduce((s,b)=>s+(b.totalAmount||0),0).toLocaleString() : 0 %></td>
                        <td class="text-end">₹<%= bills ? bills.reduce((s,b)=>s+(b.paidAmount||0),0).toLocaleString() : 0 %></td>
                        <td colspan="3">₹<%= bills ? bills.reduce((s,b)=>s+(b.pendingAmount||0),0).toLocaleString() : 0 %></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<div class="mt-3 text-end">
    <a href="/bills/pending-summary" class="btn btn-warning">
        <i class="fas fa-clock"></i> View Pending Bills Summary
    </a>       
</div>
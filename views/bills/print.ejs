<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Bill <%= bill.billNumber %></title>
    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 20px;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #000;
            padding-bottom: 10px;
        }
        .company-name {
            font-size: 24px;
            font-weight: bold;
        }
        .bill-title {
            font-size: 20px;
            margin-top: 10px;
        }
        .bill-details {
            margin-bottom: 20px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        th, td {
            border: 1px solid #000;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f2f2f2;
        }
        .total-row {
            font-weight: bold;
            background-color: #f2f2f2;
        }
        .footer {
            margin-top: 30px;
            text-align: center;
            font-size: 12px;
        }
        .amount-in-words {
            margin-top: 20px;
            font-style: italic;
        }
        @media print {
            .no-print {
                display: none;
            }
        }
        .no-print {
            text-align: center;
            margin-top: 20px;
        }
        button {
            padding: 10px 20px;
            font-size: 16px;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div class="header">
    <div class="company-name"><%= locals.settings?.general?.company_name || 'GARMENT FACTORY ERP' %></div>
    <div><%= locals.settings?.general?.company_address || '123 Fashion Street, Garment District' %></div>
    <div>Phone: <%= locals.settings?.general?.company_phone || '+91 9876543210' %> | Email: <%= locals.settings?.general?.company_email || 'info@garmentfactory.com' %></div>
    <div>GST: <%= locals.settings?.general?.company_gst || '07AAACA1234A1Z' %></div>
    <div class="bill-title">TAX INVOICE</div>
</div>
    
    <div class="bill-details">
        <table style="border: none;">
            <tr>
                <td style="border: none;"><strong>Bill No:</strong> <%= bill.billNumber %></td>
                <td style="border: none;"><strong>Date:</strong> <%= new Date(bill.billDate).toLocaleDateString() %></td>
            </tr>
            <tr>
                <td style="border: none;"><strong>Client:</strong> <%= bill.client %></td>
                <td style="border: none;"><strong>Due Date:</strong> <%= bill.dueDate ? new Date(bill.dueDate).toLocaleDateString() : 'N/A' %></td>
            </tr>
        </table>
    </div>
    
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Product</th>
                <th>Quantity</th>
                <th>Rate (₹)</th>
                <th>Amount (₹)</th>
            </tr>
        </thead>
        <tbody>
            <% bill.items.forEach((item, index) => { %>
            <tr>
                <td><%= index + 1 %></td>
                <td><%= item.product?.name %></td>
                <td><%= item.quantity %></td>
                <td><%= item.rate %></td>
                <td class="text-end">₹<%= item.amount.toLocaleString() %></td>
            </tr>
            <% }) %>
            <tr class="total-row">
                <td colspan="4" style="text-align: right;"><strong>Total:</strong></td>
                <td><strong>₹<%= bill.totalAmount.toLocaleString() %></strong></td>
            </tr>
        </tbody>
    </table>
    
    <div class="amount-in-words">
        <strong>Amount in Words:</strong> <%= new Number(bill.totalAmount).toLocaleString() %> Rupees Only
    </div>
    
    <div style="margin-top: 40px;">
        <table style="border: none;">
            <tr>
                <td style="border: none; width: 50%;">
                    <strong>For GARMENT FACTORY ERP</strong><br><br><br>
                    (Authorized Signatory)
                </td>
                <td style="border: none; width: 50%;">
                    <strong>Client Signature</strong><br><br><br>
                    ___________________
                </td>
            </tr>
        </table>
    </div>
    
   <!-- Footer mein -->
<div class="footer">
    <%= locals.settings?.general?.bill_footer || 'Thank you for your business!' %><br>
    This is a computer generated invoice.
</div>
    
    <div class="no-print">
        <button onclick="window.print()">Print Bill</button>
        <button onclick="window.close()">Close</button>
    </div>
    
    <script>
        window.onload = function() {
            setTimeout(function() {
                window.print();
            }, 500);
        }
    </script>
</body>
</html>
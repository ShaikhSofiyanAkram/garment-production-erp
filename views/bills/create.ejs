    // ============ LOAD SIZES FOR ROW ============
    // ============ LOAD SIZES FOR ROW (FIXED) ============
function loadSizesForRow(idx, productName, category) {
    const rowDiv = document.getElementById('row_' + idx);
    const sizeSelect = rowDiv.querySelector('.sizeSel');
    const manualSize = rowDiv.querySelector('.manualSize');
    const sizeHint = document.getElementById('sizeHint_' + idx);
    
    // ✅ Get sizes with category filter
    const sizes = getSizesForProduct(productName, category);
    const currentValue = sizeSelect.value;
    
    sizeSelect.innerHTML = '<option value="">Select Size</option>';
    if (sizes && sizes.length > 0) {
        // Sort sizes numerically
        const sortedSizes = [...sizes].sort((a, b) => {
            const aNum = parseInt(a);
            const bNum = parseInt(b);
            if (!isNaN(aNum) && !isNaN(bNum)) return aNum - bNum;
            return a.localeCompare(b);
        });
        sortedSizes.forEach(s => {
            sizeSelect.innerHTML += `<option value="${s}">${s}</option>`;
        });
    }
    sizeSelect.innerHTML += '<option value="other">+ Manual Size</option>';
    
    // ✅ Restore previous value if valid
    if (currentValue && sizes.includes(currentValue)) {
        sizeSelect.value = currentValue;
    }
    manualSize.style.display = 'none';
    if (sizeHint) {
        sizeHint.innerHTML = sizes.length > 0 ? `${sizes.length} sizes available` : 'No sizes available';
        sizeHint.style.color = sizes.length > 0 ? '#28a745' : '#dc3545';
    }
}
    // ============ UPDATE ITEM ============
    function updateItem(idx) {
        const rowDiv = document.getElementById('row_' + idx);
        if (!rowDiv) return;
        
        const prodSelect = rowDiv.querySelector('.prodSel');
        const manualProd = rowDiv.querySelector('.manualProd');
        const catSelect = rowDiv.querySelector('.catSel');
        const manualCat = rowDiv.querySelector('.manualCat');
        const sizeSelect = rowDiv.querySelector('.sizeSel');
        const manualSize = rowDiv.querySelector('.manualSize');
        const qtyInput = rowDiv.querySelector('.qtyInp');
        const rateInput = rowDiv.querySelector('.rateInp');
        const amtInput = rowDiv.querySelector('.amtInp');
        
        let productName = '';
        let category = '';
        
        if (prodSelect.value === 'other') {
            productName = manualProd.value.trim();
            category = catSelect.value === 'Other' ? manualCat.value.trim() : catSelect.value;
        } else {
            const parts = prodSelect.value.split('|');
            productName = parts[0] || '';
            category = parts[1] || catSelect.value;
        }
        
        let size = sizeSelect.value === 'other' ? manualSize.value.trim() : sizeSelect.value;
        let qty = parseInt(qtyInput.value) || 0;
        let rate = parseFloat(rateInput.value) || 0;
        
        const isValid = productName && category && size && qty > 0 && rate > 0;
        
        if (isValid) {
            const amount = qty * rate;
            amtInput.value = amount.toFixed(2);
            itemRows[idx] = { 
                productName: productName, 
                category: category, 
                size: size, 
                quantity: qty, 
                rate: rate, 
                amount: amount 
            };
            rowDiv.style.borderLeft = '3px solid #10b981';
        } else {
            amtInput.value = '';
            itemRows[idx] = null;
            rowDiv.style.borderLeft = '3px solid #ef4444';
        }
        calcTotal();
    }

    // ============ COPY ROW ============
    function copyRow(idx) {
        const src = itemRows[idx];
        if (!src) { 
            alert('Please fill current row first'); 
            return; 
        }
        addNewRow(src);
    }

    // ============ REMOVE ROW ============
    function removeRow(idx) {
        const rowDiv = document.getElementById('row_' + idx);
        if (rowDiv) rowDiv.remove();
        itemRows[idx] = null;
        calcTotal();
    }

    // ============ CLEAR ALL ROWS ============
    function clearAllRows() {
        if (!confirm('⚠️ Remove all items?')) return;
        const container = document.getElementById('itemsList');
        container.innerHTML = '';
        itemRows = [];
        rowCount = 0;
        calcTotal();
        addNewRow();
    }

    // ============ CALCULATE TOTAL ============
    function calcTotal() {
        let sub = 0;
        for (let i of itemRows) {
            if (i) sub += i.amount;
        }
        
        let gst = parseInt(document.getElementById('gstSelect').value) || 0;
        let cgst = sub * (gst/2) / 100;
        let sgst = sub * (gst/2) / 100;
        let total = sub + cgst + sgst;
        
        let roundType = document.getElementById('roundOffSelect').value;
        let roundAmt = 0;
        if (roundType === 'up') {
            roundAmt = Math.ceil(total) - total;
            total = Math.ceil(total);
        } else if (roundType === 'down') {
            roundAmt = total - Math.floor(total);
            total = Math.floor(total);
        }
        
        document.getElementById('subtotal').innerText = sub.toFixed(2);
        document.getElementById('cgstAmount').innerText = cgst.toFixed(2);
        document.getElementById('sgstAmount').innerText = sgst.toFixed(2);
        document.getElementById('roundOffAmount').innerText = roundAmt.toFixed(2);
        document.getElementById('grandTotal').innerText = total.toFixed(2);
    }

    // ============ FORM SUBMIT ============
    document.getElementById('billForm').onsubmit = function(e) {
        let client = document.getElementById('clientSelect').value;
        if(!client) {
            e.preventDefault();
            alert('Please select a client');
            return false;
        }
        
        let validRows = [];
        for (let i = 0; i < rowCount; i++) {
            if (itemRows[i]) {
                validRows.push(itemRows[i]);
            }
        }
        
        if(validRows.length === 0) {
            e.preventDefault();
            alert('Please add at least one item with product, category, size, quantity and rate');
            return false;
        }
        
        const existingInput = document.querySelector('input[name="items"]');
        if (existingInput) existingInput.remove();
        
        let inp = document.createElement('input');
        inp.type = 'hidden';
        inp.name = 'items';
        inp.value = JSON.stringify(validRows);
        this.appendChild(inp);
        
        console.log('Submitting bill with items:', validRows);
        return true;
    };


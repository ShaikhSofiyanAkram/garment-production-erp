<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="fas fa-file-invoice text-primary"></i> Create New Bill</h2>
            <p class="text-muted">Create bill with size-wise rates from products</p>
        </div>
        <a href="/bills" class="btn btn-secondary">← Back to Bills</a>
    </div>

    <form method="POST" action="/bills/create" id="billForm">
        <!-- Tab Navigation -->
        <ul class="nav nav-tabs mb-4" id="billTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="manual-tab" data-bs-toggle="tab" data-bs-target="#manualBill" type="button">
                    <i class="fas fa-pen"></i> Manual Entry
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="auto-tab" data-bs-toggle="tab" data-bs-target="#autoBill" type="button">
                    <i class="fas fa-boxes"></i> Auto from Packing
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="advance-tab" data-bs-toggle="tab" data-bs-target="#advanceBill" type="button">
                    <i class="fas fa-hand-holding-usd"></i> Advance Payment
                </button>
            </li>
        </ul>

        <!-- Client Section -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5><i class="fas fa-user"></i> Bill Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-5">
                        <label class="form-label fw-bold">Client *</label>
                        <select name="client" id="clientSelect" class="form-control" required>
                            <option value="">-- Select Client --</option>
                            <% if(clients && clients.length) { %>
                                <% clients.forEach(c => { %>
                                    <option value="<%= c._id %>"><%= c.name %> (<%= c.phone %>)</option>
                                <% }) %>
                            <% } %>
                        </select>
                        <div id="clientAdvanceInfo" class="mt-1"></div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Bill Date</label>
                        <input type="date" name="billDate" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Due Date</label>
                        <input type="date" name="dueDate" class="form-control">
                    </div>
                </div>
                <div class="mt-2">
                    <a href="/clients" class="btn btn-sm btn-success" target="_blank">
                        <i class="fas fa-plus"></i> New Client
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="checkAdvance()">
                        <i class="fas fa-hand-holding-usd"></i> Check Advance
                    </button>
                </div>
            </div>
        </div>

        <!-- Tab Content -->
        <div class="tab-content">
            <!-- Manual Entry Tab -->
            <div class="tab-pane fade show active" id="manualBill" role="tabpanel">
                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5><i class="fas fa-list"></i> Items</h5>
                        <small>Select product → Size auto-loads → Rate auto-fetches</small>
                    </div>
                    <div class="card-body">
                        <div class="row g-2 mb-2 px-2 fw-bold text-dark">
                            <div class="col-md-3">Product Name</div>
                            <div class="col-md-2">Category</div>
                            <div class="col-md-2">Size</div>
                            <div class="col-md-1">Qty</div>
                            <div class="col-md-2">Rate (₹)</div>
                            <div class="col-md-1">Amount (₹)</div>
                            <div class="col-md-1">Actions</div>
                        </div>
                        <div id="itemsList"></div>
                        <button type="button" class="btn btn-primary mt-2" id="addItemBtn">
                            <i class="fas fa-plus"></i> Add Item
                        </button>
                        <button type="button" class="btn btn-info mt-2 ms-2" onclick="clearAllRows()">
                            <i class="fas fa-trash"></i> Clear All
                        </button>
                    </div>
                </div>
            </div>

            <!-- Auto from Packing Tab -->
           <!-- ============ AUTO FROM PACKING TAB (FIXED) ============ -->
            <div class="tab-pane fade" id="autoBill" role="tabpanel">
                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h5><i class="fas fa-boxes"></i> Auto from Packing</h5>
                        <small>Select packing records → Auto-add to bill with size-wise rates</small>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-7">
                                <label class="form-label fw-bold">Select Packing Records</label>
                                <select class="form-control" id="packingSelect" multiple style="height: 250px;">
                                    <option value="">Loading packing records...</option>
                                </select>
                                <small class="text-muted">Click to select individual records. Hold Ctrl for multiple selection.</small>
                            </div>
                            <div class="col-md-5">
                                <div class="card bg-light h-100">
                                    <div class="card-body text-center">
                                        <h5>Selected Records</h5>
                                        <h2 class="text-primary" id="packingSelectedCount">0</h2>
                                        <small class="text-muted">records selected</small>
                                        <hr>
                                        <div class="d-grid gap-2">
                                            <button type="button" class="btn btn-warning" onclick="addPackingToBill()">
                                                <i class="fas fa-plus-circle"></i> Add Selected to Bill
                                            </button>
                                            <button type="button" class="btn btn-info" onclick="selectAllPacking()">
                                                <i class="fas fa-check-double"></i> Select All
                                            </button>
                                            <button type="button" class="btn btn-secondary" onclick="deselectAllPacking()">
                                                <i class="fas fa-times"></i> Deselect All
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- ✅ Packing Items Preview (Like Manual Entry Table) -->
                        <div id="packingPreviewCard" class="card mt-3" style="display: none;">
                            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                                <span><i class="fas fa-list"></i> Packing Items (Ready to Add)</span>
                                <span class="badge bg-light text-dark" id="packingPreviewCount">0 items</span>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>#</th>
                                                <th>Packing #</th>
                                                <th>Product Name</th>
                                                <th>Category</th>
                                                <th>Size</th>
                                                <th class="text-end">Pieces</th>
                                                <th class="text-end">Rate (₹)</th>
                                                <th class="text-end">Amount (₹)</th>
                                                <th class="text-center">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody id="packingPreviewBody">
                                            <!-- Dynamic rows -->
                                        </tbody>
                                        <tfoot class="table-primary fw-bold">
                                            <tr>
                                                <td colspan="7" class="text-end">Total Pieces:</td>
                                                <td class="text-end" id="packingPreviewTotalPieces">0</td>
                                                <td></td>
                                            </tr>
                                            <tr class="table-success">
                                                <td colspan="7" class="text-end fs-6">Total Amount:</td>
                                                <td class="text-end fs-6" id="packingPreviewTotal">₹0.00</td>
                                                <td></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                            <div class="card-footer text-center">
                                <button type="button" class="btn btn-success btn-lg" onclick="confirmPackingToBill()">
                                    <i class="fas fa-check"></i> ✅ Add to Bill
                                </button>
                                <button type="button" class="btn btn-secondary btn-lg" onclick="clearPackingPreview()">
                                    <i class="fas fa-times"></i> Cancel
                                </button>
                                <span class="ms-3 text-muted small">
                                    <i class="fas fa-info-circle"></i> Items will be added to bill with auto-fetched rates
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Advance Payment Tab -->
            <div class="tab-pane fade" id="advanceBill" role="tabpanel">
                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-warning text-dark">
                        <h5><i class="fas fa-hand-holding-usd"></i> Advance Payment</h5>
                        <small>Record advance payment from client</small>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Select Client *</label>
                                    <select class="form-control" id="advanceClientSelect">
                                        <option value="">-- Select Client --</option>
                                        <% if(clients && clients.length) { %>
                                            <% clients.forEach(c => { %>
                                                <option value="<%= c._id %>"><%= c.name %> (<%= c.phone %>)</option>
                                            <% }) %>
                                        <% } %>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Advance Amount (₹) *</label>
                                    <input type="number" class="form-control" id="advanceAmount" min="1" placeholder="Enter amount">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Payment Method *</label>
                                    <select class="form-control" id="advanceMethod">
                                        <option value="cash">💵 Cash</option>
                                        <option value="bank_transfer">🏦 Bank Transfer</option>
                                        <option value="cheque">📝 Cheque</option>
                                        <option value="upi">📱 UPI</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Reference / UTR</label>
                                    <input type="text" class="form-control" id="advanceReference" placeholder="Cheque No / UTR">
                                </div>
                            </div>
                        </div>
                        <div class="text-center">
                            <button type="button" class="btn btn-warning btn-lg" onclick="recordAdvance()">
                                <i class="fas fa-save"></i> Record Advance
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tax Summary -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-info text-white">
                <h5><i class="fas fa-calculator"></i> Tax & Summary</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">GST</label>
                        <select name="gstPercent" id="gstSelect" class="form-control">
                            <option value="18">GST 18%</option>
                            <option value="12">GST 12%</option>
                            <option value="5">GST 5%</option>
                            <option value="0">Tax Free</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Round Off</label>
                        <select name="roundOff" id="roundOffSelect" class="form-control">
                            <option value="none">None</option>
                            <option value="up">Round Up</option>
                            <option value="down">Round Down</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Payment Terms</label>
                        <select name="paymentTerms" class="form-control">
                            <option value="weekly">Weekly</option>
                            <option value="monthly">Monthly</option>
                            <option value="custom">Custom</option>
                        </select>
                    </div>
                </div>
                <hr>
                <div class="row">
                    <div class="col-md-6 offset-md-6">
                        <table class="table table-bordered">
                            <tr><td class="fw-bold">Subtotal:</td><td class="text-end">₹<span id="subtotal">0.00</span></td></tr>
                            <tr><td class="fw-bold">CGST (9%):</td><td class="text-end">₹<span id="cgstAmount">0.00</span></td></tr>
                            <tr><td class="fw-bold">SGST (9%):</td><td class="text-end">₹<span id="sgstAmount">0.00</span></td></tr>
                            <tr><td class="fw-bold">Round Off:</td><td class="text-end">₹<span id="roundOffAmount">0.00</span></td></tr>
                            <tr class="table-primary"><td class="fw-bold fs-5">GRAND TOTAL:</td><td class="text-end fs-5 fw-bold">₹<span id="grandTotal">0.00</span></td></tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Remark -->
        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <label class="form-label fw-bold">Remark</label>
                <textarea name="remark" class="form-control" rows="2" placeholder="Optional notes..."></textarea>
            </div>
        </div>

        <!-- Submit -->
        <div class="text-center">
            <button type="submit" class="btn btn-success btn-lg px-5" id="submitBillBtn">
                <i class="fas fa-save"></i> Save Bill
            </button>
            <a href="/bills" class="btn btn-secondary btn-lg px-5">
                <i class="fas fa-times"></i> Cancel
            </a>
        </div>
    </form>
</div>

<script>
    // ============ GLOBALS ============
    let allProducts = [];
    let itemRows = [];
    let rowCount = 0;
    let packingItems = [];
    let selectedPackingItems = [];
    let usedPackingIds = new Set();

    // ============ LOAD PRODUCTS ============
    async function loadProductsForBill() {
        try {
            const res = await fetch('/products/api/list');
            if (res.ok) {
                const data = await res.json();
                if (Array.isArray(data) && data.length > 0) {
                    allProducts = data;
                    console.log('✅ Products loaded:', allProducts.length);
                    console.log('✅ Products:', allProducts.map(p => p.name + ' - ' + p.category));
                }
            }
        } catch(e) {
            console.error('Error loading products:', e);
        }
        addNewRow();
    }

    // ============ GET RATE FOR PRODUCT + SIZE ============
    // ============ GET RATE FOR PRODUCT + SIZE (FIXED) ============
// ============ GET RATE FOR PRODUCT + SIZE (CASE INSENSITIVE) ============
function getRateForProduct(productName, size, category) {
    if (!productName) return 0;
    
    // ✅ Case insensitive search
    const product = allProducts.find(p => 
        p.name.toLowerCase() === productName.toLowerCase() && 
        p.category === category
    );
    
    if (!product) {
        // ✅ Fallback: search by name only (case insensitive)
        const fallback = allProducts.find(p => 
            p.name.toLowerCase() === productName.toLowerCase()
        );
        if (fallback) {
            if (fallback.sizeRates && Array.isArray(fallback.sizeRates)) {
                const sizeRate = fallback.sizeRates.find(sr => sr.size === size);
                if (sizeRate) return sizeRate.clientRate || 0;
            }
            if (fallback.rates && fallback.rates.client) {
                return fallback.rates.client;
            }
        }
        return 0;
    }
    
    // ✅ Check sizeRates array
    if (product.sizeRates && Array.isArray(product.sizeRates)) {
        const sizeRate = product.sizeRates.find(sr => sr.size === size);
        if (sizeRate) return sizeRate.clientRate || 0;
    }
    
    // Fallback: if product has rates object
    if (product.rates && product.rates.client) {
        return product.rates.client;
    }
    
    return 0;
}

// ============ GET SIZES FOR PRODUCT (CASE INSENSITIVE) ============
function getSizesForProduct(productName, category) {
    if (!productName) return [];
    
    // ✅ Case insensitive search
    const product = allProducts.find(p => 
        p.name.toLowerCase() === productName.toLowerCase() && 
        p.category === category
    );
    
    if (!product) {
        // ✅ Fallback: search by name only
        const fallback = allProducts.find(p => 
            p.name.toLowerCase() === productName.toLowerCase()
        );
        if (fallback) {
            if (fallback.sizeRates && Array.isArray(fallback.sizeRates)) {
                return fallback.sizeRates.map(sr => sr.size);
            }
            if (fallback.sizes && Array.isArray(fallback.sizes)) {
                return fallback.sizes;
            }
        }
        return [];
    }
    
    if (product.sizeRates && Array.isArray(product.sizeRates)) {
        return product.sizeRates.map(sr => sr.size);
    }
    if (product.sizes && Array.isArray(product.sizes)) {
        return product.sizes;
    }
    return [];
}

// ============ GET CATEGORY FOR PRODUCT (CASE INSENSITIVE) ============
function getCategoryForProduct(productName) {
    if (!productName) return '';
    const product = allProducts.find(p => 
        p.name.toLowerCase() === productName.toLowerCase()
    );
    return product ? product.category : '';
}

    // ============ GET SIZES FOR PRODUCT ============
    // ============ GET SIZES FOR PRODUCT (FIXED) ============
function getSizesForProduct(productName, category) {
    // ✅ Find product by name AND category
    const product = allProducts.find(p => p.name === productName && p.category === category);
    if (!product) {
        // Fallback: find by name only
        const fallback = allProducts.find(p => p.name === productName);
        if (fallback) {
            if (fallback.sizeRates && Array.isArray(fallback.sizeRates)) {
                return fallback.sizeRates.map(sr => sr.size);
            }
            if (fallback.sizes && Array.isArray(fallback.sizes)) {
                return fallback.sizes;
            }
        }
        return [];
    }
    
    // ✅ From sizeRates
    if (product.sizeRates && Array.isArray(product.sizeRates)) {
        return product.sizeRates.map(sr => sr.size);
    }
    
    // ✅ From sizes array
    if (product.sizes && Array.isArray(product.sizes)) {
        return product.sizes;
    }
    
    return [];
}

    // ============ GET CATEGORY FOR PRODUCT ============
    function getCategoryForProduct(productName) {
        const product = allProducts.find(p => p.name === productName);
        return product ? product.category : '';
    }

    // ============ ADD NEW ROW (FIXED) ============
    function addNewRow(copyFrom = null) {
        const container = document.getElementById('itemsList');
        const idx = rowCount++;
        
        let prod = copyFrom ? copyFrom.productName : '';
        let cat = copyFrom ? copyFrom.category : '';
        let sz = copyFrom ? copyFrom.size : '';
        let qtyVal = copyFrom ? copyFrom.quantity : 1;
        let rateVal = copyFrom ? copyFrom.rate : 0;
        
        const rowDiv = document.createElement('div');
        rowDiv.className = 'row g-2 mb-2 p-2 border rounded bg-light';
        rowDiv.id = 'row_' + idx;
        rowDiv.style.borderLeft = '3px solid #4361ee';
        
        // ✅ BUILD PRODUCT OPTIONS WITH CATEGORY GROUPING
        let prodOptions = '<option value="">-- Select Product --</option>';
        
        // ✅ Group by category
        const kidsProducts = allProducts.filter(p => p.category === 'Kids');
        const mensProducts = allProducts.filter(p => p.category === 'Mens');
        const otherProducts = allProducts.filter(p => p.category === 'Other');
        
        // ✅ Kids Products
        if (kidsProducts.length > 0) {
            prodOptions += '<optgroup label="👶 Kids Wear">';
            kidsProducts.forEach(p => {
                let selected = (prod === p.name && cat === 'Kids') ? 'selected' : '';
                prodOptions += `<option value="${p.name}|Kids" data-category="Kids" ${selected}>${p.name}</option>`;
            });
            prodOptions += '</optgroup>';
        }
        
        // ✅ Mens Products
        if (mensProducts.length > 0) {
            prodOptions += '<optgroup label="👔 Mens Wear">';
            mensProducts.forEach(p => {
                let selected = (prod === p.name && cat === 'Mens') ? 'selected' : '';
                prodOptions += `<option value="${p.name}|Mens" data-category="Mens" ${selected}>${p.name}</option>`;
            });
            prodOptions += '</optgroup>';
        }
        
        // ✅ Other Products
        if (otherProducts.length > 0) {
            prodOptions += '<optgroup label="📦 Other">';
            otherProducts.forEach(p => {
                let selected = (prod === p.name && cat === p.category) ? 'selected' : '';
                const displayName = p.customCategory ? `${p.name} (${p.customCategory})` : p.name;
                prodOptions += `<option value="${p.name}|${p.category}" data-category="${p.category}" ${selected}>${displayName}</option>`;
            });
            prodOptions += '</optgroup>';
        }
        
        prodOptions += '<option value="other">➕ Add New Product (Manual)</option>';
        
        rowDiv.innerHTML = `
            <div class="col-md-3">
                <select class="form-control prodSel" data-idx="${idx}" onchange="onProductChange(${idx})">
                    ${prodOptions}
                </select>
                <input type="text" class="form-control mt-1 manualProd" id="manualProd_${idx}" style="display:none;" placeholder="Enter product name" onchange="onManualProductChange(${idx})">
            </div>
            <div class="col-md-2">
                <select class="form-control catSel" id="catSel_${idx}" onchange="onCategoryChange(${idx})">
                    <option value="">Select</option>
                    <option value="Kids" ${cat === 'Kids' ? 'selected' : ''}>Kids</option>
                    <option value="Mens" ${cat === 'Mens' ? 'selected' : ''}>Mens</option>
                    <option value="Other">Other</option>
                </select>
                <input type="text" class="form-control mt-1 manualCat" id="manualCat_${idx}" style="display:none;" placeholder="Enter category" onchange="updateItem(${idx})">
            </div>
            <div class="col-md-2">
                <select class="form-control sizeSel" id="sizeSel_${idx}" onchange="onSizeChange(${idx})">
                    <option value="">Select Size</option>
                </select>
                <input type="text" class="form-control mt-1 manualSize" id="manualSize_${idx}" style="display:none;" placeholder="Enter size" onchange="updateItem(${idx})">
                <small class="text-muted" id="sizeHint_${idx}"></small>
            </div>
            <div class="col-md-1">
                <input type="number" class="form-control qtyInp" id="qty_${idx}" value="${qtyVal}" min="1" onchange="updateItem(${idx})" onkeyup="updateItem(${idx})">
            </div>
            <div class="col-md-2">
                <input type="number" class="form-control rateInp" id="rate_${idx}" value="${rateVal}" step="0.01" onchange="updateItem(${idx})" onkeyup="updateItem(${idx})">
                <small class="text-muted" id="rateSource_${idx}"></small>
            </div>
            <div class="col-md-1">
                <input type="text" class="form-control amtInp" id="amt_${idx}" readonly style="background:#e9ecef; font-weight:bold;">
            </div>
            <div class="col-md-1">
                <button type="button" class="btn btn-sm btn-info" onclick="copyRow(${idx})" title="Copy Row">
                    <i class="fas fa-copy"></i>
                </button>
                <button type="button" class="btn btn-sm btn-danger" onclick="removeRow(${idx})" title="Remove Row">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
        `;
        
        container.appendChild(rowDiv);
        
        if (copyFrom) {
            setTimeout(() => {
                const prodSelect = rowDiv.querySelector('.prodSel');
                if (prodSelect) {
                    // Find the option with matching product name
                    const options = prodSelect.options;
                    for (let i = 0; i < options.length; i++) {
                        if (options[i].value.startsWith(prod + '|')) {
                            prodSelect.value = options[i].value;
                            break;
                        }
                    }
                    // Trigger change event
                    const event = new Event('change');
                    prodSelect.dispatchEvent(event);
                }
                setTimeout(() => {
                    const sizeSelect = rowDiv.querySelector('.sizeSel');
                    if (sizeSelect && sz) {
                        // Find the option with matching size
                        const options = sizeSelect.options;
                        for (let i = 0; i < options.length; i++) {
                            if (options[i].value === sz) {
                                sizeSelect.value = sz;
                                break;
                            }
                        }
                        const sizeEvent = new Event('change');
                        sizeSelect.dispatchEvent(sizeEvent);
                    }
                    const qtyInput = rowDiv.querySelector('.qtyInp');
                    if (qtyInput) qtyInput.value = qtyVal;
                    updateItem(idx);
                }, 150);
            }, 50);
        }
        updateItem(idx);
    }


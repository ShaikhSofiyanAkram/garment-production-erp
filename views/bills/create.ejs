            });
            prodOptions += '</optgroup>';
        }
        if (mensProducts.length > 0) {
            prodOptions += '<optgroup label="👔 Mens Wear">';
            mensProducts.forEach(p => {
                const selected = item.productName === p.name ? 'selected' : '';
                prodOptions += `<option value="${p.name}|Mens" data-category="Mens" ${selected}>${p.name}</option>`;
            });
            prodOptions += '</optgroup>';
        }
        if (otherProducts.length > 0) {
            prodOptions += '<optgroup label="📦 Other">';
            otherProducts.forEach(p => {
                const selected = item.productName === p.name ? 'selected' : '';
                prodOptions += `<option value="${p.name}|${p.category}" data-category="${p.category}" ${selected}>${p.name}</option>`;
            });
            prodOptions += '</optgroup>';
        }
        prodOptions += '<option value="other">+ Manual</option>';
        
        rowDiv.innerHTML = `
            <div class="col-md-3">

                    ${prodOptions}
                </select>
                <input type="text" class="form-control mt-1 manualProd" id="manualProd_${idx}" style="display:none;" placeholder="Enter product name" onchange="onManualProductChange(${idx})">
            </div>
            <div class="col-md-2">
                <select class="form-control catSel" id="catSel_${idx}" onchange="onCategoryChange(${idx})">
                    <option value="">Select</option>
                    <option value="Kids" ${item.category === 'Kids' ? 'selected' : ''}>Kids</option>
                    <option value="Mens" ${item.category === 'Mens' ? 'selected' : ''}>Mens</option>
                    <option value="Other">Other</option>
                </select>
                <input type="text" class="form-control mt-1 manualCat" id="manualCat_${idx}" style="display:none;" placeholder="Enter category" onchange="updateItem(${idx})">
            </div>
            <div class="col-md-2">
                <select class="form-control sizeSel" id="sizeSel_${idx}" onchange="onSizeChange(${idx})">
                    <option value="">Select Size</option>
                </select>
                <input type="text" class="form-control mt-1 manualSize" id="manualSize_${idx}" style="display:none;" placeholder="Enter size" onchange="updateItem(${idx})">
                <small class="text-muted" id="sizeHint_${idx}"></small>
            </div>
            <div class="col-md-1">
                <input type="number" class="form-control qtyInp" id="qty_${idx}" value="${item.pieces}" min="1" onchange="updateItem(${idx})" onkeyup="updateItem(${idx})">
            </div>
            <div class="col-md-2">
                <input type="number" class="form-control rateInp" id="rate_${idx}" value="${item.rate}" step="0.01" onchange="updateItem(${idx})" onkeyup="updateItem(${idx})">
                <small class="text-muted" id="rateSource_${idx}">✅ Auto from Packing</small>
            </div>
            <div class="col-md-1">
                <input type="text" class="form-control amtInp" id="amt_${idx}" readonly style="background:#e9ecef; font-weight:bold;" value="${item.amount.toFixed(2)}">
            </div>
            <div class="col-md-1">
                <button type="button" class="btn btn-sm btn-info" onclick="copyRow(${idx})" title="Copy Row">
                    <i class="fas fa-copy"></i>
                </button>
                <button type="button" class="btn btn-sm btn-danger" onclick="removeRow(${idx})" title="Remove Row">
                    <i class="fas fa-trash"></i>
                </button>
                <span class="badge bg-info ms-1 d-flex align-items-center mt-1">📦 Packing</span>
            </div>
        `;
        container.appendChild(rowDiv);
        
        // ✅ Load sizes and set value
        loadSizesForRow(idx, item.productName, item.category);
        setTimeout(() => {
            const sizeSelect = rowDiv.querySelector('.sizeSel');
            if (sizeSelect) {
                const options = sizeSelect.options;
                for (let i = 0; i < options.length; i++) {
                    if (options[i].value === item.size) {
                        sizeSelect.value = item.size;
                        break;
                    }
                }
                const event = new Event('change');
                sizeSelect.dispatchEvent(event);
            }
            updateItem(idx);
        }, 100);
        
        existingKeys.add(key);
        addedCount++;
        itemRows[idx] = { 
            productName: item.productName,
            category: item.category,
            size: item.size,
            quantity: item.pieces,
            rate: item.rate,
            amount: item.amount
        };
    });
    
    // ✅ Clear packing preview
    selectedPackingItems = [];
    renderPackingPreview();
    calcTotal();
    
    if (addedCount > 0) {
        showToast(`✅ ${addedCount} packing items added to bill!`, 'success');
        if (duplicateCount > 0) {
            showToast(`⚠️ ${duplicateCount} items already existed, quantities updated`, 'warning');
        }
    } else {
        showToast(`⚠️ No new items added. ${duplicateCount} duplicates found.`, 'warning');
    }
}

// ✅ Update packing select change listener
document.getElementById('packingSelect').addEventListener('change', updatePackingCount);















    // ============ ADVANCE PAYMENT ============
    async function recordAdvance() {
        const client = document.getElementById('advanceClientSelect').value;
        const amount = document.getElementById('advanceAmount').value;
        const method = document.getElementById('advanceMethod').value;
        const reference = document.getElementById('advanceReference').value;
        
        if (!client || !amount || amount <= 0) {
            alert('Please select client and enter valid amount');
            return;
        }
        
        try {
            const res = await fetch('/advance/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    client: client,
                    amount: parseFloat(amount),
                    paymentMethod: method,
                    reference: reference,
                    paymentDate: new Date().toISOString().split('T')[0]
                })
            });
            
            if (res.ok) {
                showToast(`✅ Advance of ₹${parseFloat(amount).toLocaleString()} recorded`, 'success');
                document.getElementById('advanceAmount').value = '';
                document.getElementById('advanceReference').value = '';
                document.getElementById('clientSelect').value = client;
                const event = new Event('change');
                document.getElementById('clientSelect').dispatchEvent(event);
            } else {
                const data = await res.json();
                alert('Error: ' + (data.error || 'Failed to record advance'));
            }
        } catch(e) {
            console.error('Error:', e);
            alert('Error recording advance');
        }
    }

    // ============ TOAST NOTIFICATIONS ============
    function showToast(message, type) {
        const toast = document.createElement('div');
        toast.className = `alert alert-${type} alert-dismissible fade show position-fixed top-0 end-0 m-3`;
        toast.style.zIndex = '9999';
        toast.style.minWidth = '300px';
        toast.innerHTML = `${message} <button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 4000);
    }

    // ============ EVENT LISTENERS ============
    document.getElementById('addItemBtn').onclick = function() { addNewRow(); };
    document.getElementById('gstSelect').onchange = function() { calcTotal(); };
    document.getElementById('roundOffSelect').onchange = function() { calcTotal(); };
    document.getElementById('packingSelect').addEventListener('change', updatePackingCount);

    // ============ INITIALIZE ============
    document.addEventListener('DOMContentLoaded', function() {
        loadProductsForBill();
        loadPackingRecords();
        updatePackingCount();
    });
</script>


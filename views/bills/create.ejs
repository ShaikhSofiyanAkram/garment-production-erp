async function loadPackingRecords() {
    try {
        const res = await fetch('/packing/api/list');
        const data = await res.json();
        const select = document.getElementById('packingSelect');
        select.innerHTML = '';
        
        // ✅ Load products first if not loaded
        if (allProducts.length === 0) {
            await loadProductsForBill();
        }
        
        console.log('📦 All products loaded:', allProducts.length);
        console.log('📦 Product names:', allProducts.map(p => p.name));
        
        if (Array.isArray(data) && data.length > 0) {
            let hasItems = false;
            data.forEach(p => {
                if (p.entries && p.entries.length > 0) {
                    p.entries.forEach((e, index) => {
                        const uniqueId = `${p._id}_${index}`;
                        if (usedPackingIds.has(uniqueId)) return;
                        
                        // ✅ Check if product exists in database
                        const productExists = allProducts.some(prod => 
                            prod.name.toLowerCase() === e.productName.toLowerCase()
                        );
                        
                        const option = document.createElement('option');
                        option.value = uniqueId;
                        option.dataset.packingId = p._id;
                        option.dataset.productName = e.productName;
                        option.dataset.category = e.category || 'Mens';
                        option.dataset.size = e.size || 'N/A';
                        option.dataset.pieces = e.packedPieces || 0;
                        option.dataset.packingNumber = p.packingNumber;
                        option.dataset.productExists = productExists;
                        option.textContent = `${p.packingNumber} - ${e.productName} (${e.size}) - ${e.packedPieces} pcs ${!productExists ? '⚠️ No rate' : ''}`;
                        select.appendChild(option);
                        hasItems = true;
                    });
                }
            });
            
            if (!hasItems) {
                select.innerHTML = '<option value="">✅ All packing records have been used</option>';
            }
        } else {
            select.innerHTML = '<option value="">No packing records available</option>';
        }
    } catch(e) {
        console.error('Error loading packing records:', e);
        document.getElementById('packingSelect').innerHTML = '<option value="">Error loading records</option>';
    }
}

function selectAllPacking() {
    const select = document.getElementById('packingSelect');
    const options = select.options;
    
    if (options.length === 0 || options[0].value === '') {
        showToast('No packing records to select', 'warning');
        return;
    }
    
    for (let i = 0; i < options.length; i++) {
        options[i].selected = true;
    }
    updatePackingCount();
    showToast('✅ All records selected', 'info');
}

function deselectAllPacking() {
    const select = document.getElementById('packingSelect');
    for (let i = 0; i < select.options.length; i++) {
        select.options[i].selected = false;
    }
    updatePackingCount();
    document.getElementById('packingPreviewCard').style.display = 'none';
    showToast('❌ All records deselected', 'info');
}

function updatePackingCount() {
    const select = document.getElementById('packingSelect');
    const selected = Array.from(select.selectedOptions);
    document.getElementById('packingSelectedCount').innerText = selected.length;
}

function addPackingToBill() {
    const select = document.getElementById('packingSelect');
    const selected = Array.from(select.selectedOptions);
    
    if (selected.length === 0) {
        showToast('⚠️ Please select at least one packing record', 'warning');
        return;
    }
    
    let addedCount = 0;
    let skipCount = 0;
    
    selected.forEach(opt => {
        // ✅ Check if already in preview
        const exists = selectedPackingItems.some(item => 
            item.uniqueId === opt.value
        );
        
        if (exists) {
            skipCount++;
            return;
        }
        
        let productName = opt.dataset.productName || 'Unknown';
        const category = opt.dataset.category || 'Mens';
        const size = opt.dataset.size || 'N/A';
        const pieces = parseInt(opt.dataset.pieces) || 0;
        const packingNumber = opt.dataset.packingNumber || 'PAC-NA';
        const uniqueId = opt.value;
        
        // ✅ Debug log
        console.log(`🔍 Looking for rate: Product="${productName}", Size="${size}", Category="${category}"`);
        
        // ✅ Get rate from product (case insensitive)
        const rate = getRateForProduct(productName, size, category);
        const amount = pieces * rate;
        
        console.log(`💰 Rate found: ${rate}, Amount: ${amount}`);
        
        // ✅ Find actual product name from database for display
        const product = allProducts.find(p => 
            p.name.toLowerCase() === productName.toLowerCase()
        );
        if (product) {
            productName = product.name; // Use correct case
        }
        
        selectedPackingItems.push({
            uniqueId: uniqueId,
            productName: productName,
            category: category,
            size: size,
            pieces: pieces,
            rate: rate,
            amount: amount,
            packingNumber: packingNumber
        });
        
        addedCount++;
    });
    
    if (addedCount === 0 && skipCount > 0) {
        showToast(`⚠️ ${skipCount} records already in list (duplicates skipped)`, 'warning');
    } else if (addedCount > 0) {
        showToast(`✅ ${addedCount} records added to packing list`, 'success');
        if (skipCount > 0) {
            showToast(`⚠️ ${skipCount} duplicates skipped`, 'warning');
        }
    }
    
    // ✅ Remove selected options from dropdown
    selected.forEach(opt => {
        opt.remove();
    });
    
    updatePackingCount();
    renderPackingPreview();
}

function renderPackingPreview() {
    const card = document.getElementById('packingPreviewCard');
    const body = document.getElementById('packingPreviewBody');
    const totalPiecesElem = document.getElementById('packingPreviewTotalPieces');
    const totalAmountElem = document.getElementById('packingPreviewTotal');
    const countElem = document.getElementById('packingPreviewCount');
    
    if (selectedPackingItems.length === 0) {
        card.style.display = 'none';
        return;
    }
    
    card.style.display = 'block';
    countElem.innerText = `${selectedPackingItems.length} items`;
    
    let totalPieces = 0;
    let totalAmount = 0;
    
    body.innerHTML = selectedPackingItems.map((item, index) => {
        totalPieces += item.pieces;
        totalAmount += item.amount;
        
        // ✅ Show rate status
        const rateStatus = item.rate > 0 ? 
            `<span class="text-success">✅ ₹${item.rate.toFixed(2)}</span>` : 
            `<span class="text-danger">⚠️ No rate</span>`;
        
        return `
            <tr>
                <td>${index + 1}</td>
                <td><span class="badge bg-info">${item.packingNumber}</span></td>
                <td><strong>${item.productName}</strong></td>
                <td><span class="badge bg-secondary">${item.category}</span></td>
                <td><span class="badge bg-primary">${item.size}</span></td>
                <td class="text-end fw-bold">${item.pieces}</td>
                <td class="text-end">${rateStatus}</td>
                <td class="text-end fw-bold ${item.amount > 0 ? 'text-success' : 'text-danger'}">${item.amount > 0 ? '₹' + item.amount.toFixed(2) : '₹0.00'}</td>
                <td class="text-center">
                    <button class="btn btn-sm btn-danger" onclick="removeFromPackingPreview(${index})" title="Remove from list">
                        <i class="fas fa-times"></i>
                    </button>
                </td>
            </tr>
        `;
    }).join('');
    
    totalPiecesElem.innerText = totalPieces;
    totalAmountElem.innerText = totalAmount > 0 ? '₹' + totalAmount.toFixed(2) : '₹0.00';
}

function removeFromPackingPreview(index) {
    const removed = selectedPackingItems[index];
    
    // ✅ Add back to dropdown
    const select = document.getElementById('packingSelect');
    const option = document.createElement('option');
    option.value = removed.uniqueId;
    option.dataset.packingId = removed.uniqueId.split('_')[0];
    option.dataset.productName = removed.productName;
    option.dataset.category = removed.category;
    option.dataset.size = removed.size;
    option.dataset.pieces = removed.pieces;
    option.dataset.packingNumber = removed.packingNumber;
    option.textContent = `${removed.packingNumber} - ${removed.productName} (${removed.size}) - ${removed.pieces} pcs`;
    select.appendChild(option);
    
    // ✅ Remove from selected items
    selectedPackingItems.splice(index, 1);
    renderPackingPreview();
    updatePackingCount();
    showToast('🗑️ Item removed from list', 'info');
}

function clearPackingPreview() {
    if (selectedPackingItems.length === 0) return;
    if (!confirm('⚠️ Clear all items from packing list?')) return;
    
    // ✅ Add all items back to dropdown
    const select = document.getElementById('packingSelect');
    selectedPackingItems.forEach(item => {
        const option = document.createElement('option');
        option.value = item.uniqueId;
        option.dataset.packingId = item.uniqueId.split('_')[0];
        option.dataset.productName = item.productName;
        option.dataset.category = item.category;
        option.dataset.size = item.size;
        option.dataset.pieces = item.pieces;
        option.dataset.packingNumber = item.packingNumber;
        option.textContent = `${item.packingNumber} - ${item.productName} (${item.size}) - ${item.pieces} pcs`;
        select.appendChild(option);
    });
    
    selectedPackingItems = [];
    renderPackingPreview();
    updatePackingCount();
    showToast('🗑️ All items cleared', 'info');
}

function confirmPackingToBill() {
    if (selectedPackingItems.length === 0) {
        showToast('⚠️ No items to add to bill', 'warning');
        return;
    }
    
    let addedCount = 0;
    let duplicateCount = 0;
    const existingKeys = new Set();
    
    // ✅ Check existing manual entries
    itemRows.forEach(row => {
        if (row) {
            existingKeys.add(`${row.productName}|${row.category}|${row.size}`);
        }
    });
    
    selectedPackingItems.forEach(item => {
        const key = `${item.productName}|${item.category}|${item.size}`;
        
        // ✅ Check if already exists in manual entries
        if (existingKeys.has(key)) {
            // Update existing row
            const existingIndex = itemRows.findIndex(row => 
                row && row.productName === item.productName && 
                row.category === item.category && 
                row.size === item.size
            );
            if (existingIndex !== -1) {
                itemRows[existingIndex].quantity += item.pieces;
                itemRows[existingIndex].amount = itemRows[existingIndex].quantity * itemRows[existingIndex].rate;
                // Update UI
                const rowDiv = document.getElementById('row_' + existingIndex);
                if (rowDiv) {
                    const qtyInput = rowDiv.querySelector('.qtyInp');
                    if (qtyInput) qtyInput.value = itemRows[existingIndex].quantity;
                    const amtInput = rowDiv.querySelector('.amtInp');
                    if (amtInput) amtInput.value = itemRows[existingIndex].amount.toFixed(2);
                }

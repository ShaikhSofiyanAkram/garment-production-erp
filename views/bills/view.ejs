<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0">Bill Details: <%= bill.billNumber %></h4>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <strong>Client:</strong> <%= bill.client?.name || 'N/A' %><br>
                        <strong>Bill Date:</strong> <%= new Date(bill.billDate).toLocaleDateString() %><br>
                        <strong>Due Date:</strong> <%= bill.dueDate ? new Date(bill.dueDate).toLocaleDateString() : 'N/A' %>
                    </div>
                    <div class="col-md-6 text-end">
                        <strong>Status:</strong> 
                        <% if (bill.status === 'paid') { %>
                            <span class="badge bg-success">✅ Paid</span>
                        <% } else if (bill.status === 'partial') { %>
                            <span class="badge bg-warning">⏳ Partial</span>
                        <% } else { %>
                            <span class="badge bg-danger">⏰ Pending</span>
                        <% } %><br>
                        <strong>Total Amount:</strong> ₹<%= bill.totalAmount.toLocaleString() %><br>
                        <strong>Paid Amount:</strong> ₹<%= bill.paidAmount.toLocaleString() %><br>
                        <strong>Pending Amount:</strong> ₹<%= bill.pendingAmount.toLocaleString() %>
                    </div>
                </div>
                
                <h5>Items</h5>
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Size</th>
                                <th>Quantity</th>
                                <th>Rate (₹)</th>
                                <th>Amount (₹)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (bill.items && bill.items.length > 0) { %>
                                <% bill.items.forEach(item => { %>
                                <tr>
                                    <td><%= item.productName || 'N/A' %></td>
                                    <td><%= item.category || 'N/A' %></td>
                                    <td><%= item.size || 'N/A' %></td>
                                    <td><%= item.quantity || 0 %></td>
                                    <td>₹<%= item.rate || 0 %></td>
                                    <td>₹<%= (item.amount || 0).toLocaleString() %></td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="6" class="text-center">No items found</td></tr>
                            <% } %>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="5" class="text-end">Total:</th>
                                <th>₹<%= bill.totalAmount.toLocaleString() %></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                
                <!-- ✅ FIX: Check if payments exists and has length -->
                <% if (typeof payments !== 'undefined' && payments && payments.length > 0) { %>
                <h5>Payment History</h5>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Method</th>
                                <th>Reference</th>
                                <th>Advance Used</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% payments.forEach(payment => { %>
                            <tr>
                                <td><%= new Date(payment.paymentDate).toLocaleDateString() %></td>
                                <td>₹<%= (payment.amount || 0).toLocaleString() %></td>
                                <td><%= payment.paymentMethod || 'N/A' %></td>
                                <td><%= payment.reference || '-' %></td>
                                <td>₹<%= (payment.advanceAmount || 0).toLocaleString() %></td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } %>
                
                <% if (bill.remark) { %>
                <div class="alert alert-secondary">
                    <strong>Remark:</strong> <%= bill.remark %>
                </div>
                <% } %>
                
                <div class="text-center mt-4 no-print">
                    <a href="/bills/print/<%= bill._id %>" class="btn btn-secondary" target="_blank">
                        <i class="fas fa-print"></i> Print Bill
                    </a>
                    <a href="/bills/pending-summary" class="btn btn-warning">
                        <i class="fas fa-arrow-left"></i> Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
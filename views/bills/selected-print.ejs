<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Selected Bills Summary</title>
    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            padding: 20px;
            font-size: 12px;
        }
        .header {
            text-align: center;
            border-bottom: 2px solid #1a5f7a;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        .company-name {
            font-size: 22px;
            font-weight: bold;
            color: #1a5f7a;
        }
        .summary-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }
        .summary-table th, .summary-table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        .summary-table th {
            background-color: #1a5f7a;
            color: white;
        }
        .total-row {
            background-color: #f2f2f2;
            font-weight: bold;
        }
        .grand-total {
            background-color: #ffc107;
            font-size: 14px;
        }
        .footer {
            margin-top: 30px;
            text-align: center;
            font-size: 10px;
            color: #888;
            border-top: 1px solid #ddd;
            padding-top: 10px;
        }
        @media print {
            body { margin: 0; padding: 15px; }
            .no-print { display: none; }
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="company-name">🏭 GARMENT FACTORY ERP</div>
        <div>123 Fashion Street, Garment District</div>
        <div>GST: 07AAACA1234A1Z | Phone: +91 98765 43210</div>
        <h3>Pending Bills Summary Report</h3>
        <p>Generated on: <%= new Date().toLocaleString() %></p>
    </div>

    <table class="summary-table">
        <thead>
            <tr>
                <th>S.No</th>
                <th>Bill #</th>
                <th>Date</th>
                <th>Client</th>
                <th>Items</th>
                <th>Total (₹)</th>
                <th>Paid (₹)</th>
                <th>Pending (₹)</th>
            </tr>
        </thead>
        <tbody>
            <% bills.forEach((bill, index) => { %>
            <tr>
                <td><%= index + 1 %></td>
                <td><%= bill.billNumber %></td>
                <td><%= new Date(bill.billDate).toLocaleDateString() %></td>
                <td><%= bill.client?.name %></td>
                <td><%= bill.items.length %> items</td>
                <td class="text-end">₹<%= bill.totalAmount.toLocaleString() %></td>
                <td class="text-end">₹<%= bill.paidAmount.toLocaleString() %></td>
                <td class="text-end fw-bold">₹<%= bill.pendingAmount.toLocaleString() %></td>
            </tr>
            <% }) %>
            <tr class="total-row">
                <td colspan="5" class="text-end fw-bold">Total:</td>
                <td class="text-end fw-bold">₹<%= totalAmount.toLocaleString() %></td>
                <td class="text-end fw-bold">₹<%= totalPaid.toLocaleString() %></td>
                <td class="text-end fw-bold">₹<%= totalPending.toLocaleString() %></td>
            </tr>
        </tbody>
    </table>

    <div class="footer">
        <p>This is a computer generated summary of selected pending bills.</p>
        <p>For detailed invoice, please print individual bills.</p>
        <p>Thank you for your business!</p>
    </div>

    <div class="no-print" style="text-align: center; margin-top: 20px;">
        <button onclick="window.print()">Print</button>
        <button onclick="window.close()">Close</button>
    </div>

    <script>
        setTimeout(() => window.print(), 500);
    </script>
</body>
</html>
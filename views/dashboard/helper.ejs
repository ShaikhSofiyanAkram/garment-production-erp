<%
currentPage = 'dashboard';
%>

<%- include('../layouts/worker-layout') %>

<div class="container-fluid">
    <!-- Welcome Section -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card bg-gradient-success text-white" style="background: linear-gradient(135deg, #059669, #10b981);">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h2 class="mb-2">Welcome back, <%= user ? user.username : 'Helper' %>!</h2>
                            <p class="mb-0">Manage finishing work, track received and rejected pieces</p>
                        </div>
                        <div class="col-md-4 text-end">
                            <i class="fas fa-hand-sparkles fa-4x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-value" id="totalEntries">0</div>
            <div class="stat-label">Total Finishing Entries</div>
            <i class="fas fa-list fa-2x text-info mt-2 d-block"></i>
        </div>
        <div class="stat-card">
            <div class="stat-value" id="totalReceived">0</div>
            <div class="stat-label">Total Received</div>
            <i class="fas fa-inbox fa-2x text-success mt-2 d-block"></i>
        </div>
        <div class="stat-card">
            <div class="stat-value" id="totalRejected">0</div>
            <div class="stat-label">Total Rejected</div>
            <i class="fas fa-times-circle fa-2x text-danger mt-2 d-block"></i>
        </div>
        <div class="stat-card">
            <div class="stat-value" id="totalPassed">0</div>
            <div class="stat-label">Total Passed</div>
            <i class="fas fa-check-circle fa-2x text-success mt-2 d-block"></i>
        </div>
    </div>

    <!-- Monthly Earnings Card -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <i class="fas fa-money-bill-wave text-success"></i> Monthly Earnings
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <small class="text-muted">Monthly Salary</small>
                            <h3 class="text-primary" id="monthlySalary">₹0</h3>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted">This Month</small>
                            <h3 class="text-success" id="thisMonthEarnings">₹0</h3>
                        </div>
                    </div>
                    <div class="progress mt-3" style="height: 10px;">
                        <div class="progress-bar bg-success" id="salaryProgress" style="width: 0%"></div>
                    </div>
                    <small class="text-muted mt-2 d-block" id="attendanceInfo">Attendance: 0/0 days</small>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <i class="fas fa-chart-line text-info"></i> Quality Performance
                </div>
                <div class="card-body text-center">
                    <canvas id="qualityChart" width="200" height="150"></canvas>
                    <div class="mt-2">
                        <span class="badge bg-success">Passed: <span id="passPercent">0</span>%</span>
                        <span class="badge bg-danger">Rejected: <span id="rejectPercent">0</span>%</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- New Finishing Entry Form -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-plus-circle"></i> New Finishing Entry
        </div>
        <div class="card-body">
            <form id="finishingEntryForm">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Select Production Return *</label>
                        <select class="form-control" id="productionReturnSelect" required>
                            <option value="">-- Select Production Return --</option>
                        </select>
                        <small class="text-muted">Only completed production returns will appear here</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Remark (Optional)</label>
                        <textarea class="form-control" id="finishRemark" rows="3" placeholder="Any quality issues or notes?"></textarea>
                    </div>
                </div>
                
                <!-- Return Details Card -->
                <div id="returnDetailsCard" class="card mb-3" style="display: none;">
                    <div class="card-header bg-info text-white">
                        <i class="fas fa-info-circle"></i> Production Return Details
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <strong>Assignment ID:</strong> <span id="detailAssignmentId">-</span>
                            </div>
                            <div class="col-md-4">
                                <strong>Product:</strong> <span id="detailProduct">-</span>
                            </div>
                            <div class="col-md-4">
                                <strong>Karigar:</strong> <span id="detailKarigar">-</span>
                            </div>
                        </div>
                        <hr>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                                <thead class="table-light">
                                    <tr><th>Size</th><th>Given</th><th>Returned</th><th>Damage</th><th>Missing</th><th>Available</th><th>Status</th></tr>
                                </thead>
                                <tbody id="returnItemsTable"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
                
                <!-- Finishing Entry Fields -->
                <div id="finishingFields" style="display: none;">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Received Pieces *</label>
                            <input type="number" class="form-control" id="receivedPieces" min="0" required>
                            <small class="text-muted" id="maxReceivedHint">Max: 0 pieces</small>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Rejected Pieces</label>
                            <input type="number" class="form-control" id="rejectedPieces" min="0" value="0">
                            <small class="text-muted">Defective pieces that cannot be used</small>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Passed Pieces (Auto)</label>
                            <input type="text" class="form-control" id="passedPieces" readonly style="background:#e9ecef; font-weight:bold;">
                            <small class="text-success">Passed = Received - Rejected</small>
                        </div>
                    </div>
                    <div class="alert alert-warning" id="validationWarning" style="display: none;">
                        <i class="fas fa-exclamation-triangle"></i> Cannot receive more than available pieces!
                    </div>
                    <button type="submit" class="btn btn-success w-100">
                        <i class="fas fa-save"></i> Save Finishing Entry
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Recent Finishing History -->
    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span><i class="fas fa-history"></i> My Finishing History</span>
            <div>
                <input type="date" id="historyFilterDate" class="form-control form-control-sm d-inline-block w-auto me-2">
                <button class="btn btn-sm btn-outline-primary" onclick="loadFinishingHistory()">
                    <i class="fas fa-search"></i> Filter
                </button>
                <button class="btn btn-sm btn-outline-secondary" onclick="resetFilter()">
                    <i class="fas fa-sync-alt"></i> Reset
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Finishing #</th>
                            <th>Assignment ID</th>
                            <th>Product</th>
                            <th>Received</th>
                            <th>Rejected</th>
                            <th>Passed</th>
                            <th>Status</th>
                            <th>Remark</th>
                        </tr>
                    </thead>
                    <tbody id="finishingHistoryBody">
                        <tr><td colspan="9" class="text-center">Loading...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
let qualityChart = null;
let currentAvailablePieces = 0;

// Load helper dashboard data
async function loadHelperDashboard() {
    try {
        const response = await fetch('/dashboard/api/worker-stats');
        const data = await response.json();
        
        if (data.success) {
            const stats = data.stats;
            document.getElementById('totalEntries').innerText = stats.totalEntries || 0;
            document.getElementById('totalReceived').innerText = stats.totalReceived || 0;
            document.getElementById('totalRejected').innerText = stats.totalRejected || 0;
            document.getElementById('totalPassed').innerText = stats.totalPassed || 0;
            
            // Update monthly earnings
            const monthlySalary = stats.monthlySalary || 0;
            const thisMonthEarnings = stats.thisMonthEarnings || 0;
            document.getElementById('monthlySalary').innerText = `₹${monthlySalary.toLocaleString()}`;
            document.getElementById('thisMonthEarnings').innerText = `₹${thisMonthEarnings.toLocaleString()}`;
            
            const progressPercent = monthlySalary > 0 ? (thisMonthEarnings / monthlySalary) * 100 : 0;
            document.getElementById('salaryProgress').style.width = `${Math.min(progressPercent, 100)}%`;
            
            const attendanceInfo = stats.attendanceInfo || { present: 0, total: 0 };
            document.getElementById('attendanceInfo').innerText = `Attendance: ${attendanceInfo.present}/${attendanceInfo.total} days`;
            
            // Update quality chart
            const total = (stats.totalReceived || 0) + (stats.totalRejected || 0);
            const passPercent = total > 0 ? ((stats.totalPassed || 0) / total) * 100 : 0;
            const rejectPercent = total > 0 ? ((stats.totalRejected || 0) / total) * 100 : 0;
            document.getElementById('passPercent').innerText = passPercent.toFixed(1);
            document.getElementById('rejectPercent').innerText = rejectPercent.toFixed(1);
            
            updateQualityChart(passPercent, rejectPercent);
        }
        
        // Load production returns for finishing
        await loadProductionReturns();
        
        // Load finishing history
        await loadFinishingHistory();
        
    } catch (error) {
        console.error('Error loading dashboard:', error);
    }
}

// Load production returns available for finishing
async function loadProductionReturns() {
    try {
        const response = await fetch('/finishing/api/pending-returns');
        const returns = await response.json();
        
        const select = document.getElementById('productionReturnSelect');
        if (returns && returns.length) {
            select.innerHTML = '<option value="">-- Select Production Return --</option>' + 
                returns.map(r => `<option value="${r._id}" data-data='${JSON.stringify(r)}'>
                    ${r.assignmentId} - ${r.productName} (Available: ${r.availablePieces} pcs)
                </option>`).join('');
        } else {
            select.innerHTML = '<option value="">No pending production returns</option>';
        }
    } catch (error) {
        console.error('Error loading production returns:', error);
    }
}

// Handle production return selection
document.getElementById('productionReturnSelect').addEventListener('change', async (e) => {
    const selectedOption = e.target.options[e.target.selectedIndex];
    if (!e.target.value) {
        document.getElementById('returnDetailsCard').style.display = 'none';
        document.getElementById('finishingFields').style.display = 'none';
        return;
    }
    
    try {
        const returnData = JSON.parse(selectedOption.dataset.data);
        displayReturnDetails(returnData);
    } catch (error) {
        // If data not in option, fetch from API
        const response = await fetch(`/finishing/api/production-return/${e.target.value}`);
        const returnData = await response.json();
        displayReturnDetails(returnData);
    }
});

function displayReturnDetails(returnData) {
    document.getElementById('detailAssignmentId').innerText = returnData.assignmentId || '-';
    document.getElementById('detailProduct').innerText = returnData.productName || '-';
    document.getElementById('detailKarigar').innerText = returnData.karigarName || '-';
    
    // Build items table
    let itemsHtml = '';
    const items = returnData.sizes || [];
    let totalAvailable = 0;
    
    for (const item of items) {
        const available = (item.given || 0) - (item.alreadyFinished || 0);
        totalAvailable += available;
        const statusBadge = available > 0 ? '<span class="badge bg-success">Available</span>' : '<span class="badge bg-secondary">Fully Finished</span>';
        
        itemsHtml += `
            <tr>
                <td><strong>${item.size}</strong></td>
                <td>${item.given || 0}</td>
                <td>${item.returned || 0}</td>
                <td>${item.damage || 0}</td>
                <td>${item.missing || 0}</td>
                <td class="${available > 0 ? 'text-success fw-bold' : 'text-muted'}">${available}</td>
                <td>${statusBadge}</td>
            </tr>
        `;
    }
    
    document.getElementById('returnItemsTable').innerHTML = itemsHtml;
    document.getElementById('returnDetailsCard').style.display = 'block';
    document.getElementById('finishingFields').style.display = 'block';
    
    currentAvailablePieces = totalAvailable;
    document.getElementById('maxReceivedHint').innerHTML = `Max: ${totalAvailable} pieces`;
    document.getElementById('receivedPieces').max = totalAvailable;
    document.getElementById('receivedPieces').value = '';
    document.getElementById('rejectedPieces').value = 0;
    calculatePassed();
}

// Calculate passed pieces
function calculatePassed() {
    const received = parseInt(document.getElementById('receivedPieces').value) || 0;
    const rejected = parseInt(document.getElementById('rejectedPieces').value) || 0;
    const passed = Math.max(0, received - rejected);
    
    document.getElementById('passedPieces').value = passed;
    
    const warning = document.getElementById('validationWarning');
    if (received > currentAvailablePieces) {
        warning.style.display = 'block';
        document.getElementById('receivedPieces').classList.add('is-invalid');
    } else {
        warning.style.display = 'none';
        document.getElementById('receivedPieces').classList.remove('is-invalid');
    }
}

document.getElementById('receivedPieces').addEventListener('input', calculatePassed);
document.getElementById('rejectedPieces').addEventListener('input', calculatePassed);

// Submit finishing entry
document.getElementById('finishingEntryForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const productionReturnId = document.getElementById('productionReturnSelect').value;
    const received = parseInt(document.getElementById('receivedPieces').value) || 0;
    const rejected = parseInt(document.getElementById('rejectedPieces').value) || 0;
    const remark = document.getElementById('finishRemark').value;
    
    if (!productionReturnId) {
        alert('Please select a production return');
        return;
    }
    
    if (received <= 0) {
        alert('Please enter received pieces');
        return;
    }
    
    if (received > currentAvailablePieces) {
        alert(`Cannot receive more than ${currentAvailablePieces} pieces`);
        return;
    }
    
    try {
        const response = await fetch('/finishing/api/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                productionReturnId,
                received,
                rejected,
                remark
            })
        });
        
        const result = await response.json();
        
        if (response.ok) {
            alert('✅ Finishing entry saved successfully!');
            document.getElementById('finishingEntryForm').reset();
            document.getElementById('returnDetailsCard').style.display = 'none';
            document.getElementById('finishingFields').style.display = 'none';
            loadHelperDashboard();
        } else {
            alert('❌ Error: ' + (result.error || 'Something went wrong'));
        }
    } catch (error) {
        console.error('Error saving finishing entry:', error);
        alert('❌ Error saving finishing entry');
    }
});

// Load finishing history
async function loadFinishingHistory() {
    try {
        const filterDate = document.getElementById('historyFilterDate').value;
        let url = '/finishing/api/my-history';
        if (filterDate) url += `?date=${filterDate}`;
        
        const response = await fetch(url);
        const records = await response.json();
        
        const tbody = document.getElementById('finishingHistoryBody');
        if (records && records.length) {
            tbody.innerHTML = records.map(r => `
                <tr>
                    <td>${new Date(r.finishingDate).toLocaleDateString()}</td>
                    <td><strong>${r.finishingNumber}</strong></td>
                    <td>${r.assignmentId}</td>
                    <td>${r.productName}</td>
                    <td class="text-end">${r.receivedPieces}</td>
                    <td class="text-end">${r.rejectedPieces}</td>
                    <td class="text-end fw-bold text-success">${r.passedPieces}</td>
                    <td><span class="badge bg-success">Completed</span></td>
                    <td>${r.remark || '-'}</td>
                </tr>
            `).join('');
        } else {
            tbody.innerHTML = '<tr><td colspan="9" class="text-center">No finishing records found</td></tr>';
        }
    } catch (error) {
        console.error('Error loading finishing history:', error);
    }
}

function resetFilter() {
    document.getElementById('historyFilterDate').value = '';
    loadFinishingHistory();
}

// Quality Chart
function updateQualityChart(passPercent, rejectPercent) {
    const ctx = document.getElementById('qualityChart').getContext('2d');
    if (qualityChart) qualityChart.destroy();
    
    qualityChart = new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: ['Passed', 'Rejected'],
            datasets: [{
                data: [passPercent, rejectPercent],
                backgroundColor: ['#10b981', '#ef4444'],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });
}

// Initial load
loadHelperDashboard();
setInterval(loadHelperDashboard, 30000);
</script>
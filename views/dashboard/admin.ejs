<div class="row">
    <div class="col-md-12 mb-4">
        <h2><i class="fas fa-chart-line"></i> Dashboard</h2>
        <p>Welcome back, <%= user ? user.username : 'Admin' %>!</p>
    </div>
</div>

<div class="row">
    <div class="col-md-3 mb-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <h5>Quick Actions</h5>
                <hr>
                <a href="/cutting/create" class="btn btn-light btn-sm w-100 mb-2">✂️ New Cutting</a>
                <a href="/assignments/create" class="btn btn-light btn-sm w-100 mb-2">📋 New Assignment</a>
                <a href="/bills/create" class="btn btn-light btn-sm w-100">💰 Create Bill</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-3 mb-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h5>Management</h5>
                <hr>
                <a href="/workers" class="btn btn-light btn-sm w-100 mb-2">👥 Workers</a>
                <a href="/products" class="btn btn-light btn-sm w-100 mb-2">📦 Products</a>
                <a href="/fabrics" class="btn btn-light btn-sm w-100">🧵 Fabrics</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-3 mb-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h5>Production</h5>
                <hr>
                <a href="/cutting" class="btn btn-light btn-sm w-100 mb-2">✂️ Cutting</a>
                <a href="/assignments" class="btn btn-light btn-sm w-100 mb-2">📋 Assignments</a>
                <a href="/packing" class="btn btn-light btn-sm w-100">📦 Packing</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-3 mb-3">
        <div class="card bg-warning text-dark">
            <div class="card-body">
                <h5>Finance</h5>
                <hr>
                <a href="/bills" class="btn btn-light btn-sm w-100 mb-2">📄 Bills</a>
                <a href="/payments" class="btn btn-light btn-sm w-100 mb-2">💵 Payments</a>
                <a href="/reports/loss" class="btn btn-light btn-sm w-100">📊 Reports</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5>System Status</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> System is running properly!
                </div>
                <p>✅ Database Connected</p>
                <p>✅ Authentication Working</p>
                <p>✅ All Modules Ready</p>
            </div>
        </div>
    </div>
</div>
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-boxes"></i> Products Management</h2>
        <p class="text-muted">Manage products with size-wise rates</p>
    </div>
    <a href="/products/create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add Product
    </a>
</div>

<!-- Category Filter -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold"><i class="fas fa-filter"></i> Filter by Category</label>
                <select id="categoryFilter" class="form-control" onchange="filterProducts()">
                    <option value="all">All Categories</option>
                    <option value="Kids">👶 Kids</option>
                    <option value="Mens">👔 Mens</option>
                    <option value="Other">📦 Other</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold"><i class="fas fa-search"></i> Search</label>
                <input type="text" id="searchInput" class="form-control" placeholder="Search products..." onkeyup="filterProducts()">
            </div>
            <div class="col-md-6 text-end">
                <span class="badge bg-primary fs-6" id="productCount">0 Products</span>
                <button class="btn btn-outline-secondary btn-sm ms-2" onclick="resetFilters()">
                    <i class="fas fa-undo"></i> Reset
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Products Table -->
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" id="productsTable">
                <thead class="table-dark">
                    <tr>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th>Sizes</th>
                        <th>Size-wise Rates</th>
                        <th>Colors</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="productsBody">
                    <% if (products && products.length > 0) { %>
                        <% products.forEach(product => { %>
                        <tr data-category="<%= product.category %>" data-name="<%= product.name.toLowerCase() %>">
                            <td><strong><%= product.name %></strong></td>
                            <td>
                                <% if (product.category === 'Kids') { %>
                                    <span class="badge bg-info"><i class="fas fa-child"></i> Kids</span>
                                <% } else if (product.category === 'Mens') { %>
                                    <span class="badge bg-primary"><i class="fas fa-male"></i> Mens</span>
                                <% } else { %>
                                    <span class="badge bg-secondary"><%= product.customCategory || 'Other' %></span>
                                <% } %>
                            </td>
                            <td>
                                <% if (product.sizes && product.sizes.length) { %>
                                    <% product.sizes.forEach(size => { %>
                                        <span class="badge bg-secondary me-1"><%= size %></span>
                                    <% }) %>
                                <% } else { %>
                                    <span class="text-muted">-</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (product.sizeRates && product.sizeRates.length > 0) { %>
                                    <button class="btn btn-sm btn-outline-success" onclick="showSizeRates('<%= product._id %>')">
                                        <i class="fas fa-tags"></i> <%= product.sizeRates.length %> sizes
                                    </button>
                                    <br>
                                    <small class="text-muted">
                                        <% 
                                            const preview = product.sizeRates.slice(0, 3);
                                            preview.forEach((rate, index) => { 
                                        %>
                                            <%= rate.size %>: ₹<%= rate.clientRate %><% if (index < preview.length - 1) { %>, <% } %>
                                        <% }) %>
                                        <% if (product.sizeRates.length > 3) { %>
                                            <span class="text-primary">+<%= product.sizeRates.length - 3 %> more</span>
                                        <% } %>
                                    </small>
                                <% } else { %>
                                    <span class="badge bg-secondary">No size rates</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (product.colors && product.colors.length) { %>
                                    <% product.colors.forEach(color => { %>
                                        <span class="badge <%= color === 'White' ? 'bg-light text-dark' : color === 'Black' ? 'bg-dark' : color === 'Yellow' ? 'bg-warning text-dark' : 'bg-primary' %> me-1">
                                            <%= color %>
                                        </span>
                                    <% }) %>
                                <% } else { %>
                                    <span class="text-muted">-</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (product.isActive) { %>
                                    <span class="badge bg-success">Active</span>
                                <% } else { %>
                                    <span class="badge bg-danger">Inactive</span>
                                <% } %>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-info" onclick="viewProduct('<%= product._id %>')" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <a href="/products/edit/<%= product._id %>" class="btn btn-warning" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form action="/products/delete/<%= product._id %>?_method=DELETE" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-danger delete-confirm" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="7" class="text-center py-4">No products found</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Product View Modal -->
<div class="modal fade" id="viewProductModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-box"></i> Product Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="viewProductBody">
                Loading...
            </div>
        </div>
    </div>
</div>

<!-- Size Rates Modal -->
<div class="modal fade" id="sizeRatesModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-tags"></i> Size-wise Rates</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="sizeRatesBody">
                Loading...
            </div>
        </div>
    </div>
</div>

<script>
    // ============ FILTER PRODUCTS ============
    function filterProducts() {
        const category = document.getElementById('categoryFilter').value;
        const search = document.getElementById('searchInput').value.toLowerCase();
        const rows = document.querySelectorAll('#productsBody tr');
        let visibleCount = 0;
        
        rows.forEach(row => {
            const rowCategory = row.dataset.category;
            const rowName = row.dataset.name;
            let show = true;
            
            if (category !== 'all' && rowCategory !== category) {
                show = false;
            }
            if (search && !rowName.includes(search)) {
                show = false;
            }
            
            row.style.display = show ? '' : 'none';
            if (show) visibleCount++;
        });
        
        document.getElementById('productCount').innerText = visibleCount + ' Products';
    }
    
    function resetFilters() {
        document.getElementById('categoryFilter').value = 'all';
        document.getElementById('searchInput').value = '';
        filterProducts();
    }
    
    // ============ VIEW PRODUCT ============
    async function viewProduct(productId) {
        try {
            const res = await fetch(`/products/api/${productId}`);
            const product = await res.json();
            
            let html = `
                <div class="row">
                    <div class="col-md-6">
                        <h5><i class="fas fa-tag text-primary"></i> Basic Information</h5>
                        <table class="table table-bordered">
                            <tr><td class="fw-bold">Product Name</td><td>${product.name}</td></tr>
                            <tr><td class="fw-bold">Category</td><td>${product.category} ${product.customCategory ? ' ('+product.customCategory+')' : ''}</td></tr>
                            <tr><td class="fw-bold">Status</td><td>${product.isActive ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-danger">Inactive</span>'}</td></tr>
                            <tr><td class="fw-bold">Created At</td><td>${new Date(product.createdAt).toLocaleDateString()}</td></tr>
                            <tr><td class="fw-bold">Colors</td><td>${product.colors && product.colors.length > 0 ? product.colors.map(c => `<span class="badge bg-primary me-1">${c}</span>`).join('') : '<span class="text-muted">No colors</span>'}</td></tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h5><i class="fas fa-tshirt text-success"></i> Sizes</h5>
                        <div class="mb-3">
                            ${product.sizes && product.sizes.length > 0 ? 
                                product.sizes.map(s => `<span class="badge bg-secondary me-1">${s}</span>`).join('') : 
                                '<span class="text-muted">No sizes</span>'
                            }
                        </div>
                    </div>
                </div>
                <hr>
                <h5><i class="fas fa-tags text-success"></i> Size-wise Rates</h5>
            `;
            
            if (product.sizeRates && product.sizeRates.length > 0) {
                html += `
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Size</th>
                                    <th>Client Rate (₹)</th>
                                    <th>Karigar Rate (₹)</th>
                                </tr>
                            </thead>
                            <tbody>
                `;
                
                const sortedRates = [...product.sizeRates].sort((a, b) => {
                    const aNum = parseInt(a.size);
                    const bNum = parseInt(b.size);
                    if (!isNaN(aNum) && !isNaN(bNum)) return aNum - bNum;
                    return a.size.localeCompare(b.size);
                });
                
                sortedRates.forEach(rate => {
                    html += `
                        <tr>
                            <td><strong>${rate.size}</strong></td>
                            <td>₹${rate.clientRate}</td>
                            <td>₹${rate.karigarRate}</td>
                        </tr>
                    `;
                });
                
                html += `
                            </tbody>
                            <tfoot class="table-secondary">
                                <tr>
                                    <td colspan="3">
                                        <small><i class="fas fa-info-circle"></i> Total ${product.sizeRates.length} sizes with rates</small>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                `;
            } else {
                html += `
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i> No size-wise rates set for this product.
                    </div>
                `;
            }
            
            html += `
                    <div class="text-end mt-3">
                        <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <a href="/products/edit/${product._id}" class="btn btn-warning"><i class="fas fa-edit"></i> Edit</a>
                    </div>
                `;
            
            document.getElementById('viewProductBody').innerHTML = html;
            new bootstrap.Modal(document.getElementById('viewProductModal')).show();
        } catch(e) {
            console.error('Error:', e);
            document.getElementById('viewProductBody').innerHTML = '<p class="text-danger">Error loading product details</p>';
        }
    }
    
    // ============ SHOW SIZE RATES ============
    async function showSizeRates(productId) {
        try {
            const res = await fetch(`/products/api/${productId}`);
            const product = await res.json();
            
            let html = `<h6>${product.name}</h6><div class="table-responsive"><table class="table table-bordered"><thead class="table-light"><tr><th>Size</th><th>Client Rate</th><th>Karigar Rate</th></tr></thead><tbody>`;
            
            if (product.sizeRates && product.sizeRates.length > 0) {
                product.sizeRates.forEach(rate => {
                    html += `<tr><td><strong>${rate.size}</strong></td><td>₹${rate.clientRate}</td><td>₹${rate.karigarRate}</td></tr>`;
                });
            } else {
                html += `<tr><td colspan="3" class="text-center text-muted">No size-wise rates</td></tr>`;
            }
            
            html += '</tbody></table></div>';
            document.getElementById('sizeRatesBody').innerHTML = html;
            new bootstrap.Modal(document.getElementById('sizeRatesModal')).show();
        } catch(e) {
            console.error('Error:', e);
            document.getElementById('sizeRatesBody').innerHTML = '<p class="text-danger">Error loading data</p>';
        }
    }
    
    // ============ AUTO-FILTER ON LOAD ============
    document.addEventListener('DOMContentLoaded', function() {
        filterProducts();
    });
</script>
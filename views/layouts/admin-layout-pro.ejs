<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- <meta name="csrf-token" content="<%= locals.csrfToken || '' %>"> -->
    <title><%= title %> | Garment ERP</title>
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <!-- ApexCharts -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <!-- Custom CSS -->
    <style>
        :root {
            --primary: #4361ee;
            --primary-dark: #3730a3;
            --primary-light: #818cf8;
            --secondary: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #06b6d4;
            --dark: #0f172a;
            --light: #f8fafc;
            --gray: #64748b;
            --gray-light: #e2e8f0;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', sans-serif;
            background: #f1f5f9;
            overflow-x: hidden;
        }
        
        /* Premium Sidebar */
        .premium-sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 280px;
            height: 100vh;
            background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
            z-index: 1000;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 10px 0 30px rgba(0,0,0,0.1);
        }
        
        .premium-sidebar.collapsed {
            width: 85px;
        }
        
        .premium-sidebar.collapsed .sidebar-brand span,
        .premium-sidebar.collapsed .menu-item span,
        .premium-sidebar.collapsed .menu-category {
            display: none;
        }
        
        .premium-sidebar.collapsed .menu-item {
            justify-content: center;
            padding: 12px;
        }
        
        .premium-sidebar.collapsed .menu-item i {
            margin-right: 0;
            font-size: 1.3rem;
        }
        
        .sidebar-brand {
            padding: 20px;
            text-align: center;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            margin-bottom: 20px;
        }
        
        .sidebar-brand h3 {
            font-size: 1.3rem;
            font-weight: 700;
            background: linear-gradient(135deg, #60a5fa, #a78bfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin: 0;
        }
        
        .sidebar-brand p {
            font-size: 0.7rem;
            color: #64748b;
            margin: 5px 0 0;
        }
        
        .menu-category {
            padding: 10px 20px;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #64748b;
            font-weight: 600;
        }
        
        .menu-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 20px;
            margin: 4px 12px;
            border-radius: 12px;
            color: #cbd5e1;
            text-decoration: none;
            transition: all 0.3s;
            cursor: pointer;
        }
        
        .menu-item:hover {
            background: rgba(255,255,255,0.1);
            color: white;
            transform: translateX(5px);
        }
        
        .menu-item.active {
            background: linear-gradient(90deg, #4361ee, #818cf8);
            color: white;
            box-shadow: 0 4px 15px rgba(67,97,238,0.3);
        }
        
        .menu-item i {
            width: 24px;
            font-size: 1.1rem;
        }
        
        .menu-badge {
            background: #ef4444;
            color: white;
            border-radius: 20px;
            padding: 2px 8px;
            font-size: 10px;
            margin-left: auto;
        }
        
        /* Premium Main Content */
        .premium-main {
            margin-left: 280px;
            padding: 20px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .premium-main.expanded {
            margin-left: 85px;
        }
        
        /* Premium Top Navbar */
        .premium-navbar {
            background: white;
            border-radius: 20px;
            padding: 12px 25px;
            margin-bottom: 25px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .nav-toggle {
            background: none;
            border: none;
            font-size: 1.3rem;
            color: #64748b;
            cursor: pointer;
            padding: 8px;
            border-radius: 12px;
            transition: all 0.3s;
        }
        
        .nav-toggle:hover {
            background: #f1f5f9;
            color: #4361ee;
        }
        
        .page-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #0f172a;
            margin: 0;
        }
        
        .nav-actions {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .nav-icon-btn {
            background: none;
            border: none;
            font-size: 1.1rem;
            color: #64748b;
            cursor: pointer;
            padding: 8px;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
            position: relative;
        }
        
        .nav-icon-btn:hover {
            background: #f1f5f9;
            color: #4361ee;
        }
        
        .notification-badge {
            position: absolute;
            top: 0;
            right: 0;
            background: #ef4444;
            color: white;
            font-size: 10px;
            border-radius: 50%;
            width: 18px;
            height: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        /* Premium Profile Dropdown */
        .profile-dropdown {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            padding: 8px 15px;
            border-radius: 30px;
            background: #f8fafc;
            transition: all 0.3s;
        }
        
        .profile-dropdown:hover {
            background: #f1f5f9;
        }
        
        .profile-avatar {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #4361ee, #818cf8);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
        }
        
        .profile-info {
            line-height: 1.3;
        }
        
        .profile-name {
            font-weight: 600;
            font-size: 0.9rem;
            color: #0f172a;
        }
        
        .profile-role {
            font-size: 0.7rem;
            color: #64748b;
        }
        
        /* Premium Stats Cards */
        .stats-grid-pro {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }
        
        .stat-card-pro {
            background: white;
            border-radius: 24px;
            padding: 20px;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(0,0,0,0.03);
        }
        
        .stat-card-pro:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 35px -10px rgba(0,0,0,0.1);
        }
        
        .stat-card-pro::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 120px;
            height: 120px;
            background: radial-gradient(circle, rgba(67,97,238,0.05) 0%, transparent 70%);
            border-radius: 50%;
        }
        
        .stat-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }
        
        .stat-title-pro {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #64748b;
            font-weight: 600;
        }
        
        .stat-icon-pro {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, #4361ee15, #818cf815);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            color: #4361ee;
        }
        
        .stat-value-pro {
            font-size: 2rem;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 5px;
        }
        
        .stat-trend-pro {
            font-size: 0.7rem;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        
        .trend-up { color: #10b981; }
        .trend-down { color: #ef4444; }
        
        /* Premium Cards */
        .card-pro {
            background: white;
            border: none;
            border-radius: 24px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
            margin-bottom: 25px;
            overflow: hidden;
        }
        
        .card-header-pro {
            padding: 20px 25px;
            border-bottom: 1px solid #f1f5f9;
            background: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .card-header-pro h6 {
            font-size: 0.9rem;
            font-weight: 600;
            margin: 0;
            color: #0f172a;
        }
        
        .card-body-pro {
            padding: 20px 25px;
        }
        
        /* Activity Timeline */
        .activity-timeline {
            position: relative;
        }
        
        .timeline-item {
            display: flex;
            gap: 15px;
            padding-bottom: 20px;
            position: relative;
        }
        
        .timeline-item:not(:last-child)::before {
            content: '';
            position: absolute;
            left: 17px;
            top: 40px;
            bottom: 0;
            width: 2px;
            background: #e2e8f0;
        }
        
        .timeline-icon {
            width: 35px;
            height: 35px;
            background: #f1f5f9;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            z-index: 1;
        }
        
        .timeline-content {
            flex: 1;
        }
        
        .timeline-title {
            font-weight: 600;
            font-size: 0.85rem;
            margin-bottom: 3px;
            color: #0f172a;
        }
        
        .timeline-time {
            font-size: 0.7rem;
            color: #94a3b8;
        }
        
        /* Transaction List */
        .transaction-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #f1f5f9;
        }
        
        .transaction-item:last-child {
            border-bottom: none;
        }
        
        .transaction-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .transaction-avatar {
            width: 40px;
            height: 40px;
            background: #f1f5f9;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }
        
        .transaction-name {
            font-weight: 600;
            font-size: 0.85rem;
        }
        
        .transaction-date {
            font-size: 0.7rem;
            color: #94a3b8;
        }
        
        .transaction-amount {
            font-weight: 700;
            font-size: 0.9rem;
        }
        
        .amount-positive { color: #10b981; }
        .amount-negative { color: #ef4444; }
        
        /* Mini Calendar */
        .mini-calendar {
            background: #f8fafc;
            border-radius: 20px;
            padding: 15px;
        }
        
        .calendar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }
        
        .calendar-weekdays {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            text-align: center;
            font-size: 0.7rem;
            color: #64748b;
            margin-bottom: 10px;
        }
        
        .calendar-days {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 5px;
        }
        
        .calendar-day {
            text-align: center;
            padding: 8px 5px;
            font-size: 0.75rem;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .calendar-day:hover {
            background: #e2e8f0;
        }
        
        .calendar-day.today {
            background: #4361ee;
            color: white;
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .premium-sidebar {
                left: -280px;
            }
            .premium-sidebar.mobile-open {
                left: 0;
            }
            .premium-main {
                margin-left: 0;
            }
            .stats-grid-pro {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

<!-- Premium Sidebar -->
<div class="premium-sidebar" id="premiumSidebar">
    <div class="sidebar-brand">
        <h3><i class="fas fa-tshirt"></i> Garment ERP</h3>
        <p>Premium Garment Solution</p>
    </div>
    
    <div class="menu-category">MAIN MENU</div>
    <a href="/dashboard" class="menu-item <%= currentPage === 'dashboard' ? 'active' : '' %>">
        <i class="fas fa-chart-line"></i>
        <span>Dashboard</span>
    </a>
    
    <div class="menu-category">PRODUCTION</div>
    <a href="/cutting" class="menu-item">
        <i class="fas fa-cut"></i>
        <span>Cutting</span>
    </a>
    <a href="/assignments" class="menu-item">
        <i class="fas fa-tasks"></i>
        <span>Assignments</span>
        <span class="menu-badge" id="pendingAssignmentsBadge">0</span>
    </a>
    <a href="/production" class="menu-item">
        <i class="fas fa-undo-alt"></i>
        <span>Production Return</span>
    </a>
    <a href="/finishing" class="menu-item">
        <i class="fas fa-iron"></i>
        <span>Finishing</span>
    </a>
    <a href="/packing" class="menu-item">
        <i class="fas fa-boxes"></i>
        <span>Packing</span>
    </a>
    
    <div class="menu-category">FINANCE</div>
    <a href="/bills" class="menu-item">
        <i class="fas fa-file-invoice-dollar"></i>
        <span>Bills</span>
    </a>
    <a href="/payments" class="menu-item">
        <i class="fas fa-money-bill-wave"></i>
        <span>Payments</span>
    </a>
    
    <div class="menu-category">MASTERS</div>
    <a href="/workers" class="menu-item">
        <i class="fas fa-users"></i>
        <span>Workers</span>
    </a>
    <a href="/products" class="menu-item">
        <i class="fas fa-box"></i>
        <span>Products</span>
    </a>
    <a href="/fabrics" class="menu-item">
        <i class="fas fa-layer-group"></i>
        <span>Fabrics</span>
    </a>
    <a href="/pressman" class="menu-item">
        <i class="fas fa-industry"></i>
        <span>Pressman</span>
    </a>
    
    <div class="menu-category">SYSTEM</div>
    <a href="/settings" class="menu-item">
        <i class="fas fa-cog"></i>
        <span>Settings</span>
    </a>
    <a href="/auth/logout" class="menu-item">
        <i class="fas fa-sign-out-alt"></i>
        <span>Logout</span>
    </a>
</div>

<!-- Premium Main Content -->
<div class="premium-main" id="premiumMain">
    <!-- Premium Navbar -->
    <div class="premium-navbar">
        <div class="d-flex align-items-center gap-3">
            <button class="nav-toggle" id="navToggleBtn">
                <i class="fas fa-bars"></i>
            </button>
            <h4 class="page-title"><%= title %></h4>
        </div>
        
        <div class="nav-actions">
            <button class="nav-icon-btn" id="themeToggleBtn">
                <i class="fas fa-moon"></i>
            </button>
            <button class="nav-icon-btn" id="notificationBtn">
                <i class="fas fa-bell"></i>
                <span class="notification-badge">3</span>
            </button>
            <div class="profile-dropdown" data-bs-toggle="dropdown">
                <div class="profile-avatar">
                    <%= user ? user.username.charAt(0).toUpperCase() : 'A' %>
                </div>
                <div class="profile-info d-none d-md-block">
                    <div class="profile-name"><%= user ? user.username : 'Admin' %></div>
                    <div class="profile-role">System Administrator</div>
                </div>
                <i class="fas fa-chevron-down" style="font-size: 0.7rem; color: #94a3b8;"></i>
            </div>
        </div>
    </div>
    
    <!-- Flash Messages -->
    <% if (success_msg && success_msg.length) { %>
        <div class="alert alert-success alert-dismissible fade show mb-3">
            <i class="fas fa-check-circle"></i> <%= success_msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    
    <% if (error_msg && error_msg.length) { %>
        <div class="alert alert-danger alert-dismissible fade show mb-3">
            <i class="fas fa-exclamation-circle"></i> <%= error_msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    
    <!-- Page Content -->
    <%- body %>
</div>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/theme.js"></script>

<script>
    // Sidebar toggle
    const sidebar = document.getElementById('premiumSidebar');
    const main = document.getElementById('premiumMain');
    const toggleBtn = document.getElementById('navToggleBtn');
    
    if (localStorage.getItem('sidebarCollapsed') === 'true') {
        sidebar.classList.add('collapsed');
        main.classList.add('expanded');
    }
    
    toggleBtn.addEventListener('click', () => {
        sidebar.classList.toggle('collapsed');
        main.classList.toggle('expanded');
        localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('collapsed'));
    });
    
    // Load pending assignments count
    async function loadPendingCount() {
        try {
            const response = await fetch('/api/assignments/pending-count');
            const data = await response.json();
            const badge = document.getElementById('pendingAssignmentsBadge');
            if (badge && data.count > 0) {
                badge.innerText = data.count;
                badge.style.display = 'inline-block';
            } else if (badge) {
                badge.style.display = 'none';
            }
        } catch (error) {
            console.error('Error loading pending count:', error);
        }
    }
    
    loadPendingCount();
    setInterval(loadPendingCount, 60000);
</script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof title !=='undefined' ? title : 'Garment ERP' %>
    </title>

    <!-- Fonts -->
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap"
        rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">

    <style>
        /* ============ PREMIUM VARIABLES ============ */
        :root {
            --primary: #4361ee;
            --primary-dark: #3730a3;
            --primary-light: #818cf8;
            --secondary: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #06b6d4;
            --dark: #0f172a;
            --gray: #64748b;
            --gray-light: #e2e8f0;
            --gradient-start: #4361ee;
            --gradient-end: #8b5cf6;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #f8fafc;
            overflow-x: hidden;
        }

        /* ============ PREMIUM NAVBAR - HIGHER HEIGHT ============ */
        .premium-navbar {
            background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: 2px solid rgba(67, 97, 238, 0.1);
        }

        .navbar-container {
            padding: 16px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
        }

        /* ============ BRAND - ATTRACTIVE ============ */
        .navbar-brand-premium {
            display: flex;
            align-items: center;
            gap: 14px;
            text-decoration: none;
            position: relative;
        }

        .brand-icon {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 20px rgba(67, 97, 238, 0.3);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% {
                box-shadow: 0 8px 20px rgba(67, 97, 238, 0.3);
            }

            50% {
                box-shadow: 0 8px 30px rgba(67, 97, 238, 0.5);
            }

            100% {
                box-shadow: 0 8px 20px rgba(67, 97, 238, 0.3);
            }
        }

        .brand-icon i {
            font-size: 1.5rem;
            color: white;
        }

        .brand-text {
            font-size: 1.4rem;
            font-weight: 800;
            background: linear-gradient(135deg, #1e293b, #334155);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -0.5px;
        }

        .brand-badge {
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
            font-size: 0.65rem;
            padding: 3px 10px;
            border-radius: 30px;
            color: white;
            margin-left: 10px;
            font-weight: 600;
            box-shadow: 0 2px 8px rgba(67, 97, 238, 0.3);
        }

        /* ============ NAV TOGGLE ============ */
        .nav-toggle-premium {
            background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
            border: none;
            font-size: 1.3rem;
            color: var(--primary);
            cursor: pointer;
            padding: 10px 14px;
            border-radius: 12px;
            display: none;
            transition: all 0.3s;
        }

        .nav-toggle-premium:hover {
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
            color: white;
            transform: scale(1.02);
        }

        /* ============ NAV MENU ============ */
        .nav-menu-premium {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .nav-menu-premium.show {
            display: flex;
        }

        /* ============ NAV LINKS - ATTRACTIVE ============ */
        .nav-link-premium {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            border-radius: 40px;
            color: #475569;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            background: transparent;
            position: relative;
        }

        .nav-link-premium i {
            font-size: 1rem;
            width: 22px;
            transition: all 0.3s;
        }

        .nav-link-premium:hover {
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.3);
        }

        .nav-link-premium:hover i {
            transform: scale(1.1);
        }

        /* ============ DROPDOWN - ATTRACTIVE ============ */
        .dropdown-premium {
            position: relative;
        }

        .dropdown-toggle-premium {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            border-radius: 40px;
            color: #475569;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            background: transparent;
            border: none;
            transition: all 0.3s ease;
        }

        .dropdown-toggle-premium i {
            font-size: 1rem;
            width: 22px;
        }

        .dropdown-toggle-premium:hover {
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.3);
        }

        .dropdown-toggle-premium .fa-chevron-down {
            font-size: 0.7rem;
            transition: transform 0.3s;
        }

        .dropdown-premium:hover .dropdown-toggle-premium .fa-chevron-down {
            transform: rotate(180deg);
        }

        .dropdown-menu-premium {
            position: absolute;
            top: 100%;
            left: 0;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
            min-width: 260px;
            padding: 12px;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-10px);
            transition: all 0.3s ease;
            z-index: 100;
            border: 1px solid rgba(67, 97, 238, 0.1);
        }

        .dropdown-premium:hover .dropdown-menu-premium {
            opacity: 1;
            visibility: visible;
            transform: translateY(5px);
        }

        .dropdown-item-premium {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 15px;
            border-radius: 14px;
            color: #334155;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.3s;
        }

        .dropdown-item-premium i {
            width: 26px;
            font-size: 1rem;
            color: var(--primary);
        }

        .dropdown-item-premium:hover {
            background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
            color: var(--primary);
            transform: translateX(5px);
        }

        .dropdown-divider-premium {
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--primary), transparent);
            margin: 8px 0;
        }

        /* ============ PROFILE SECTION ============ */
        .profile-section {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-left: 20px;
            padding-left: 20px;
            border-left: 2px solid rgba(67, 97, 238, 0.2);
        }

        .profile-dropdown {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            padding: 6px 16px 6px 10px;
            border-radius: 50px;
            background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
            transition: all 0.3s;
            border: 1px solid rgba(67, 97, 238, 0.2);
        }

        .profile-dropdown:hover {
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(67, 97, 238, 0.3);
        }

        .profile-dropdown:hover .profile-name,
        .profile-dropdown:hover .profile-role,
        .profile-dropdown:hover i {
            color: white;
        }

        .profile-avatar {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 1rem;
            box-shadow: 0 4px 10px rgba(67, 97, 238, 0.3);
        }

        .profile-info {
            line-height: 1.3;
        }

        .profile-name {
            font-weight: 700;
            font-size: 0.9rem;
            color: #1e293b;
        }

        .profile-role {
            font-size: 0.7rem;
            color: #64748b;
        }

        .profile-dropdown .fa-chevron-down {
            font-size: 0.7rem;
            color: #64748b;
            transition: transform 0.3s;
        }

        .profile-dropdown:hover .fa-chevron-down {
            color: white;
            transform: rotate(180deg);
        }

        /* ============ FOOTER ============ */
        .premium-footer {
            background: linear-gradient(135deg, #ffffff, #f8fafc);
            margin-top: 50px;
            padding: 35px 0 25px;
            border-top: 2px solid rgba(67, 97, 238, 0.1);
        }

        .footer-content {
            text-align: center;
        }

        .footer-content p {
            margin-bottom: 10px;
            font-size: 0.85rem;
            color: #64748b;
        }

        .footer-content .company-name {
            font-weight: 700;
            font-size: 1.1rem;
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .footer-content hr {
            width: 80px;
            margin: 15px auto;
            border: none;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--primary), transparent);
        }

        /* ============ MOBILE RESPONSIVE ============ */
        @media (max-width: 992px) {
            .nav-toggle-premium {
                display: block;
            }

            .nav-menu-premium {
                display: none;
                width: 100%;
                flex-direction: column;
                align-items: flex-start;
                padding: 20px 0;
            }

            .nav-menu-premium.show {
                display: flex;
            }

            .dropdown-menu-premium {
                position: static;
                box-shadow: none;
                padding-left: 40px;
                opacity: 1;
                visibility: visible;
                transform: none;
                display: none;
                background: transparent;
            }

            .dropdown-premium.show .dropdown-menu-premium {
                display: block;
            }

            .profile-section {
                margin-left: 0;
                margin-top: 15px;
                padding-left: 0;
                border-left: none;
                justify-content: space-between;
                width: 100%;
            }

            .navbar-container {
                padding: 12px 20px;
            }
        }

        @media (max-width: 768px) {
            .brand-text {
                font-size: 1.1rem;
            }

            .brand-icon {
                width: 40px;
                height: 40px;
            }

            .brand-icon i {
                font-size: 1.2rem;
            }

            .profile-name,
            .profile-role {
                display: none;
            }

            .profile-dropdown {
                padding: 6px 12px;
            }
        }

        /* ============ DARK THEME ============ */
        body.dark-theme {
            background: #0f172a;
        }

        body.dark-theme .premium-navbar {
            background: linear-gradient(135deg, #1e293b, #0f172a);
            border-bottom-color: rgba(67, 97, 238, 0.2);
        }

        body.dark-theme .brand-text {
            background: linear-gradient(135deg, #60a5fa, #a78bfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        body.dark-theme .nav-link-premium,
        body.dark-theme .dropdown-toggle-premium {
            color: #94a3b8;
        }

        body.dark-theme .nav-link-premium:hover,
        body.dark-theme .dropdown-toggle-premium:hover {
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
            color: white;
        }

        body.dark-theme .profile-dropdown {
            background: linear-gradient(135deg, #334155, #1e293b);
        }

        body.dark-theme .profile-name {
            color: #f1f5f9;
        }

        body.dark-theme .dropdown-menu-premium {
            background: #1e293b;
            border-color: rgba(67, 97, 238, 0.2);
        }

        body.dark-theme .dropdown-item-premium {
            color: #cbd5e1;
        }

        body.dark-theme .dropdown-item-premium i {
            color: #818cf8;
        }

        body.dark-theme .dropdown-item-premium:hover {
            background: #334155;
            color: white;
        }

        body.dark-theme .premium-footer {
            background: linear-gradient(135deg, #1e293b, #0f172a);
            border-top-color: rgba(67, 97, 238, 0.2);
        }

        body.dark-theme .footer-content p {
            color: #94a3b8;
        }

        /* ============ ACTIVE LINK STYLE ============ */
        .nav-link-premium.active {
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
            color: white;
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.3);
        }

        .nav-link-premium.active i {
            color: white;
        }

        .dropdown-submenu {
            position: relative;
        }

        .submenu-toggle {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .dropdown-submenu-menu {
            display: none;
            position: absolute;
            top: 0;
            left: 100%;
            min-width: 220px;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, .15);
            z-index: 1000;
        }

        .dropdown-submenu:hover .dropdown-submenu-menu {
            display: block;
        }
    </style>
</head>

<body>
    <!-- Premium Navbar -->
    <nav class="premium-navbar">
        <div class="navbar-container">
            <!-- Brand -->
            <a href="/" class="navbar-brand-premium">
                <div class="brand-icon">
                    <i class="fas fa-tshirt"></i>
                </div>
                <div>
                    <span class="brand-text">
                        <%= locals.settings?.general?.company_name?.split(' ')[0] || ' Garment' %> ERP
                    </span>
                    <span class="brand-badge">Premium</span>
                </div>
            </a>

            <!-- Mobile Toggle -->
            <button class="nav-toggle-premium" id="navToggleBtn">
                <i class="fas fa-bars"></i>
            </button>

            <!-- Nav Menu -->
            <div class="nav-menu-premium" id="navMenu">
                <% if (user) { %>
                    <!-- Dashboard -->
                    <a href="/dashboard" class="nav-link-premium">
                        <i class="fas fa-chart-line"></i> Dashboard
                    </a>

                    <% if (user.role==='admin' ) { %>
                        <!-- Workers Dropdown -->
                        <div class="dropdown-premium">
                            <button class="dropdown-toggle-premium">
                                <i class="fas fa-users"></i> Workers
                                <i class="fas fa-chevron-down"></i>
                            </button>
                            <div class="dropdown-menu-premium">
                                <a href="/workers" class="dropdown-item-premium">
                                    <i class="fas fa-list"></i> All Workers
                                </a>

                                <!-- In Workers dropdown -->
                                <li><a class="dropdown-item" href="/workers/register">
                                        <i class="fas fa-user-plus"></i> Register Worker (with Login credentials)
                                    </a></li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li><a class="dropdown-item" href="/workers/create">
                                        <i class="fas fa-user"></i> Add Worker (Without Login account)
                                    </a></li>
                            </div>
                        </div>

                        <!-- Production Dropdown -->
                        <div class="dropdown-premium">
                            <button class="dropdown-toggle-premium">
                                <i class="fas fa-industry"></i> Production
                                <i class="fas fa-chevron-down"></i>
                            </button>
                            <div class="dropdown-menu-premium">
                                <a href="/cutting" class="dropdown-item-premium">
                                    <i class="fas fa-cut"></i> Cutting
                                </a>
                                <a href="/assignments" class="dropdown-item-premium">
                                    <i class="fas fa-tasks"></i> Assignments
                                </a>
                                <a href="/production/return" class="dropdown-item-premium">
                                    <i class="fas fa-undo-alt"></i> Production Return
                                </a>
                                <a href="/finishing" class="dropdown-item-premium">
                                    <i class="fas fa-iron"></i> Finishing
                                </a>
                                <a href="/packing" class="dropdown-item-premium">
                                    <i class="fas fa-boxes"></i> Packing
                                </a>
                                <div class="dropdown-divider-premium"></div>
                                <a href="/pressman" class="dropdown-item-premium">
                                    <i class="fas fa-industry"></i> Pressman Entry
                                </a>
                            </div>
                        </div>

                        <!-- Pressman Dropdown -->
                        <div class="dropdown-premium">
                            <button class="dropdown-toggle-premium">
                                <i class="fas fa-industry"></i> Pressman
                                <i class="fas fa-chevron-down"></i>
                            </button>
                            <div class="dropdown-menu-premium">
                                <a href="/pressman" class="dropdown-item-premium">
                                    <i class="fas fa-calendar-alt"></i> Daily Entries
                                </a>
                                <a href="/pressman/create" class="dropdown-item-premium">
                                    <i class="fas fa-plus-circle"></i> New Entry
                                </a>
                                <div class="dropdown-divider-premium"></div>
                                <a href="/pressman/products" class="dropdown-item-premium">
                                    <i class="fas fa-tags"></i> Product Rates
                                </a>
                            </div>
                        </div>

                        <!-- Payments -->
                        <div class="dropdown-premium">
                            <button class="dropdown-toggle-premium">
                                <i class="fas fa-industry"></i> Payments
                                <i class="fas fa-chevron-down"></i>
                            </button>

                            <div class="dropdown-menu-premium">

                                <a href="/payments" class="dropdown-item-premium">
                                    <i class="fas fa-money-bill-wave"></i> Payments
                                </a>

                                <div class="dropdown-divider-premium"></div>

                                <a href="/reports/payment-summary" class="dropdown-item-premium">
                                    <i class="fas fa-file-alt"></i> Reports
                                </a>

                                <div class="dropdown-divider-premium"></div>

                                <a href="/attendance" class="dropdown-item-premium">
                                    <i class="fas fa-user-check"></i> Attendance
                                </a>

                            </div>
                        </div>


                        <!-- Billing Dropdown -->
                        <div class="dropdown-premium">
                            <button class="dropdown-toggle-premium">
                                <i class="fas fa-file-invoice"></i> Billing
                                <i class="fas fa-chevron-down"></i>
                            </button>

                            <div class="dropdown-menu-premium">

                                <a href="/bills" class="dropdown-item-premium">
                                    <i class="fas fa-list"></i> All Bills
                                </a>

                                <a href="/bills/create" class="dropdown-item-premium">
                                    <i class="fas fa-plus-circle"></i> Create Bill
                                </a>

                                <!-- <a href="/payments" class="dropdown-item-premium">
            <i class="fas fa-money-bill-wave"></i> Payments
        </a> -->

                                <!-- Advance Submenu -->
                                <div class="dropdown-submenu">
                                    <a href="#" class="dropdown-item-premium submenu-toggle">
                                        <span>
                                            <i class="fas fa-hand-holding-usd"></i> Advance
                                        </span>
                                        <i class="fas fa-chevron-right"></i>
                                    </a>

                                    <div class="dropdown-submenu-menu">
                                        <a href="/advance" class="dropdown-item-premium">
                                            <i class="fas fa-list"></i> Advance Management
                                        </a>

                                        <a href="/advance/statement" class="dropdown-item-premium">
                                            <i class="fas fa-file-alt"></i> Advance Statement
                                        </a>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- Fabrics -->
                        <a href="/fabrics" class="nav-link-premium">
                            <i class="fas fa-warehouse"></i> Fabrics
                        </a>
                        <% } %>

                            <!-- Profile Section -->
                            <div class="profile-section">
                                <!-- Profile Dropdown -->
                                <div class="dropdown-premium">
                                    <div class="profile-dropdown">
                                        <div class="profile-avatar">
                                            <%= user ? user.username.charAt(0).toUpperCase() : 'A' %>
                                        </div>
                                        <div class="profile-info">
                                            <div class="profile-name">
                                                <%= user ? user.username : 'Admin' %>
                                            </div>
                                            <div class="profile-role">
                                                <%= user ? (user.role==='admin' ? 'Administrator' : user.role) : 'User'
                                                    %>
                                            </div>
                                        </div>
                                        <i class="fas fa-chevron-down"></i>
                                    </div>
                                    <div class="dropdown-menu-premium">
                                        <a href="/products" class="dropdown-item-premium">
                                            <i class="fas fa-boxes"></i> Products
                                        </a>
                                        <div class="dropdown-divider-premium"></div>
                                        <a href="/auth/logout" class="dropdown-item-premium"
                                            onclick="return confirm('Logout?')">
                                            <i class="fas fa-sign-out-alt"></i> Logout
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <% } else { %>
                                <div class="profile-section">
                                    <a href="/auth/login" class="nav-link-premium">
                                        <i class="fas fa-sign-in-alt"></i> Login
                                    </a>
                                    <a href="/auth/register" class="nav-link-premium">
                                        <i class="fas fa-user-plus"></i> Register
                                    </a>
                                </div>
                                <% } %>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container mt-4">
        <% if (success_msg && success_msg.length) { %>
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle"></i>
                <%= success_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% } %>

                <% if (error_msg && error_msg.length) { %>
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="fas fa-exclamation-circle"></i>
                        <%= error_msg %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    <% } %>

                        <%- body %>
    </div>

    <!-- Premium Footer -->
    <footer class="premium-footer">
        <div class="container">
            <div class="footer-content">
                <p class="company-name">
                    <%= locals.settings?.general?.company_name || 'Garment Factory ERP' %>
                </p>
                <p><i class="fas fa-map-marker-alt"></i>
                    <%= locals.settings?.general?.company_address || '123 Fashion Street, Garment District' %>
                </p>
                <p>
                    <i class="fas fa-phone-alt"></i>
                    <%= locals.settings?.general?.company_phone || '+91 9876543210' %> &nbsp;|&nbsp;
                        <i class="fas fa-envelope"></i>
                        <%= locals.settings?.general?.company_email || 'info@garmentfactory.com' %>
                </p>
                <p><i class="fas fa-file-invoice"></i> GST: <%= locals.settings?.general?.company_gst
                        || '07AAACA1234A1Z' %>
                </p>
                <p class="text-muted"><i class="fas fa-quote-left"></i>
                    <%= locals.settings?.general?.bill_footer || 'Thank you for your business!' %> <i
                            class="fas fa-quote-right"></i>
                </p>

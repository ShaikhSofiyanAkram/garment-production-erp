<%
currentPage = 'payments';
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Garment ERP</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        .stat-card {
            background: white;
            border-radius: 20px;
            padding: 20px;
            text-align: center;
            border: 1px solid #e2e8f0;
            transition: all 0.3s;
        }
        .stat-card:hover { transform: translateY(-3px); box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1); }
        .stat-value { font-size: 2rem; font-weight: 700; }
        .stat-label { font-size: 0.75rem; color: #64748b; text-transform: uppercase; letter-spacing: 1px; }
        
        .card-premium {
            background: white;
            border: none;
            border-radius: 24px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            overflow: hidden;
        }
        .card-header-premium { padding: 20px 25px; border-bottom: 1px solid #e2e8f0; }
        .card-body-premium { padding: 25px; }
        
        .table-premium { width: 100%; border-collapse: collapse; }
        .table-premium th { padding: 12px; background: #f8fafc; font-weight: 600; border-bottom: 2px solid #e2e8f0; }
        .table-premium td { padding: 12px; border-bottom: 1px solid #e2e8f0; vertical-align: middle; }
        
        .nav-tabs .nav-link { font-weight: 600; padding: 12px 25px; border-radius: 10px 10px 0 0; }
        .nav-tabs .nav-link.active { border-bottom: 3px solid #4361ee; color: #4361ee; }
        
        .form-control-premium {
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 10px 15px;
            width: 100%;
        }
        
        .weekly-card {
            background: #f8fafc;
            border-radius: 16px;
            padding: 15px;
            margin-bottom: 15px;
            border-left: 4px solid #4361ee;
        }
        .weekly-card .week-label {
            font-weight: 600;
            color: #4361ee;
        }
        .btn-payment {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 10px 25px;
            font-weight: 600;
        }
        .btn-payment:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(16,185,129,0.3);
        }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand" href="/dashboard">
            <i class="fas fa-tshirt"></i> Garment ERP
        </a>
        <div class="ms-auto">
            <span class="text-white me-3">
                <i class="fas fa-user"></i> <%= user ? user.username : 'Admin' %>
            </span>
            <a href="/auth/logout" class="btn btn-sm btn-outline-light">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </div>
</nav>

<div class="container-fluid mt-4">
    <!-- Flash Messages -->
    <% if (success_msg && success_msg.length) { %>
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> <%= success_msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    
    <% if (error_msg && error_msg.length) { %>
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> <%= error_msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="fas fa-industry text-success"></i> <%= pressman.name %></h2>
            <p class="text-muted">PRESSMAN - PIECE RATE WORKER</p>
        </div>
        <div>
            <button class="btn btn-info" onclick="printStatement()">
                <i class="fas fa-print"></i> Print Statement
            </button>
            <a href="/payments" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- Stats -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Total Pieces</div>
                <div class="stat-value text-primary"><%= totalPieces || 0 %></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Total Earnings</div>
                <div class="stat-value text-success">₹<%= totalEarnings || 0 %></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Total Advances</div>
                <div class="stat-value text-danger">₹<%= totalAdvances || 0 %></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Net Payable</div>
                <div class="stat-value text-warning">₹<%= netPayable || 0 %></div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4" id="workerTabs">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#workTab">
                <i class="fas fa-tasks"></i> Work Details
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#paymentTab">
                <i class="fas fa-money-bill-wave"></i> Payments
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#advanceTab">
                <i class="fas fa-hand-holding-usd"></i> Advances
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#weeklyTab">
                <i class="fas fa-calendar-week"></i> Weekly Summary
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content">
        <!-- Work Details Tab -->
        <div class="tab-pane fade show active" id="workTab">
            <div class="card-premium">
                <div class="card-header-premium d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-list"></i> Work Details</h5>
                </div>
                <div class="card-body-premium p-0">
                    <div class="table-responsive">
                        <table class="table-premium">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Entry #</th>
                                    <th>Product</th>
                                    <th>Category</th>
                                    <th class="text-end">Pieces</th>
                                    <th class="text-end">Rate (₹)</th>
                                    <th class="text-end">Amount (₹)</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (workDetails && workDetails.length > 0) { %>
                                    <% workDetails.forEach(work => { %>
                                        <tr>
                                            <td><%= new Date(work.date).toLocaleDateString() %></td>
                                            <td><%= work.entryNumber || '-' %></td>
                                            <td><strong><%= work.productName %></strong></td>
                                            <td><span class="badge bg-secondary"><%= work.category || 'N/A' %></span></td>
                                            <td class="text-end"><%= work.pieces || 0 %></td>
                                            <td class="text-end">₹<%= work.rate || 0 %></td>
                                            <td class="text-end fw-bold">₹<%= work.amount || 0 %></td>
                                            <td>
                                                <span class="badge bg-<%= work.status === 'paid' ? 'success' : 'warning' %>">
                                                    <%= work.status || 'Pending' %>
                                                </span>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="8" class="text-center py-3 text-muted">No work records found</td></tr>
                                <% } %>
                            </tbody>
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td colspan="4" class="text-end">Total:</td>
                                    <td class="text-end"><%= totalPieces || 0 %></td>
                                    <td></td>
                                    <td class="text-end text-success">₹<%= totalEarnings || 0 %></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payments Tab -->
        <div class="tab-pane fade" id="paymentTab">
            <div class="card-premium">
                <div class="card-header-premium">
                    <h5 class="mb-0"><i class="fas fa-history"></i> Payment History</h5>
                </div>
                <div class="card-body-premium p-0">
                    <div class="table-responsive">
                        <table class="table-premium">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th class="text-end">Amount (₹)</th>
                                    <th>Method</th>
                                    <th>Reference</th>
                                    <th>Remark</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (payments && payments.length > 0) { %>
                                    <% payments.forEach(p => { %>
                                        <tr>
                                            <td><%= new Date(p.paymentDate).toLocaleDateString() %></td>
                                            <td class="text-end fw-bold text-success">₹<%= p.amount || 0 %></td>
                                            <td><%= p.paymentMethod || 'Cash' %></td>
                                            <td><%= p.reference || '-' %></td>
                                            <td><%= p.remark || '-' %></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="5" class="text-center py-3 text-muted">No payments found</td></tr>
                                <% } %>
                            </tbody>
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td class="text-end">Total:</td>
                                    <td class="text-end text-success">₹<%= totalPaid || 0 %></td>
                                    <td colspan="3"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Advances Tab -->
        <div class="tab-pane fade" id="advanceTab">
            <div class="card-premium">
                <div class="card-header-premium">
                    <h5 class="mb-0"><i class="fas fa-hand-holding-usd"></i> Advance History</h5>
                </div>
                <div class="card-body-premium p-0">
                    <div class="table-responsive">
                        <table class="table-premium">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th class="text-end">Amount (₹)</th>
                                    <th>Purpose</th>
                                    <th>Status</th>
                                    <th>Remark</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (advances && advances.length > 0) { %>
                                    <% advances.forEach(a => { %>
                                        <tr>
                                            <td><%= new Date(a.date).toLocaleDateString() %></td>
                                            <td class="text-end fw-bold text-danger">₹<%= a.amount || 0 %></td>
                                            <td><%= a.purpose || '-' %></td>
                                            <td><span class="badge bg-<%= a.status === 'adjusted' ? 'success' : 'warning' %>"><%= a.status %></span></td>
                                            <td><%= a.remark || '-' %></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="5" class="text-center py-3 text-muted">No advances found</td></tr>
                                <% } %>
                            </tbody>
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td class="text-end">Total:</td>
                                    <td class="text-end text-danger">₹<%= totalAdvances || 0 %></td>
                                    <td colspan="3"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Weekly Summary Tab -->
        <div class="tab-pane fade" id="weeklyTab">
            <div class="card-premium">
                <div class="card-header-premium">
                    <h5 class="mb-0"><i class="fas fa-calendar-week"></i> Weekly Summary</h5>
                </div>
                <div class="card-body-premium">
                    <% if (weeklySummary && weeklySummary.length > 0) { %>
                        <% weeklySummary.forEach(week => { %>
                            <div class="weekly-card">
                                <div class="row align-items-center">
                                    <div class="col-md-4">
                                        <div class="week-label">
                                            <i class="fas fa-calendar"></i> 
                                            <%= new Date(week.weekStart).toLocaleDateString() %> - 
                                            <%= new Date(week.weekEnd).toLocaleDateString() %>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <span class="badge bg-primary">Total Pieces: <%= week.totalPieces %></span>
                                    </div>
                                    <div class="col-md-3">
                                        <span class="badge bg-success">Total Amount: ₹<%= week.totalAmount %></span>
                                    </div>
                                    <div class="col-md-2 text-end">
                                        <button class="btn btn-sm btn-payment" onclick="payWeekly('<%= week.weekStart.toISOString().split('T')[0] %>', '<%= week.weekEnd.toISOString().split('T')[0] %>', '<%= week.totalAmount %>')">
                                            <i class="fas fa-money-bill-wave"></i> Pay
                                        </button>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="text-center text-muted py-3">No weekly summary available</div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Modal -->
    <div class="modal fade" id="paymentModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="fas fa-money-bill-wave"></i> Process Payment</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="paymentForm">
                    <div class="modal-body">
                        <input type="hidden" id="payPressmanId" value="<%= pressman._id %>">
                        <input type="hidden" id="payFromDate">
                        <input type="hidden" id="payToDate">
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Payment Amount (₹)</label>
                            <input type="number" class="form-control-premium" id="payAmount" required min="1" readonly style="background:#f0fdf4; font-weight:bold;">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Payment Method</label>
                            <select class="form-control-premium" id="payMethod">
                                <option value="cash">💵 Cash</option>
                                <option value="bank_transfer">🏦 Bank Transfer</option>
                                <option value="cheque">📝 Cheque</option>
                                <option value="upi">📱 UPI</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Reference / Transaction ID</label>
                            <input type="text" class="form-control-premium" id="payReference" placeholder="Cheque No / UTR">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Remark</label>
                            <textarea class="form-control-premium" id="payRemark" rows="2" placeholder="Optional notes"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-check"></i> Process Payment
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    const pressmanId = '<%= pressman._id %>';
    
    // ============ PAY WEEKLY ============
    function payWeekly(fromDate, toDate, amount) {
        document.getElementById('payFromDate').value = fromDate;
        document.getElementById('payToDate').value = toDate;
        document.getElementById('payAmount').value = amount;
        document.getElementById('payAmount').max = amount;
        new bootstrap.Modal(document.getElementById('paymentModal')).show();
    }

    // ============ PROCESS PAYMENT ============
    document.getElementById('paymentForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const amount = document.getElementById('payAmount').value;
        const method = document.getElementById('payMethod').value;
        const reference = document.getElementById('payReference').value;
        const remark = document.getElementById('payRemark').value;
        const fromDate = document.getElementById('payFromDate').value;
        const toDate = document.getElementById('payToDate').value;
        
        if (!amount || amount <= 0) {
            alert('Please enter valid amount');
            return;
        }
        
        if (!confirm(`Confirm payment of ₹${parseFloat(amount).toLocaleString()} for ${pressmanId}?`)) {
            return;
        }
        
        try {
            const res = await fetch('/payments/api/pressman/pay', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    pressmanId: pressmanId,
                    amount,
                    paymentMethod: method,
                    reference,
                    remark,
                    fromDate,
                    toDate
                })
            });
            
            const data = await res.json();
            if (data.success) {
                alert(`✅ Payment of ₹${parseFloat(amount).toLocaleString()} processed successfully!`);
                location.reload();
            } else {
                alert('❌ Error: ' + (data.error || 'Failed to process payment'));
            }
        } catch(e) {
            console.error('Error:', e);
            alert('Error processing payment');
        }
    });

    // ============ PRINT STATEMENT ============
    function printStatement() {
        window.open(`/payments/pressman/${pressmanId}/print`, '_blank');
    }
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
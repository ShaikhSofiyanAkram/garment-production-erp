<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4><i class="fas fa-hand-sparkles"></i> Helper Payment: <%= worker.name %></h4>
                <small>Monthly Salary: ₹<%= worker.monthlyRate %></small>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <label>Month</label>
                        <select id="month" class="form-control">
                            <% for(let i=1;i<=12;i++){ %>
                                <option value="<%= i %>" <%= i===month ? 'selected' : '' %>><%= new Date(2000,i-1,1).toLocaleString('default',{month:'long'}) %></option>
                            <% } %>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label>Year</label>
                        <select id="year" class="form-control">
                            <% for(let i=2020;i<=2030;i++){ %>
                                <option value="<%= i %>" <%= i===year ? 'selected' : '' %>><%= i %></option>
                            <% } %>
                        </select>
                    </div>
                </div>
                <div id="paymentDetails" class="mt-4"></div>
                <a href="/payments" class="btn btn-secondary mt-3">⬅ Back</a>
            </div>
        </div>
    </div>
</div>

<script>
async function loadData(){
    const month = document.getElementById('month').value;
    const year = document.getElementById('year').value;
    const res = await fetch(`/payments/helper-data/<%= worker._id %>?month=${month}&year=${year}`);
    const d = await res.json();
    if(d.success){
        document.getElementById('paymentDetails').innerHTML = `
            <div class="alert alert-info">
                ✅ Present: ${d.daysPresent} | ❌ Absent: ${d.daysAbsent}<br>
                💰 Daily Rate: ₹${d.dailyRate} | Earned: ₹${d.earnedSalary}
            </div>
            <table class="table table-bordered text-center">
                <thead class="table-dark"><tr><th>Work (Earned)</th><th>Advance</th><th>Remaining</th></tr></thead>
                <tbody><tr>
                    <td class="bg-success text-white fw-bold">₹${d.earnedSalary}</td>
                    <td class="bg-danger text-white fw-bold">₹${d.totalAdvance}</td>
                    <td class="bg-warning fw-bold">₹${d.netPayable}</td>
                </tr></tbody>
            </table>
            <form action="/payments/helper-pay" method="POST">
                <input type="hidden" name="workerId" value="<%= worker._id %>">
                <input type="hidden" name="month" value="${month}">
                <input type="hidden" name="year" value="${year}">
                <input type="hidden" name="amount" value="${d.netPayable}">
                <button class="btn btn-success w-100">✅ Pay ₹${d.netPayable}</button>
            </form>
        `;
    } else {
        document.getElementById('paymentDetails').innerHTML = `<div class="alert alert-danger">${d.error}</div>`;
    }
}
document.getElementById('month').addEventListener('change',loadData);
document.getElementById('year').addEventListener('change',loadData);
loadData();
</script>
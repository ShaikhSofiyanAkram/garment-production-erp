<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Assignment <%= assignment.assignmentId %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { padding: 20px; font-family: Arial, sans-serif; }
        .header { text-align: center; margin-bottom: 30px; border-bottom: 2px solid #000; padding-bottom: 10px; }
        .company-name { font-size: 24px; font-weight: bold; }
        .assignment-title { font-size: 20px; margin-top: 10px; }
        .details-table { width: 100%; margin-bottom: 20px; }
        .details-table td { padding: 5px; }
        .sizes-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        .sizes-table th, .sizes-table td { border: 1px solid #000; padding: 8px; text-align: center; }
        .sizes-table th { background: #f2f2f2; }
        .footer { margin-top: 40px; text-align: center; font-size: 12px; }
        @media print { .no-print { display: none; } }
        .no-print { text-align: center; margin-top: 20px; }
        button { padding: 10px 20px; margin: 5px; cursor: pointer; }
    </style>
</head>
<body>
    <div class="header">
        <div class="company-name">GARMENT FACTORY ERP</div>
        <div>123 Fashion Street, Garment District</div>
        <div>Phone: +91 1234567890</div>
        <div class="assignment-title">ASSIGNMENT SLIP</div>
    </div>
    
    <table class="details-table">
        <tr>
            <td width="50%"><strong>Assignment ID:</strong> <%= assignment.assignmentId %></td>
            <td width="50%"><strong>Date:</strong> <%= new Date(assignment.assignedDate).toLocaleDateString() %></td>
        </tr>
        <tr>
            <td><strong>Cutting #:</strong> <%= assignment.cutting?.cuttingNumber %></td>
            <td><strong>Due Date:</strong> <%= assignment.dueDate ? new Date(assignment.dueDate).toLocaleDateString() : 'N/A' %></td>
        </tr>
        <tr>
            <td><strong>Product:</strong> <%= assignment.productName %></td>
            <td><strong>Category:</strong> <%= assignment.productCategory %></td>
        </tr>
        <tr>
            <td><strong>Karigar:</strong> <%= assignment.karigar?.name %></td>
            <td><strong>Phone:</strong> <%= assignment.karigar?.phone || 'N/A' %></td>
        </tr>
    </table>
    
    <h5>Size Details:</h5>
    <table class="sizes-table">
        <thead>
            <tr>
                <th>Size</th>
                <th>Pieces Given</th>
            </tr>
        </thead>
        <tbody>
            <% assignment.sizes.forEach(s => { %>
            <tr>
                <td><%= s.size %></td>
                <td><%= s.pieces %></td>
            </tr>
            <% }) %>
            <tr style="background: #f2f2f2; font-weight: bold;">
                <td><strong>TOTAL</strong></td>
                <td><strong><%= assignment.givenPieces %></strong></td>
            </tr>
        </tbody>
    </table>
    
    <% if (assignment.remark) { %>
    <div class="mt-3">
        <strong>Remark:</strong> <%= assignment.remark %>
    </div>
    <% } %>
    
    <div style="margin-top: 40px;">
        <table width="100%">
            <tr>
                <td style="text-align: center;">
                    <strong>Karigar Signature</strong><br><br><br>
                    ___________________
                </td>
                <td style="text-align: center;">
                    <strong>Factory Stamp</strong><br><br><br>
                    ___________________
                </td>
            </tr>
        </table>
    </div>
    
    <div class="footer">
        This is a computer generated assignment slip.<br>
        Please return completed work within due date.
    </div>
    
    <div class="no-print">
        <button onclick="window.print()">🖨️ Print</button>
        <button onclick="window.close()">❌ Close</button>
    </div>
</body>
</html>
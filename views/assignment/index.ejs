<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-tasks"></i> Assignments</h2>
    <div>
        <a href="/assignments/create" class="btn btn-primary">
            <i class="fas fa-plus"></i> New Assignment
        </a>
    </div>
</div>

<!-- Stats Cards -->
<div class="row mb-4">
    <div class="col-md-3"><div class="card bg-primary text-white"><div class="card-body text-center"><h5>Total</h5><h2><%= totalAssignments %></h2></div></div></div>
    <div class="col-md-3"><div class="card bg-success text-white"><div class="card-body text-center"><h5>Completed</h5><h2><%= completedCount %></h2></div></div></div>
    <div class="col-md-3"><div class="card bg-warning text-dark"><div class="card-body text-center"><h5>Pending</h5><h2><%= pendingCount %></h2></div></div></div>
    <div class="col-md-3"><div class="card bg-info text-white"><div class="card-body text-center"><h5>Partial</h5><h2><%= partialCount %></h2></div></div></div>
</div>

<!-- Old Assignments Alert -->
<% if (oldCompletedCount > 0) { %>
<div class="alert alert-warning">
    <i class="fas fa-clock"></i> <strong><%= oldCompletedCount %></strong> assignments completed more than 30 days ago.
    <div class="mt-2">
        <form action="/assignments/archive-old" method="POST" style="display: inline-block;">
            <button type="submit" class="btn btn-sm btn-warning">Archive Old</button>
        </form>
        <form action="/assignments/delete-old" method="POST" style="display: inline-block;">
            <button type="submit" class="btn btn-sm btn-danger">Delete Old</button>
        </form>
    </div>
</div>
<% } %>

<!-- Filter Tabs -->
<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link <%= currentFilter === 'all' ? 'active' : '' %>" href="/assignments?filter=all">All</a></li>
    <li class="nav-item"><a class="nav-link <%= currentFilter === 'pending' ? 'active' : '' %>" href="/assignments?filter=pending">Pending</a></li>
    <li class="nav-item"><a class="nav-link <%= currentFilter === 'partial' ? 'active' : '' %>" href="/assignments?filter=partial">Partial</a></li>
    <li class="nav-item"><a class="nav-link <%= currentFilter === 'completed' ? 'active' : '' %>" href="/assignments?filter=completed">Completed</a></li>
    <li class="nav-item"><a class="nav-link <%= currentFilter === 'old' ? 'active' : '' %>" href="/assignments?filter=old">Old (>30 days)</a></li>
</ul>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Assignment ID</th><th>Cutting #</th><th>Karigar</th><th>Product</th>
                        <th>Sizes & Pieces</th><th>Total</th><th>Returned</th><th>Status</th>
                        <th>Date</th><th>Completed On</th><th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (assignments && assignments.length) { %>
                        <% assignments.forEach(assignment => { 
                            const isCompleted = assignment.status === 'completed';
                            const returnedPieces = assignment.returnedPieces || 0;
                        %>
                        <tr>
                            <td><strong><%= assignment.assignmentId %></strong></td>
                            <td><%= assignment.cutting?.cuttingNumber %></td>
                            <td><%= assignment.karigar?.name %></td>
                            <td><%= assignment.productName %> (<%= assignment.productCategory %>)</td>
                            <td>
                                <% if (assignment.sizes && assignment.sizes.length) { %>
                                    <% assignment.sizes.forEach(s => { %>
                                        <span class="badge bg-info mb-1"><%= s.size %>: <%= s.pieces %></span><br>
                                    <% }) %>
                                <% } else { %><span class="text-muted">-</span><% } %>
                            </td>
                            <td><strong><%= assignment.givenPieces %></strong></td>
                            <td><%= returnedPieces %></td>
                            <td>
                                <% if (isCompleted) { %><span class="badge bg-success">✅ Completed</span>
                                <% } else if (assignment.status === 'partial') { %><span class="badge bg-info">⏳ Partial</span>
                                <% } else { %><span class="badge bg-danger">⏰ Pending</span><% } %>
                            </td>
                            <td><%= new Date(assignment.assignedDate).toLocaleDateString() %></td>
                            <td><%= assignment.completedAt ? new Date(assignment.completedAt).toLocaleDateString() : '-' %></td>
                            <td class="actions">
                            <form action="/assignments/delete/<%= assignment._id %>?_method=DELETE" method="POST" style="display: inline;">
                                <button type="submit" class="btn btn-sm btn-danger delete-confirm" title="Delete Assignment" 
                                        onclick="return confirm('Are you sure you want to delete this assignment?');">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                            
                            <a href="/assignments/edit/<%= assignment._id %>" class="btn btn-sm btn-warning" title="Edit Assignment">
                                <i class="fas fa-edit"></i>
                            </a>
                            
                            <% if (assignment.status !== 'completed') { %>
                                <a href="/production/return?assignment=<%= assignment._id %>" class="btn btn-sm btn-primary" title="Record Return">
                                    <i class="fas fa-undo-alt"></i>
                                </a>
                            <% } %>
                        </td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="11" class="text-center">No assignments found</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
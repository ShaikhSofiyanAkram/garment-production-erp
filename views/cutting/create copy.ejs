<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="fas fa-cut"></i> New Cutting Entry</h4>
                <small>Select product, then add sizes and pieces</small>
            </div>
            <div class="card-body">
                <form action="/cutting/create" method="POST" id="cuttingForm">
                    
                    <!-- Client Name (Optional) -->
                    <div class="mb-3">
                        <label class="form-label">Client Name <span class="text-muted">(Optional)</span></label>
                        <select class="form-control" id="clientSelect" name="client">
                            <option value="">-- Select Client (Optional) --</option>
                            <% if (clients && clients.length) { %>
                                <% clients.forEach(client => { %>
                                    <option value="<%= client.name %>"><%= client.name %> - <%= client.phone %></option>
                                <% }) %>
                            <% } %>
                        </select>
                        <small class="text-muted">Order module is optional. Cutting can be done without order.</small>
                    </div>
                    
                    <!-- Product Selection -->
                    <div class="mb-3">
                        <label class="form-label">Select Product *</label>
                        <select class="form-control" id="productSelect" name="productSelect" required>
                            <option value="">-- Select Product --</option>
                            <% if (products && products.length) { %>
                                <% 
                                    const kidsProducts = [];
                                    const mensProducts = [];
                                    const otherProducts = [];
                                    const uniqueProducts = new Map();
                                    products.forEach(product => {
                                        if (!uniqueProducts.has(product.name)) {
                                            uniqueProducts.set(product.name, product);
                                        }
                                    });
                                    const uniqueProductsArray = Array.from(uniqueProducts.values());
                                %>
                                <% uniqueProductsArray.forEach(product => { %>
                                    <option value="<%= product.name %>" data-category="<%= product.category || 'Other' %>">
                                        <%= product.name %> <% if (product.category === 'Kids') { %>👶<% } else if (product.category === 'Mens') { %>👔<% } %>
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>
                        <input type="hidden" name="productName" id="productName">
                        <input type="hidden" name="productCategory" id="productCategory">
                    </div>
                    
                    <!-- Size Selection Area -->
                    <div id="sizeSection" style="display: none;">
                        <!-- Manual Size Add -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Add Size Manually</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="manualSizeInput" placeholder="Enter size (e.g., 36, XL, 42)">
                                <button class="btn btn-success" type="button" onclick="addManualSize()">
                                    <i class="fas fa-plus"></i> Add Size
                                </button>
                            </div>
                            <small class="text-muted">Enter any size - numbers or text (e.g., 36, XL, XXL, 42)</small>
                        </div>
                        
                        <!-- OR Preset Sizes -->
                        <div class="mb-3" id="presetSizesDiv" style="display: none;">
                            <label class="form-label fw-bold">OR Select from Preset Sizes</label>
                            <div id="sizeChipsContainer" class="d-flex flex-wrap gap-2" style="min-height: 60px; padding: 10px; border: 1px solid #dee2e6; border-radius: 8px; background: #f8fafc;">
                                <!-- Preset sizes will appear here -->
                            </div>
                        </div>
                        
                        <!-- Added Sizes List -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Added Sizes & Cutting Pieces</label>
                            <div id="addedSizesContainer" class="border rounded p-3 bg-light" style="min-height: 150px;">
                                <div id="sizeRowsList">
                                    <p class="text-muted text-center">Click "Add Size" button above to add sizes with cutting pieces</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Total Pieces -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Total Cutting Pieces</label>
                        <input type="text" class="form-control" id="totalPieces" readonly 
                               style="background:#e9ecef; font-weight:bold; font-size:1.2rem;">
                    </div>
                    
                    <!-- Cutting Worker -->
                    <div class="mb-3">
                        <label class="form-label">Cutting Worker <span class="text-muted">(Optional)</span></label>
                        <select class="form-control" name="cuttingWorker">
                            <option value="">Select Worker</option>
                            <% if (workers && workers.length) { %>
                                <% workers.forEach(worker => { %>
                                    <option value="<%= worker._id %>"><%= worker.name %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                    
                    <!-- Remark -->
                    <div class="mb-3">
                        <label class="form-label">Remark</label>
                        <textarea class="form-control" name="remark" rows="2" placeholder="Any special instructions?"></textarea>
                    </div>
                    
                    <div class="text-center">
                        <button type="submit" class="btn btn-primary btn-lg px-5">
                            <i class="fas fa-save"></i> Save Cutting Entry
                        </button>
                        <a href="/cutting" class="btn btn-secondary btn-lg px-5">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .size-chip {
        display: inline-block;
        background: white;
        border: 2px solid #dee2e6;
        border-radius: 10px;
        padding: 10px 20px;

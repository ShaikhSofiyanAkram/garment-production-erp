<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Garment ERP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: #f1f5f9;
        }
        .report-header {
            background: linear-gradient(135deg, #059669, #10b981);
            color: white;
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 20px;
        }
        .btn-print {
            background: white;
            color: #059669;
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
            cursor: pointer;
        }
        @media print {
            .no-print { display: none; }
            body { background: white; }
        }
    </style>
</head>
<body>
    <div class="container-fluid py-3">
        <!-- Header -->
        <div class="report-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2><i class="fas fa-money-bill-wave"></i> Worker Payment Report</h2>
                    <p class="mb-0 opacity-75">Monthly payment summary for all workers</p>
                </div>
                <div>
                    <button class="btn-print no-print" onclick="window.print()">
                        <i class="fas fa-print"></i> Print Report
                    </button>
                </div>
            </div>
        </div>
        
        <!-- Filter Form -->
        <div class="card mb-4 no-print">
            <div class="card-body">
                <form method="GET" class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Month</label>
                        <select name="month" class="form-control">
                            <% for(let i=1; i<=12; i++) { %>
                                <option value="<%= i %>" <%= month == i ? 'selected' : '' %>>
                                    <%= new Date(2000, i-1, 1).toLocaleString('default', { month: 'long' }) %>
                                </option>
                            <% } %>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Year</label>
                        <select name="year" class="form-control">
                            <% for(let i=2020; i<=2030; i++) { %>
                                <option value="<%= i %>" <%= year == i ? 'selected' : '' %>><%= i %></option>
                            <% } %>
                        </select>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="fas fa-filter"></i> Generate Report
                        </button>
                    </div>
                </form>
            </div>
        </div>
        
        <!-- Report Table -->
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-table"></i> Payment Summary for <%= new Date(year, month-1, 1).toLocaleString('default', { month: 'long' }) %> <%= year %></h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Worker Name</th>
                                <th>Type</th>
                                <th>Payment Type</th>
                                <th>Work Done</th>
                                <th>Amount (₹)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (reports && reports.length) { %>
                                <% reports.forEach(report => { %>
                                    <tr>
                                        <td><strong><%= report.worker?.name %></strong></td>
                                        <td>
                                            <span class="badge bg-info">
                                                <%= report.worker?.workerType === 'karigar' ? 'Karigar' :
                                                   report.worker?.workerType === 'pressman' ? 'Pressman' :
                                                   report.worker?.workerType === 'helper' ? 'Helper' : 'Cutting' %>
                                            </span>
                                        </td>
                                        <td><%= report.paymentType %></td>
                                        <td>
                                            <% if (report.paymentType === 'Piece-based') { %>
                                                <%= report.totalPieces || 0 %> pieces
                                            <% } else { %>
                                                Monthly Fixed
                                            <% } %>
                                        </td>
                                        <td><strong>₹<%= (report.amount || 0).toLocaleString() %></strong></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center">No data found</td>
                                </tr>
                            <% } %>
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <th colspan="4" class="text-end">Total:</th>
                                <th>₹<%= reports ? reports.reduce((sum, r) => sum + (r.amount || 0), 0).toLocaleString() : 0 %></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
        <div> <a href="/dashboard" class="btn btn-light no-print">
                        <i class="fas fa-arrow-left"></i> Back to Dashboard
                </a>
         </div>
        
        <!-- Footer -->
        <div class="text-center mt-4 text-muted small">
            Generated on: <%= new Date().toLocaleString() %>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
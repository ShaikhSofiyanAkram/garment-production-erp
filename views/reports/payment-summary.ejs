<%
const currentPage = 'reports';
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Garment ERP</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    
    <style>
        .stat-card { background: white; border-radius: 12px; padding: 15px; border: 1px solid #e2e8f0; }
        .stat-value { font-size: 1.25rem; font-weight: 700; }
        .stat-label { font-size: 0.7rem; color: #64748b; text-transform: uppercase; letter-spacing: 1px; }
        .amount-positive { color: #22c55e; }
        .amount-negative { color: #ef4444; }
        .table-premium { width: 100%; border-collapse: collapse; }
        .table-premium th { padding: 10px; background: #f8fafc; font-weight: 600; border-bottom: 2px solid #e2e8f0; }
        .table-premium td { padding: 10px; border-bottom: 1px solid #e2e8f0; }
    </style>
</head>
<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand" href="/dashboard">
            <i class="fas fa-tshirt"></i> Garment ERP
        </a>
        <div class="ms-auto">
            <span class="text-white me-3">
                <i class="fas fa-user"></i> <%= user ? user.username : 'Admin' %>
            </span>
            <a href="/auth/logout" class="btn btn-sm btn-outline-light">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </div>
</nav>

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3><i class="fas fa-file-alt text-primary"></i> Payment Summary Report</h3>
            <p class="text-muted">Complete payment summary for all workers</p>
        </div>
        <div>
            <a href="/reports/export-payment-report?period=<%= period %>" class="btn btn-success">
                <i class="fas fa-file-excel"></i> Export Excel
            </a>
            <a href="/dashboard" class="btn btn-secondary ms-2">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Total Workers</div>
                <div class="stat-value text-primary"><%= reportData?.length || 0 %></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Total Earnings</div>
                <div class="stat-value text-success">₹<%= grandTotalEarnings || 0 %></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Total Paid</div>
                <div class="stat-value text-info">₹<%= grandTotalPaid || 0 %></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Net Payable</div>
                <div class="stat-value text-warning">₹<%= grandNetPayable || 0 %></div>
            </div>
        </div>
    </div>

    <!-- Report Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-list"></i> Payment Summary</h5>
                <span class="text-muted small"><%= new Date().toLocaleDateString('en-IN') %></span>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table-premium">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Worker</th>
                            <th>Type</th>
                            <th class="text-end">Pieces</th>
                            <th class="text-end">Earnings</th>
                            <th class="text-end">Paid</th>
                            <th class="text-end">Advances</th>
                            <th class="text-end">Net Payable</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (reportData && reportData.length > 0) { %>
                            <% reportData.forEach((data, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td><strong><%= data.worker.name %></strong></td>
                                    <td>
                                        <span class="badge bg-<%= data.worker.workerType === 'karigar' ? 'primary' : data.worker.workerType === 'pressman' ? 'info' : data.worker.workerType === 'helper' ? 'warning' : 'danger' %>">
                                            <%= data.worker.workerType.toUpperCase() %>
                                        </span>
                                    </td>
                                    <td class="text-end"><%= data.totalPieces || 0 %></td>
                                    <td class="text-end text-success">₹<%= data.totalEarnings || 0 %></td>
                                    <td class="text-end text-info">₹<%= data.totalPaid || 0 %></td>
                                    <td class="text-end text-danger">₹<%= data.totalAdvances || 0 %></td>
                                    <td class="text-end fw-bold <%= data.netPayable > 0 ? 'text-success' : data.netPayable < 0 ? 'text-danger' : 'text-secondary' %>">
                                        ₹<%= data.netPayable || 0 %>
                                    </td>
                                    <td class="text-center">
                                        <a href="/payments/worker/<%= data.worker._id %>" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    <i class="fas fa-inbox fa-2x mb-2"></i>
                                    <p>No data available</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="4" class="text-end">Grand Total:</td>
                            <td class="text-end text-success">₹<%= grandTotalEarnings || 0 %></td>
                            <td class="text-end text-info">₹<%= grandTotalPaid || 0 %></td>
                            <td class="text-end text-danger">₹<%= grandTotalAdvances || 0 %></td>
                            <td class="text-end text-warning">₹<%= grandNetPayable || 0 %></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="mt-4 text-center text-muted small">
        <p>Generated on: <%= new Date().toLocaleString('en-IN') %></p>
        <p>SANIYA Garment ERP - Professional Payment Management System</p>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-users text-primary"></i> Client Management</h2>
        <p class="text-muted">Manage all clients/parties for billing</p>
    </div>
    <a href="/clients/create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add New Client
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>GST No</th>
                        <th>Address</th>
                        <th>Credit Limit</th>
                        <th>Balance</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(clients && clients.length) { %>
                        <% clients.forEach(client => { %>
                            <tr>
                                <td><strong><%= client.name %></strong></td>
                                <td><%= client.phone || '-' %></td>
                                <td><%= client.gstNo || '-' %></td>
                                <td><%= client.address ? client.address.substring(0, 30) : '-' %><%= client.address && client.address.length > 30 ? '...' : '' %></td>
                                <td>₹<%= (client.creditLimit || 0).toLocaleString() %></td>
                                <td>₹<%= (client.openingBalance || 0).toLocaleString() %></td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="/clients/edit/<%= client._id %>" class="btn btn-warning" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button" class="btn btn-danger" onclick="deleteClient('<%= client._id %>')" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="7" class="text-center py-5">No clients found. <a href="/clients/create">Add your first client</a></td></tr>
                    <% } %>
                </tbody>
                <tfoot class="table-light">
                    <tr class="fw-bold">
                        <td colspan="4" class="text-end">Total Clients:</td>
                        <td colspan="3"><%= clients ? clients.length : 0 %> clients</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<div class="mt-3 text-end">
    <a href="/bills/create" class="btn btn-success">
        <i class="fas fa-file-invoice"></i> Create Bill
    </a>
    <a href="/dashboard" class="btn btn-secondary">
        <i class="fas fa-dashboard"></i> Back to Dashboard
    </a>
</div>

<script>
    async function deleteClient(id) {
        if(!confirm('Are you sure you want to delete this client? This action cannot be undone.')) return;
        
        const res = await fetch(`/clients/delete/${id}`, { method: 'DELETE' });
        if(res.ok) {
            alert('Client deleted successfully');
            location.reload();
        } else {
            alert('Error deleting client');
        }
    }
</script>
<%
currentPage = 'attendance';
%>

<%- include('../layouts/admin-layout') %>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="fas fa-layer-group text-primary"></i> Bulk Weekly Attendance</h2>
            <p class="text-muted">Mark attendance for full week at once (Only for Helper & Cutting workers)</p>
        </div>
        <a href="/attendance" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Monthly View
        </a>
    </div>

    <!-- Week Info -->
    <div class="alert alert-info mb-4">
        <i class="fas fa-calendar-week"></i>
        <strong>Week:</strong> <%= startDate.toLocaleDateString() %> to <%= endDate.toLocaleDateString() %>
    </div>

    <!-- Bulk Attendance Form -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-check-double"></i> Mark Attendance for the Week
        </div>
        <div class="card-body">
            <form method="POST" action="/attendance/bulk/save">
                <input type="hidden" name="weekStart" value="<%= startDate.toISOString().split('T')[0] %>">
                <input type="hidden" name="workerType" value="<%= workerType %>">
                
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead class="table-dark">
                            <tr>
                                <th style="min-width: 150px;">Worker</th>
                                <% weekDays.forEach(day => { %>
                                    <th class="text-center <%= day.isFriday ? 'bg-danger' : '' %>">
                                        <%= day.dayName %><br>
                                        <small><%= day.date.toLocaleDateString() %></small>
                                    </th>
                                <% }) %>
                            </tr>
                        </thead>
                        <tbody>
                            <% workers.forEach(worker => { %>
                                <tr>
                                    <td>
                                        <strong><%= worker.name %></strong><br>
                                        <small class="text-muted"><%= worker.workerType %></small>
                                    </td>
                                    <% weekDays.forEach(day => {
                                        const key = `${worker._id}_${day.date.toISOString().split('T')[0]}`;
                                        const existing = attendanceMap[key];
                                        const defaultStatus = (day.isFriday && worker.workerType === 'helper') ? 'holiday' : (existing ? existing.status : 'absent');
                                    %>
                                        <td class="text-center p-2">
                                            <select name="attendance[<%= key %>][status]" class="form-select form-select-sm">
                                                <option value="present" <%= defaultStatus === 'present' ? 'selected' : '' %>>P - Present</option>
                                                <option value="absent" <%= defaultStatus === 'absent' ? 'selected' : '' %>>A - Absent</option>
                                                <option value="half_day" <%= defaultStatus === 'half_day' ? 'selected' : '' %>>H - Half Day</option>
                                                <option value="leave" <%= defaultStatus === 'leave' ? 'selected' : '' %>>L - Leave</option>
                                                <% if (day.isFriday && worker.workerType === 'helper') { %>
                                                    <option value="holiday" selected disabled>HOL - Holiday</option>
                                                <% } %>
                                            </select>
                                            <input type="text" name="attendance[<%= key %>][note]" class="form-control form-control-sm mt-1" 
                                                   placeholder="Note" value="<%= existing ? existing.note : '' %>">
                                        </td>
                                    <% }) %>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                
                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-primary btn-lg px-5">
                        <i class="fas fa-save"></i> Save Bulk Attendance
                    </button>
                    <a href="/attendance" class="btn btn-secondary btn-lg px-5">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
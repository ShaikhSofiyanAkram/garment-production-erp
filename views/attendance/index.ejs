<%
const currentPage = 'attendance';
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Garment ERP</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    
    <style>
        /* ✅ Attendance Cell - Clickable */
        .attendance-cell {
            cursor: pointer;
            padding: 12px 10px;
            text-align: center;
            border-radius: 10px;
            min-width: 50px;
            transition: all 0.2s ease;
            font-size: 22px;
            border: 2px solid #e2e8f0;
            background: #f8fafc;
            color: #94a3b8;
            user-select: none;
            display: inline-block;
            width: 100%;
        }
        .attendance-cell:hover {
            transform: scale(1.1);
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        }
        .attendance-cell.present { 
            background: #dcfce7; 
            color: #16a34a; 
            border-color: #16a34a;
        }
        .attendance-cell.pending { 
            background: #f8fafc; 
            color: #94a3b8; 
            border-color: #e2e8f0;
        }
        .attendance-cell.absent { 
            background: #fee2e2; 
            color: #dc2626; 
            border-color: #dc2626;
        }
        .attendance-cell.half-day { 
            background: #fef3c7; 
            color: #d97706; 
            border-color: #d97706;
        }
        .attendance-cell.holiday { 
            background: #dbeafe; 
            color: #2563eb; 
            border-color: #2563eb;
        }
        
        .stat-card { 
            background: white; 
            border-radius: 12px; 
            padding: 15px; 
            border: 1px solid #e2e8f0; 
            text-align: center; 
        }
        .stat-value { font-size: 1.75rem; font-weight: 700; }
        .stat-label { font-size: 0.7rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; }
        .week-nav-btn {
            border-radius: 10px;
            padding: 8px 20px;
            font-weight: 600;
        }
        .table-attendance th {
            background: #f8fafc;
            font-weight: 600;
            font-size: 0.7rem;
            text-transform: uppercase;
            color: #64748b;
            padding: 10px 6px;
            text-align: center;
            border-bottom: 2px solid #e2e8f0;
        }
        .table-attendance td {
            vertical-align: middle;
            padding: 6px 4px;
            text-align: center;
        }
        .legend-item {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-right: 15px;
            font-size: 12px;
        }
        .legend-color {
            width: 22px;
            height: 22px;
            border-radius: 6px;
            border: 2px solid #e2e8f0;
        }
        .legend-color.present { background: #dcfce7; border-color: #16a34a; }
        .legend-color.pending { background: #f8fafc; border-color: #e2e8f0; }
        .legend-color.absent { background: #fee2e2; border-color: #dc2626; }
        .legend-color.half-day { background: #fef3c7; border-color: #d97706; }
        .legend-color.holiday { background: #dbeafe; border-color: #2563eb; }
        
        .fa-check-circle { font-size: 22px; }
        .fa-circle { font-size: 22px; color: #d1d5db; }
        
        .filter-section {
            background: white;
            border-radius: 12px;
            padding: 15px 20px;
            border: 1px solid #e2e8f0;
            margin-bottom: 15px;
        }
        .filter-section .form-select, .filter-section .form-control {
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            padding: 8px 12px;
        }
        .filter-section .btn-filter {
            background: #4361ee;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 8px 25px;
            font-weight: 600;
        }
        .filter-section .btn-filter:hover {
            background: #3651d4;
            color: white;
        }
        .filter-section .btn-reset {
            background: #e2e8f0;
            color: #475569;
            border: none;
            border-radius: 8px;
            padding: 8px 25px;
            font-weight: 600;
        }
        .filter-section .btn-reset:hover {
            background: #cbd5e1;
            color: #1e293b;
        }
    </style>
</head>
<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand" href="/dashboard">
            <i class="fas fa-tshirt"></i> Garment ERP
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <span class="nav-link">
                        <i class="fas fa-user"></i> <%= user ? user.username : 'Admin' %>
                    </span>
                </li>
                <li class="nav-item">
                    <a href="/auth/logout" class="btn btn-sm btn-outline-light nav-link">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container-fluid mt-4">
    <!-- Flash Messages -->
    <% if (success_msg && success_msg.length) { %>
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> <%= success_msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (error_msg && error_msg.length) { %>
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> <%= error_msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3><i class="fas fa-calendar-check text-primary"></i> Attendance Management</h3>
            <p class="text-muted">Manage weekly attendance for helpers and cutting workers</p>
        </div>
        <div>
            <a href="/dashboard" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- ✅ UPDATED: Month/Week Navigation with proper variable handling -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h5 class="mb-0">
                <i class="fas fa-calendar-alt text-primary me-2"></i>
                <% 
                    // ✅ Set default values safely
                    var currentViewMode = typeof viewMode !== 'undefined' ? viewMode : 'week';
                    var currentMonthStart = typeof monthStart !== 'undefined' ? monthStart : new Date();
                    var currentWeekStart = typeof weekStart !== 'undefined' ? weekStart : new Date();
                    var currentWeekEnd = typeof weekEnd !== 'undefined' ? weekEnd : new Date();
                    
                    if (typeof currentWeekEnd === 'undefined' || currentWeekEnd === '') {
                        currentWeekEnd = new Date(currentWeekStart);
                        currentWeekEnd.setDate(currentWeekEnd.getDate() + 6);
                    }
                %>
                <% if (currentViewMode === 'month') { %>
                    Month: <strong><%= new Date(currentMonthStart).toLocaleString('default', { month: 'long', year: 'numeric' }) %></strong>
                <% } else { %>
                    Week: <strong><%= new Date(currentWeekStart).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></strong> - 
                    <strong><%= new Date(currentWeekEnd).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></strong>
                <% } %>
            </h5>
            <small class="text-muted"><%= currentViewMode === 'month' ? 'Full month view' : '(Saturday to Friday)' %></small>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <% if (currentViewMode === 'month') { %>
                <a href="?view=month&month=<%= new Date(new Date(currentMonthStart).setMonth(new Date(currentMonthStart).getMonth() - 1)).toISOString().split('T')[0] %>" 
                   class="btn btn-outline-info week-nav-btn">
                    <i class="fas fa-chevron-left"></i> Previous Month
                </a>
                <a href="?view=month&month=<%= new Date(new Date(currentMonthStart).setMonth(new Date(currentMonthStart).getMonth() + 1)).toISOString().split('T')[0] %>" 
                   class="btn btn-outline-info week-nav-btn">
                    Next Month <i class="fas fa-chevron-right"></i>
                </a>
            <% } else { %>
                <a href="?view=week&weekStart=<%= new Date(new Date(currentWeekStart).setDate(new Date(currentWeekStart).getDate() - 7)).toISOString().split('T')[0] %>" 
                   class="btn btn-outline-primary week-nav-btn">
                    <i class="fas fa-chevron-left"></i> Previous Week
                </a>
                <a href="?view=week&weekStart=<%= new Date(new Date(currentWeekStart).setDate(new Date(currentWeekStart).getDate() + 7)).toISOString().split('T')[0] %>" 
                   class="btn btn-outline-primary week-nav-btn">
                    Next Week <i class="fas fa-chevron-right"></i>
                </a>
            <% } %>
            <a href="?view=month&month=<%= new Date(currentMonthStart).toISOString().split('T')[0] %>" 
               class="btn btn-outline-info week-nav-btn <%= currentViewMode === 'month' ? 'active' : '' %>">
                <i class="fas fa-calendar-alt"></i> Month View
            </a>
            <a href="?view=week" 
               class="btn btn-primary week-nav-btn <%= currentViewMode === 'week' ? 'active' : '' %>">
                <i class="fas fa-calendar-week"></i> Current Week
            </a>
        </div>
    </div>

    <!-- ✅ FILTER SECTION -->
    <div class="filter-section">
        <form method="GET" action="/attendance" class="row g-3 align-items-end">
            <input type="hidden" name="view" value="<%= viewMode || 'week' %>">
            <div class="col-md-3">
                <label class="form-label fw-bold">Worker Type</label>
                <select name="workerType" class="form-select">
                    <option value="">All Workers</option>
                    <option value="helper" <%= query && query.workerType === 'helper' ? 'selected' : '' %>>Helper</option>
                    <option value="cutting" <%= query && query.workerType === 'cutting' ? 'selected' : '' %>>Cutting</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Date</label>
                <input type="date" name="date" class="form-control" value="<%= query && query.date ? query.date : '' %>">
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Status</label>
                <select name="status" class="form-select">
                    <option value="">All</option>
                    <option value="present" <%= query && query.status === 'present' ? 'selected' : '' %>>Present</option>
                    <option value="absent" <%= query && query.status === 'absent' ? 'selected' : '' %>>Absent</option>
                    <option value="half-day" <%= query && query.status === 'half-day' ? 'selected' : '' %>>Half Day</option>
                    <option value="holiday" <%= query && query.status === 'holiday' ? 'selected' : '' %>>Holiday</option>
                </select>
            </div>
            <div class="col-md-3">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn-filter w-50">
                        <i class="fas fa-filter"></i> Filter
                    </button>
                    <a href="/attendance" class="btn-reset w-50 text-center">
                        <i class="fas fa-times"></i> Reset
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Total Workers</div>
                <div class="stat-value text-primary" id="statWorkers"><%= workers?.length || 0 %></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Present Days</div>
                <div class="stat-value text-success" id="statPresent">
                    <%= workers?.reduce((sum, w) => sum + w.present, 0) || 0 %>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Pending Days</div>
                <div class="stat-value text-secondary" id="statPending">
                    <%= workers?.reduce((sum, w) => sum + w.pending, 0) || 0 %>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Total Days</div>
                <div class="stat-value text-info" id="statTotal">
                    <%= workers?.reduce((sum, w) => sum + w.total, 0) || 0 %>
                </div>
            </div>
        </div>
    </div>

    <!-- Legend -->
    <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="d-flex flex-wrap align-items-center gap-3">
                <span class="fw-bold me-2">Click to toggle:</span>
                <span class="legend-item">
                    <span class="legend-color present"></span> Present ✅
                </span>
                <span class="legend-item">
                    <span class="legend-color pending"></span> Pending ⬜
                </span>
                <span class="legend-item">
                    <span class="legend-color absent"></span> Absent ❌
                </span>
                <span class="legend-item">
                    <span class="legend-color half-day"></span> Half Day ⏳
                </span>
                <span class="legend-item">
                    <span class="legend-color holiday"></span> Holiday 🎉
                </span>
                <span class="ms-3 text-muted small">Click cycles: Pending → Present → Absent → Half Day → Holiday</span>
            </div>
        </div>
    </div>

    <!-- Attendance Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-list"></i> Weekly Attendance</h5>
                <button class="btn btn-success" onclick="saveAllAttendance()">
                    <i class="fas fa-save"></i> Save All
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 table-attendance" id="attendanceTable">
                    <thead>
                        <tr>
                            <th style="min-width: 120px; text-align: left;">Worker</th>
                            <th style="min-width: 70px;">Type</th>
                            <% if (viewMode === 'month') { 
                                const daysInMonth = new Date(monthStart.getFullYear(), monthStart.getMonth() + 1, 0).getDate();
                                for (let i = 1; i <= daysInMonth; i++) { 
                                    const date = new Date(monthStart);
                                    date.setDate(i);
                                    const dayName = date.toLocaleString('default', { weekday: 'short' });
                            %>
                                <th style="min-width: 40px; font-size: 10px;">
                                    <div><%= dayName %></div>
                                    <small><%= i %></small>
                                </th>
                            <% } } else { 
                                const days = ['Sat', 'Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri'];
                                const currentDate = new Date(weekStart);
                                for (let i = 0; i < 7; i++) { 
                                    const date = new Date(currentDate);
                                    date.setDate(date.getDate() + i);
                                    const dayNum = date.getDate();
                                    const month = date.toLocaleString('default', { month: 'short' });
                            %>
                                <th style="min-width: 50px;">
                                    <div><%= days[i] %></div>
                                    <small><%= dayNum %> <%= month %></small>
                                </th>
                            <% } } %>
                            <th style="min-width: 50px;">✅</th>
                            <th style="min-width: 50px;">⬜</th>
                            <th style="min-width: 80px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (workers && workers.length > 0) { %>
                            <% workers.forEach(w => { 
                                const totalDays = viewMode === 'month' ? new Date(monthStart.getFullYear(), monthStart.getMonth() + 1, 0).getDate() : 7;
                                const pendingCount = totalDays - w.total;
                            %>
                                <tr id="row-<%= w.worker._id %>">
                                    <td style="text-align: left;">
                                        <strong><%= w.worker.name %></strong>
                                        <br><small class="text-muted"><%= w.worker.phone || '' %></small>
                                    </td>
                                    <td>
                                        <span class="badge bg-<%= w.worker.workerType === 'helper' ? 'warning' : 'danger' %>">
                                            <%= w.worker.workerType.toUpperCase() %>
                                        </span>
                                    </td>
                                    <% if (viewMode === 'month') { 
                                        const daysInMonth = new Date(monthStart.getFullYear(), monthStart.getMonth() + 1, 0).getDate();
                                        for (let i = 1; i <= daysInMonth; i++) { 
                                            const date = new Date(monthStart);
                                            date.setDate(i);
                                            const dateStr = date.toISOString().split('T')[0];
                                            const att = w.attendance.find(a => new Date(a.date).toISOString().split('T')[0] === dateStr);
                                            const status = att ? att.status : 'pending';
                                    %>
                                        <td>
                                            <div class="attendance-cell <%= status %>" 
                                                 onclick="toggleAttendance('<%= w.worker._id %>', '<%= dateStr %>', '<%= status %>')"
                                                 data-worker="<%= w.worker._id %>"
                                                 data-date="<%= dateStr %>"
                                                 data-status="<%= status %>">
                                                <% if (status === 'present') { %>
                                                    <i class="fas fa-check-circle"></i>
                                                <% } else if (status === 'absent') { %>
                                                    <i class="fas fa-times-circle"></i>
                                                <% } else if (status === 'half-day') { %>
                                                    <i class="fas fa-circle-half-stroke"></i>
                                                <% } else if (status === 'holiday') { %>
                                                    <i class="fas fa-calendar-day"></i>
                                                <% } else { %>
                                                    <i class="far fa-circle"></i>
                                                <% } %>
                                            </div>
                                        </td>
                                    <% } } else { 
                                        const dateObj = new Date(weekStart);
                                        for (let i = 0; i < 7; i++) {
                                            const currentDate = new Date(dateObj);
                                            currentDate.setDate(currentDate.getDate() + i);
                                            const dateStr = currentDate.toISOString().split('T')[0];
                                            const att = w.attendance.find(a => new Date(a.date).toISOString().split('T')[0] === dateStr);
                                            const status = att ? att.status : 'pending';
                                    %>
                                        <td>
                                            <div class="attendance-cell <%= status %>" 
                                                 onclick="toggleAttendance('<%= w.worker._id %>', '<%= dateStr %>', '<%= status %>')"
                                                 data-worker="<%= w.worker._id %>"
                                                 data-date="<%= dateStr %>"
                                                 data-status="<%= status %>">
                                                <% if (status === 'present') { %>
                                                    <i class="fas fa-check-circle"></i>
                                                <% } else if (status === 'absent') { %>
                                                    <i class="fas fa-times-circle"></i>
                                                <% } else if (status === 'half-day') { %>
                                                    <i class="fas fa-circle-half-stroke"></i>
                                                <% } else if (status === 'holiday') { %>
                                                    <i class="fas fa-calendar-day"></i>
                                                <% } else { %>
                                                    <i class="far fa-circle"></i>
                                                <% } %>
                                            </div>
                                        </td>
                                    <% } } %>
                                    <td><strong class="text-success" id="present-<%= w.worker._id %>"><%= w.present %></strong></td>
                                    <td id="pending-<%= w.worker._id %>"><%= pendingCount %></td>
                                    <td>
                                        <button onclick="saveWorkerAttendance('<%= w.worker._id %>')" class="btn btn-sm btn-outline-success">
                                            <i class="fas fa-save"></i>
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="12" class="text-center py-5 text-muted">
                                    <i class="fas fa-users fa-3x mb-3 d-block"></i>
                                    <p class="mb-0">No helpers or cutting workers found</p>
                                    <small>Add workers from Worker Management</small>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Quick Tips -->
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card bg-light border-0">
                <div class="card-body">
                    <h6><i class="fas fa-lightbulb text-warning"></i> Quick Tips</h6>
                    <ul class="small mb-0">
                        <li><strong>Click</strong> on any cell to cycle status</li>
                        <li>Status cycle: Pending → Present → Absent → Half Day → Holiday</li>
                        <li>Save individual worker or use <strong>"Save All"</strong></li>
                        <li><strong>Month View</strong> for full month management</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-light border-0">
                <div class="card-body">
                    <h6><i class="fas fa-info-circle text-info"></i> Payment Impact</h6>
                    <ul class="small mb-0">
                        <li><strong>Helper:</strong> Monthly salary based on present days</li>
                        <li><strong>Cutting:</strong> Monthly salary based on present days</li>
                        <li>Daily Rate = Monthly Rate / 26 working days</li>
                        <li>Only <span class="text-success">Present</span> days count for salary</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
// ==================== TOGGLE ATTENDANCE ====================
function toggleAttendance(workerId, date, currentStatus) {
    console.log('🔄 Toggle clicked:', workerId, date, currentStatus);
    
    // Status cycle: pending → present → absent → half-day → holiday → pending
    const statuses = ['pending', 'present', 'absent', 'half-day', 'holiday'];
    let index = statuses.indexOf(currentStatus);
    if (index === -1) index = 0;
    const newStatus = statuses[(index + 1) % statuses.length];
    
    // Find and update the cell
    const cell = document.querySelector(`[data-worker="${workerId}"][data-date="${date}"]`);
    if (cell) {
        // Update class
        cell.className = 'attendance-cell ' + newStatus;
        cell.dataset.status = newStatus;
        
        // Update icon
        if (newStatus === 'present') {
            cell.innerHTML = '<i class="fas fa-check-circle"></i>';
        } else if (newStatus === 'absent') {
            cell.innerHTML = '<i class="fas fa-times-circle"></i>';
        } else if (newStatus === 'half-day') {
            cell.innerHTML = '<i class="fas fa-circle-half-stroke"></i>';
        } else if (newStatus === 'holiday') {
            cell.innerHTML = '<i class="fas fa-calendar-day"></i>';
        } else {
            cell.innerHTML = '<i class="far fa-circle"></i>';
        }
        
        console.log('✅ Cell updated to:', newStatus);
    } else {
        console.log('❌ Cell not found for:', workerId, date);
    }
    
    // Update counts
    updateRowCounts(workerId);
}

// ==================== UPDATE ROW COUNTS ====================
function updateRowCounts(workerId) {
    const cells = document.querySelectorAll(`[data-worker="${workerId}"]`);
    let presentCount = 0;
    let totalCount = 0;
    
    cells.forEach(cell => {
        totalCount++;
        if (cell.dataset.status === 'present') {
            presentCount++;
        }
    });
    
    const pendingCount = totalCount - presentCount;
    
    // Update UI
    const presentCell = document.getElementById(`present-${workerId}`);
    const pendingCell = document.getElementById(`pending-${workerId}`);
    
    if (presentCell) presentCell.textContent = presentCount;
    if (pendingCell) pendingCell.textContent = pendingCount;
    
    // Update stats
    updateStats();
}

// ==================== UPDATE STATS ====================
function updateStats() {
    const rows = document.querySelectorAll('#attendanceTable tbody tr');
    let totalPresent = 0;
    let totalPending = 0;
    let totalDays = 0;
    
    rows.forEach(row => {
        const presentCell = row.querySelector('td:nth-last-child(3)');
        const pendingCell = row.querySelector('td:nth-last-child(2)');
        if (presentCell) totalPresent += parseInt(presentCell.textContent) || 0;
        if (pendingCell) totalPending += parseInt(pendingCell.textContent) || 0;
    });
    totalDays = totalPresent + totalPending;
    
    document.getElementById('statPresent').textContent = totalPresent;
    document.getElementById('statPending').textContent = totalPending;
    document.getElementById('statTotal').textContent = totalDays;
}

// ==================== SAVE WORKER ATTENDANCE ====================
function saveWorkerAttendance(workerId) {
    const cells = document.querySelectorAll(`[data-worker="${workerId}"]`);
    const attendanceData = [];
    
    cells.forEach(cell => {
        const status = cell.dataset.status;
        if (status !== 'pending') {
            attendanceData.push({
                workerId: workerId,
                date: cell.dataset.date,
                status: status,
                remark: ''
            });
        }
    });
    
    if (attendanceData.length === 0) {
        alert('⚠️ No attendance to save. Please mark attendance first.');
        return;
    }
    
    saveAttendance(attendanceData);
}

// ==================== SAVE ALL ATTENDANCE ====================
function saveAllAttendance() {
    const allCells = document.querySelectorAll('.attendance-cell');
    const attendanceMap = {};
    
    allCells.forEach(cell => {
        const workerId = cell.dataset.worker;
        const status = cell.dataset.status;
        if (status === 'pending') return;
        
        if (!attendanceMap[workerId]) {
            attendanceMap[workerId] = [];
        }
        attendanceMap[workerId].push({
            workerId: workerId,
            date: cell.dataset.date,
            status: status,
            remark: ''
        });
    });
    
    let allData = [];
    Object.values(attendanceMap).forEach(arr => {
        allData = allData.concat(arr);
    });
    
    if (allData.length === 0) {
        alert('⚠️ No attendance to save. Please mark attendance first.');
        return;
    }
    
    saveAttendance(allData);
}

// ==================== SAVE ATTENDANCE API ====================
function saveAttendance(attendanceData) {
    if (!confirm(`Save ${attendanceData.length} attendance record(s)?`)) return;
    
    const submitBtn = document.querySelector('.btn-success');
    if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
    }
    
    fetch('/attendance/bulk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            weekStart: '<%= weekStart.toISOString().split("T")[0] %>',
            attendanceData: attendanceData
        })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            alert('✅ Attendance saved successfully!');
            window.location.reload();
        } else {
            alert('❌ Error: ' + data.error);
        }
    })
    .catch(err => {
        alert('❌ Error: ' + err.message);
    })
    .finally(() => {
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-save"></i> Save All';
        }
    });
}


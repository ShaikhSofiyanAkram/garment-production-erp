            otherDiv.innerHTML = `<input type="text" class="form-control" name="items[otherFabric][]" 
                                    placeholder="Enter fabric type name">`;
            select.parentNode.appendChild(otherDiv);
        }
        
        if (select.value === 'Other') {
            otherDiv.style.display = 'block';
            select.name = 'items[fabricTypeSelect][]';
            // Add hidden input for the actual value
            let hiddenInput = row.querySelector('.fabric-type-hidden');
            if (!hiddenInput) {
                hiddenInput = document.createElement('input');
                hiddenInput.type = 'hidden';
                hiddenInput.className = 'fabric-type-hidden';
                hiddenInput.name = 'items[fabricType][]';
                select.parentNode.appendChild(hiddenInput);
            }
        } else {
            otherDiv.style.display = 'none';
            // Set hidden input value to selected value
            let hiddenInput = row.querySelector('.fabric-type-hidden');
            if (!hiddenInput) {
                hiddenInput = document.createElement('input');
                hiddenInput.type = 'hidden';
                hiddenInput.className = 'fabric-type-hidden';
                hiddenInput.name = 'items[fabricType][]';
                select.parentNode.appendChild(hiddenInput);
            }
            hiddenInput.value = select.value;
        }
    }
    
    // ========== HANDLE "OTHER" COLOR ==========
    function handleColorChange(select) {
        const row = select.closest('.item-row');
        let otherDiv = row.querySelector('.other-color-div');
        
        if (!otherDiv) {
            otherDiv = document.createElement('div');
            otherDiv.className = 'other-color-div mt-2';
            otherDiv.style.display = 'none';
            otherDiv.innerHTML = `<input type="text" class="form-control" name="items[otherColor][]" 
                                    placeholder="Enter color name">`;
            select.parentNode.appendChild(otherDiv);
        }
        
        if (select.value === 'Other') {
            otherDiv.style.display = 'block';
            select.name = 'items[colorSelect][]';
            // Add hidden input for actual color value
            let hiddenInput = row.querySelector('.color-hidden');
            if (!hiddenInput) {
                hiddenInput = document.createElement('input');
                hiddenInput.type = 'hidden';
                hiddenInput.className = 'color-hidden';
                hiddenInput.name = 'items[color][]';
                select.parentNode.appendChild(hiddenInput);
            }
        } else {
            otherDiv.style.display = 'none';
            let hiddenInput = row.querySelector('.color-hidden');
            if (!hiddenInput) {
                hiddenInput = document.createElement('input');
                hiddenInput.type = 'hidden';
                hiddenInput.className = 'color-hidden';
                hiddenInput.name = 'items[color][]';
                select.parentNode.appendChild(hiddenInput);
            }
            hiddenInput.value = select.value;
        }
    }
    
    // ========== UPDATE TOTALS ==========
    function updateTotals() {
        let totalMeters = 0;
        let totalItems = 0;
        
        document.querySelectorAll('.item-row').forEach(row => {
            const meters = parseFloat(row.querySelector('.meters').value) || 0;
            if (meters > 0) {
                totalMeters += meters;
                totalItems++;
            }
        });
        
        document.getElementById('totalItems').innerText = totalItems;
        document.getElementById('totalMeters').innerText = totalMeters.toFixed(2);
    }
    
    // ========== REMOVE ROW ==========
    function removeRow(btn) {
        const row = btn.closest('.item-row');
        if (document.querySelectorAll('.item-row').length > 1) {
            row.remove();
            updateTotals();
        } else {
            alert('At least one fabric item is required');
        }
    }
    
    // ========== ATTACH EVENTS TO ALL ROWS ==========
    function attachRowEvents() {
        document.querySelectorAll('.item-row').forEach(row => {
            // Fabric type change
            const fabricSelect = row.querySelector('.fabric-type');
            if (fabricSelect && !fabricSelect.hasAttribute('data-listener')) {
                fabricSelect.setAttribute('data-listener', 'true');
                fabricSelect.addEventListener('change', function() {
                    handleFabricTypeChange(this);
                });
                // Trigger initial setup
                handleFabricTypeChange(fabricSelect);
            }
            
            // Color change
            const colorSelect = row.querySelector('.color-select');
            if (colorSelect && !colorSelect.hasAttribute('data-listener')) {
                colorSelect.setAttribute('data-listener', 'true');
                colorSelect.addEventListener('change', function() {
                    handleColorChange(this);
                });
                handleColorChange(colorSelect);
            }
            
            // Copy button
            let copyBtn = row.querySelector('.copy-row');
            if (!copyBtn) {
                const actionCell = row.querySelector('td:last-child');
                const removeBtn = actionCell.querySelector('.remove-row');
                copyBtn = document.createElement('button');
                copyBtn.type = 'button';
                copyBtn.className = 'btn btn-sm btn-info copy-row ms-1';
                copyBtn.innerHTML = '<i class="fas fa-copy"></i>';
                copyBtn.title = 'Duplicate row';
                copyBtn.onclick = () => copyRow(copyBtn);
                actionCell.insertBefore(copyBtn, removeBtn);
            }
            
            // Remove button
            const removeBtn = row.querySelector('.remove-row');
            if (removeBtn && !removeBtn.hasAttribute('data-listener')) {
                removeBtn.setAttribute('data-listener', 'true');
                removeBtn.onclick = () => removeRow(removeBtn);
            }
            
            // Meters input
            const metersInput = row.querySelector('.meters');
            if (metersInput && !metersInput.hasAttribute('data-listener')) {
                metersInput.setAttribute('data-listener', 'true');
                metersInput.addEventListener('input', updateTotals);
            }
        });
    }
    
    // ========== INITIAL SETUP ==========
    attachRowEvents();
    updateTotals();
    
    // Listen for meter input changes (delegation)
    document.addEventListener('input', function(e) {
        if (e.target.classList && e.target.classList.contains('meters')) {
            updateTotals();
        }
    });
</script> -->







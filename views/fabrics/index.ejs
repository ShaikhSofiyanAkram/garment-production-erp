<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-layer-group"></i> Fabric Batches</h2>
    <a href="/fabrics/create" class="btn btn-primary">
        <i class="fas fa-plus"></i> New Batch Entry
    </a>
</div>

<!-- Monthly Summary Cards -->
<div class="row mb-4">
    <% for (const [month, summary] of Object.entries(monthlySummary)) { %>
    <div class="col-md-3 mb-2">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h6><%= month %></h6>
                <h4><%= summary.totalMeters %> m</h4>
                <small><%= summary.totalBatches %> batches | <%= summary.totalItems %> items</small>
            </div>
        </div>
    </div>
    <% } %>
</div>

<!-- Batches List -->
<div class="card">
    <div class="card-header">
        <h5>All Fabric Batches</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Batch Number</th>
                        <th>Date</th>
                        <th>Items</th>
                        <th>Total Meters</th>
                        <th>Supplier</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (batches && batches.length > 0) { %>
                        <% batches.forEach(batch => { %>
                        <tr>
                            <td>
                                <strong><%= batch.batchNumber %></strong>
                                <br>
                                <small class="text-muted"><%= new Date(batch.date).toLocaleDateString() %></small>
                            </td>
                            <td><%= new Date(batch.date).toLocaleDateString() %></td>
                            <td>
                                <span class="badge bg-secondary"><%= batch.totalItems %></span> items
                                <button class="btn btn-sm btn-link" onclick="viewItems('<%= batch._id %>')">
                                    <i class="fas fa-eye"></i> view
                                </button>
                            </td>
                            <td><strong><%= batch.totalMeters %></strong> m</td>
                            <td><%= batch.supplier || '-' %></td>
                            <td>
                                <a href="/fabrics/view/<%= batch._id %>" class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i> Details
                                </a>
                                <a href="/fabrics/print/<%= batch._id %>" class="btn btn-sm btn-secondary" target="_blank">
                                    <i class="fas fa-print"></i> Print
                                </a>
                                <form action="/fabrics/delete/<%= batch._id %>?_method=DELETE" 
                                    method="POST" style="display: inline;"
                                    onsubmit="return confirm('Delete this entire batch?')">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>   
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center">No fabric batches found</td>
                        </tr>
                    <% } %>
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <th colspan="3">Grand Total</th>
                        <th><%= batches ? batches.reduce((sum, b) => sum + b.totalMeters, 0) : 0 %> meters</th>
                        <th colspan="2"></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<!-- Items Modal -->
<div class="modal fade" id="itemsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Batch Items</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="itemsModalBody">
                Loading...
            </div>
        </div>
    </div>
</div>

<script>
async function viewItems(batchId) {
    const response = await fetch(`/fabrics/${batchId}`);
    const batch = await response.json();
    
    let html = `<table class="table table-sm">
        <thead><tr><th>Fabric Type</th><th>Meters</th><th>Remark</th></tr></thead>
        <tbody>`;
    
    batch.items.forEach(item => {
        html += `<tr>
            <td>${item.fabricType}</td>
            <td>${item.totalMeters} m</td>
            <td>${item.remark || '-'}</td>
        </tr>`;
    });
    
    html += `</tbody></table>
        <hr>
        <strong>Total Items:</strong> ${batch.totalItems}<br>
        <strong>Total Meters:</strong> ${batch.totalMeters} m<br>
        <strong>Supplier:</strong> ${batch.supplier || '-'}<br>
        <strong>Overall Remark:</strong> ${batch.overallRemark || '-'}`;
    
    document.getElementById('itemsModalBody').innerHTML = html;
    new bootstrap.Modal(document.getElementById('itemsModal')).show();
}
</script>
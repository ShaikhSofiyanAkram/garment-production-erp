<%
const currentPage = 'pressman';
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Garment ERP</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    
    <style>
        .product-card {
            background: white;
            border-radius: 16px;
            padding: 20px;
            border: 1px solid #e2e8f0;
            transition: all 0.3s;
            height: 100%;
        }
        .product-card:hover { 
            transform: translateY(-3px); 
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1); 
        }
        .product-rate { 
            font-size: 1.5rem; 
            font-weight: 700; 
            color: #22c55e; 
        }
        .badge-status { 
            padding: 6px 12px; 
            border-radius: 20px; 
            font-size: 0.7rem; 
        }
        .category-badge {
            background: #e2e8f0;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
        }
    </style>
</head>
<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand" href="/dashboard">
            <i class="fas fa-tshirt"></i> Garment ERP
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <span class="nav-link">
                        <i class="fas fa-user"></i> <%= user ? user.username : 'Admin' %>
                    </span>
                </li>
                <li class="nav-item">
                    <a href="/auth/logout" class="btn btn-sm btn-outline-light nav-link">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3><i class="fas fa-box"></i> Pressman Products & Rates</h3>
            <p class="text-muted">Manage products and rates for pressman (Independent from main products)</p>
        </div>
        <div>
            <a href="/pressman/products/new" class="btn btn-primary">
                <i class="fas fa-plus"></i> New Product
            </a>
            <a href="/pressman" class="btn btn-secondary ms-2">
                <i class="fas fa-arrow-left"></i> Back to Entries
            </a>
        </div>
    </div>

    <!-- Flash Messages -->
    <% if (success_msg && success_msg.length) { %>
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> <%= success_msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (error_msg && error_msg.length) { %>
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> <%= error_msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Product Grid -->
    <div class="row g-4">
        <% if (products && products.length > 0) { %>
            <% products.forEach(p => { %>
                <div class="col-md-4 col-lg-3">
                    
                    
                    
                    <!-- Product Card - Show rate correctly -->
                        <div class="product-card">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="mb-0 fw-bold"><%= p.name %></h6>
                                <span class="badge-status badge bg-<%= p.isActive ? 'success' : 'secondary' %>">
                                    <%= p.isActive ? 'Active' : 'Inactive' %>
                                </span>
                            </div>
                            <div class="mb-2">
                                <span class="category-badge"><%= p.category || 'Mens' %></span>
                            </div>
                            
                            <% if (p.hasSizeRates && p.sizeRates && p.sizeRates.length > 0) { %>
                                <div class="product-rate">
                                    <% p.sizeRates.forEach((sr, idx) => { %>
                                        <div><%= sr.size %>: ₹<%= sr.rate %>/piece</div>
                                    <% }) %>
                                </div>
                                <div class="text-muted small mt-1">Size-wise rates</div>
                            <% } else { %>
                                <div class="product-rate">₹<%= p.rate %>/piece</div>
                                <div class="text-muted small mt-1">Uniform rate</div>
                            <% } %>
                            
                            <div class="mt-3 d-flex gap-2">
                                <a href="/pressman/products/<%= p._id %>/edit" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <button onclick="deleteProduct('<%= p._id %>')" class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </div>
                        </div>




                </div>
            <% }) %>
        <% } else { %>
            <div class="col-12">
                <div class="text-center py-5">
                    <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                    <h5>No Products Found</h5>
                    <p class="text-muted">Start by creating your first pressman product</p>
                    <a href="/pressman/products/new" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Create Product
                    </a>
                </div>
            </div>
        <% } %>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
function deleteProduct(id) {
    if (!confirm('Are you sure you want to delete this product?')) return;
    
    fetch(`/pressman/products/${id}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' }
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            window.location.reload();
        } else {
            alert('Error deleting product: ' + (data.error || 'Unknown error'));
        }
    })
    .catch(err => alert('Error: ' + err.message));
}
</script>
</body>
</html>
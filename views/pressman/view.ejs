<%
const currentPage = 'pressman';
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Garment ERP</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    
    <style>
        .badge-status { padding: 4px 12px; border-radius: 20px; font-size: 0.7rem; }
        .detail-card { background: white; border-radius: 16px; padding: 20px; border: 1px solid #e2e8f0; }
    </style>
</head>
<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand" href="/dashboard">
            <i class="fas fa-tshirt"></i> Garment ERP
        </a>
        <div class="ms-auto">
            <span class="text-white me-3">
                <i class="fas fa-user"></i> <%= user ? user.username : 'Admin' %>
            </span>
            <a href="/auth/logout" class="btn btn-sm btn-outline-light">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </div>
</nav>

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3><i class="fas fa-file-invoice"></i> Entry <%= entry.entryNumber %></h3>
            <p class="text-muted">
                <span class="badge-status badge bg-<%= entry.status === 'paid' ? 'success' : entry.status === 'approved' ? 'info' : entry.status === 'pending' ? 'warning' : 'secondary' %>">
                    <%= entry.status || 'pending' %>
                </span>
            </p>
        </div>
        <div>
            <a href="/pressman" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- Entry Details -->
    <div class="row g-4">
        <div class="col-md-6">
            <div class="detail-card">
                <h6 class="fw-bold mb-3"><i class="fas fa-info-circle"></i> Entry Information</h6>
                <div class="row mb-2">
                    <div class="col-4 text-muted">Entry Number</div>
                    <div class="col-8 fw-bold"><%= entry.entryNumber %></div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 text-muted">Pressman</div>
                    <div class="col-8"><%= entry.pressman?.name || 'N/A' %></div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 text-muted">Date</div>
                    <div class="col-8"><%= entry.formattedDate || new Date(entry.date).toLocaleDateString('en-IN') %></div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 text-muted">Status</div>
                    <div class="col-8">
                        <span class="badge-status badge bg-<%= entry.status === 'paid' ? 'success' : entry.status === 'approved' ? 'info' : entry.status === 'pending' ? 'warning' : 'secondary' %>">
                            <%= entry.status || 'pending' %>
                        </span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 text-muted">Remark</div>
                    <div class="col-8"><%= entry.remark || '-' %></div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="detail-card">
                <h6 class="fw-bold mb-3"><i class="fas fa-calculator"></i> Summary</h6>
                <div class="row mb-2">
                    <div class="col-4 text-muted">Total Products</div>
                    <div class="col-8"><%= entry.entries?.length || 0 %></div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 text-muted">Total Quantity</div>
                    <div class="col-8 fw-bold text-primary"><%= entry.totalQuantity || 0 %></div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 text-muted">Total Amount</div>
                    <div class="col-8 fw-bold text-success">₹<%= entry.totalAmount || 0 %></div>
                </div>
                <% if (entry.status === 'paid') { %>
                <div class="row mb-2">
                    <div class="col-4 text-muted">Paid Amount</div>
                    <div class="col-8 fw-bold text-success">₹<%= entry.paidAmount || 0 %></div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 text-muted">Payment Date</div>
                    <div class="col-8"><%= new Date(entry.paymentDate).toLocaleDateString('en-IN') %></div>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Products -->
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0"><i class="fas fa-boxes"></i> Products</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Rate (₹)</th>
                            <th class="text-end">Amount (₹)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (entry.entries && entry.entries.length) { %>
                            <% entry.entries.forEach((item, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td><%= item.productName || 'Unknown' %></td>
                                    <td class="text-end"><%= item.quantity || 0 %></td>
                                    <td class="text-end">₹<%= item.rate || 0 %></td>
                                    <td class="text-end fw-bold">₹<%= item.amount || 0 %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5" class="text-center py-3 text-muted">No products</td></tr>
                        <% } %>
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="2" class="text-end">Total:</td>
                            <td class="text-end"><%= entry.totalQuantity || 0 %></td>
                            <td></td>
                            <td class="text-end text-success">₹<%= entry.totalAmount || 0 %></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="mt-4 d-flex gap-2">
        <% if (entry.status === 'pending') { %>
            <button onclick="updateStatus('<%= entry._id %>', 'approved')" class="btn btn-success">
                <i class="fas fa-check"></i> Approve
            </button>
            <button onclick="updateStatus('<%= entry._id %>', 'rejected')" class="btn btn-danger">
                <i class="fas fa-times"></i> Reject
            </button>
        <% } %>
        <% if (entry.status === 'approved') { %>
            <button onclick="updateStatus('<%= entry._id %>', 'paid')" class="btn btn-primary">
                <i class="fas fa-money-bill-wave"></i> Mark as Paid
            </button>
        <% } %>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
function updateStatus(id, status) {
    if (!confirm(`Are you sure you want to mark this entry as ${status}?`)) return;
    
    fetch(`/pressman/${id}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            window.location.reload();
        } else {
            alert('Error: ' + data.error);
        }
    })
    .catch(err => alert('Error: ' + err.message));
}
</script>
</body>
</html>
<%
const currentPage = 'pressman';
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Garment ERP</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    
    <style>
        .size-rate-row {
            background: #f8fafc;
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 8px;
            border: 1px solid #e2e8f0;
        }
        .remove-size { cursor: pointer; color: #ef4444; }
        .remove-size:hover { color: #dc2626; }
    </style>
</head>
<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand" href="/dashboard">
            <i class="fas fa-tshirt"></i> Garment ERP
        </a>
        <div class="ms-auto">
            <span class="text-white me-3">
                <i class="fas fa-user"></i> <%= user ? user.username : 'Admin' %>
            </span>
            <a href="/auth/logout" class="btn btn-sm btn-outline-light">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </div>
</nav>

<div class="container mt-4" style="max-width: 700px;">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3><i class="fas fa-box"></i> <%= title %></h3>
        <a href="/pressman/products" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back
        </a>
    </div>

    <!-- Flash Messages -->
    <% if (error_msg && error_msg.length) { %>
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> <%= error_msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Form -->
    <form action="<%= product ? `/pressman/products/${product._id}/update` : '/pressman/products/create' %>" method="POST" class="card shadow-sm">
        <div class="card-body">
            <!-- Product Name -->
            <div class="mb-3">
                <label class="form-label fw-bold">Product Name <span class="text-danger">*</span></label>
                <input type="text" name="name" class="form-control" 
                       value="<%= product?.name || '' %>" placeholder="e.g., pajama, kurta, jaket" required>
            </div>
            
            <!-- Category -->
            <div class="mb-3">
                <label class="form-label fw-bold">Category <span class="text-danger">*</span></label>
                <select name="category" class="form-control" required>
                    <option value="Mens" <%= product?.category === 'Mens' ? 'selected' : '' %>>Mens</option>
                    <option value="Kids" <%= product?.category === 'Kids' ? 'selected' : '' %>>Kids</option>
                    <option value="Both" <%= product?.category === 'Both' ? 'selected' : '' %>>Both</option>
                    <option value="Other" <%= product?.category === 'Other' ? 'selected' : '' %>>Other</option>
                </select>
            </div>

            <!-- ✅ Rate Type Selection -->
            <div class="mb-3">
                <label class="form-label fw-bold">Rate Type</label>
                <div class="d-flex gap-3">
                    <div class="form-check">
                        <input type="radio" name="rateType" id="uniformRate" value="uniform" 
                               class="form-check-input" 
                               <%= (!product || !product.hasSizeRates) ? 'checked' : '' %>
                               onchange="toggleRateType('uniform')">
                        <label class="form-check-label" for="uniformRate">Uniform Rate</label>
                    </div>
                    <div class="form-check">
                        <input type="radio" name="rateType" id="sizeRates" value="size" 
                               class="form-check-input" 
                               <%= (product && product.hasSizeRates) ? 'checked' : '' %>
                               onchange="toggleRateType('size')">
                        <label class="form-check-label" for="sizeRates">Size-wise Rates</label>
                    </div>
                </div>
            </div>

            <!-- ✅ Uniform Rate -->
            <div class="mb-3" id="uniformRateSection">
                <label class="form-label fw-bold">Rate (₹/piece) <span class="text-danger">*</span></label>
                <input type="number" name="rate" class="form-control" 
                       value="<%= product?.rate || '' %>" step="0.01" min="0" 
                       placeholder="e.g., 2">
                <small class="text-muted">Rate per piece for all sizes</small>
            </div>

            <!-- ✅ Size-wise Rates -->
            <div class="mb-3" id="sizeRatesSection" style="display: none;">
                <label class="form-label fw-bold">Size-wise Rates <span class="text-danger">*</span></label>
              
              
              
              
               <!-- In the form, ensure size[] and sizeRate[] are properly named -->

                    <div id="sizeRatesContainer">
                        <% if (product && product.sizeRates && product.sizeRates.length) { %>
                            <% product.sizeRates.forEach((sr, index) => { %>
                                <div class="size-rate-row row align-items-center" data-index="<%= index %>">
                                    <div class="col-md-5">
                                        <input type="text" name="size[]" class="form-control" 
                                            placeholder="Size (e.g., 1-12, S, M, L)" 
                                            value="<%= sr.size %>" required>
                                    </div>
                                    <div class="col-md-5">
                                        <input type="number" name="sizeRate[]" class="form-control" 
                                            placeholder="Rate (₹/piece)" step="0.01" min="0"
                                            value="<%= sr.rate %>" required>
                                    </div>
                                    <div class="col-md-2 text-end">
                                        <i class="fas fa-trash remove-size" onclick="removeSizeRow(this)"></i>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="size-rate-row row align-items-center" data-index="0">
                                <div class="col-md-5">
                                    <input type="text" name="size[]" class="form-control" 
                                        placeholder="Size (e.g., 1-12, S, M, L)" required>
                                </div>
                                <div class="col-md-5">
                                    <input type="number" name="sizeRate[]" class="form-control" 
                                        placeholder="Rate (₹/piece)" step="0.01" min="0" required>
                                </div>
                                <div class="col-md-2 text-end">
                                    <i class="fas fa-trash remove-size" onclick="removeSizeRow(this)"></i>
                                </div>
                            </div>
                        <% } %>
                    </div>






                <button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="addSizeRow()">
                    <i class="fas fa-plus"></i> Add Size
                </button>
                <div class="mt-2">
                    <small class="text-muted">Example: 1-12 → ₹2, 13-24 → ₹3, S → ₹5, M → ₹7</small>
                </div>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label class="form-label fw-bold">Description</label>
                <textarea name="description" class="form-control" rows="2" 
                          placeholder="Optional description..."><%= product?.description || '' %></textarea>
            </div>
            
            <!-- Status (Edit mode only) -->
            <% if (product) { %>
                <div class="mb-3">
                    <label class="form-label fw-bold">Status</label>
                    <select name="isActive" class="form-control">
                        <option value="true" <%= product.isActive ? 'selected' : '' %>>Active</option>
                        <option value="false" <%= !product.isActive ? 'selected' : '' %>>Inactive</option>
                    </select>
                </div>
            <% } %>
            
            <!-- Buttons -->
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> <%= product ? 'Update' : 'Create' %> Product
                </button>
                <a href="/pressman/products" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    </form>

    <!-- Quick Tips -->
    <div class="card mt-3 bg-light">
        <div class="card-body">
            <h6><i class="fas fa-lightbulb text-warning"></i> Quick Tips</h6>
            <ul class="small mb-0">
                <li>Products are independent from main products</li>
                <li><strong>Uniform Rate:</strong> Same rate for all sizes</li>
                <li><strong>Size-wise Rates:</strong> Different rates for different sizes</li>
                <li>Example: pajama 1-12 → ₹2/piece, pajama 13-24 → ₹3/piece</li>
                <li>Inactive products won't show in entry form</li>
            </ul>
        </div>
    </div>
</div>

<script>
// ==================== TOGGLE RATE TYPE ====================
function toggleRateType(type) {
    const uniformSection = document.getElementById('uniformRateSection');
    const sizeSection = document.getElementById('sizeRatesSection');
    
    if (type === 'uniform') {
        uniformSection.style.display = 'block';
        sizeSection.style.display = 'none';
        // Remove required from size fields
        document.querySelectorAll('#sizeRatesSection input').forEach(input => {
            input.removeAttribute('required');
        });
        // Add required to uniform rate
        document.querySelector('#uniformRateSection input').setAttribute('required', 'required');
    } else {
        uniformSection.style.display = 'none';
        sizeSection.style.display = 'block';
        // Add required to size fields
        document.querySelectorAll('#sizeRatesSection input').forEach(input => {
            input.setAttribute('required', 'required');
        });
        // Remove required from uniform rate
        document.querySelector('#uniformRateSection input').removeAttribute('required');
    }
}

// ==================== ADD SIZE ROW ====================
function addSizeRow() {
    const container = document.getElementById('sizeRatesContainer');
    const index = container.children.length;
    
    const row = document.createElement('div');
    row.className = 'size-rate-row row align-items-center';
    row.dataset.index = index;
    row.innerHTML = `
        <div class="col-md-5">
            <input type="text" name="size[]" class="form-control" 
                   placeholder="Size (e.g., 1-12, S, M, L)" required>
        </div>
        <div class="col-md-5">
            <input type="number" name="sizeRate[]" class="form-control" 
                   placeholder="Rate (₹/piece)" step="0.01" min="0" required>
        </div>
        <div class="col-md-2 text-end">
            <i class="fas fa-trash remove-size" onclick="removeSizeRow(this)"></i>
        </div>
    `;
    container.appendChild(row);
}

// ==================== REMOVE SIZE ROW ====================
function removeSizeRow(element) {
    const container = document.getElementById('sizeRatesContainer');
    if (container.children.length > 1) {
        element.closest('.size-rate-row').remove();
    } else {
        alert('⚠️ At least one size is required');
    }
}

// ==================== INITIALIZE ====================
document.addEventListener('DOMContentLoaded', function() {
    // Check which rate type is selected
    const uniformRadio = document.getElementById('uniformRate');
    const sizeRadio = document.getElementById('sizeRates');
    
    if (uniformRadio.checked) {
        toggleRateType('uniform');
    } else if (sizeRadio.checked) {
        toggleRateType('size');
    }
});
</script>
</body>
</html>
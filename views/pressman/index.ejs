<%
const currentPage = 'pressman';
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Garment ERP</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    
    <style>
        .stat-card { background: white; border-radius: 16px; padding: 20px; border: 1px solid #e2e8f0; }
        .stat-value { font-size: 1.75rem; font-weight: 700; }
        .stat-label { font-size: 0.75rem; color: #64748b; text-transform: uppercase; letter-spacing: 1px; }
        .badge-status { padding: 4px 12px; border-radius: 20px; font-size: 0.7rem; }
    </style>
</head>
<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand" href="/dashboard">
            <i class="fas fa-tshirt"></i> Garment ERP
        </a>
        <div class="ms-auto">
            <span class="text-white me-3">
                <i class="fas fa-user"></i> <%= user ? user.username : 'Admin' %>
            </span>
            <a href="/auth/logout" class="btn btn-sm btn-outline-light">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </div>
</nav>

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3><i class="fas fa-pressman"></i> Pressman Management</h3>
            <p class="text-muted">Manage pressman entries and payments</p>
        </div>
        <div>
            <a href="/pressman/new" class="btn btn-primary">
                <i class="fas fa-plus"></i> New Entry
            </a>
            <a href="/pressman/products" class="btn btn-outline-primary ms-2">
                <i class="fas fa-box"></i> Products
            </a>
        </div>
    </div>

    <!-- Flash Messages -->
    <% if (success_msg && success_msg.length) { %>
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> <%= success_msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (error_msg && error_msg.length) { %>
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> <%= error_msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Stats -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Total Entries</div>
                <div class="stat-value text-primary"><%= stats?.totalEntries || 0 %></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Total Products</div>
                <div class="stat-value text-success"><%= stats?.totalProducts || 0 %></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Pending Entries</div>
                <div class="stat-value text-warning"><%= stats?.pendingEntries || 0 %></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Total Amount</div>
                <div class="stat-value text-danger">₹<%= stats?.totalAmount?.[0]?.total || 0 %></div>
            </div>
        </div>
    </div>

    <!-- Entries Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0"><i class="fas fa-list"></i> Pressman Entries</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Entry #</th>
                            <th>Pressman</th>
                            <th>Date</th>
                            <th>Products</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Amount</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (entries && entries.length) { %>
                            <% entries.forEach(entry => { %>
                                <tr>
                                    <td><strong><%= entry.entryNumber %></strong></td>
                                    <td><%= entry.pressman?.name || 'N/A' %></td>
                                    <td><%= entry.formattedDate || new Date(entry.date).toLocaleDateString('en-IN') %></td>
                                    <td><%= entry.entries?.length || 0 %> items</td>
                                    <td class="text-end"><%= entry.totalQuantity || 0 %></td>
                                    <td class="text-end fw-bold">₹<%= entry.totalAmount || 0 %></td>
                                    <td>
                                        <span class="badge-status badge bg-<%= entry.status === 'paid' ? 'success' : entry.status === 'approved' ? 'info' : entry.status === 'pending' ? 'warning' : 'secondary' %>">
                                            <%= entry.status || 'pending' %>
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <a href="/pressman/<%= entry._id %>" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <button onclick="deleteEntry('<%= entry._id %>')" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">No entries found</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
function deleteEntry(id) {
    if (!confirm('Are you sure you want to delete this entry?')) return;
    
    fetch(`/pressman/${id}`, {
        method: 'DELETE'
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            window.location.reload();
        } else {
            alert('Error: ' + data.error);
        }
    })
    .catch(err => alert('Error: ' + err.message));
}
</script>
</body>
</html>